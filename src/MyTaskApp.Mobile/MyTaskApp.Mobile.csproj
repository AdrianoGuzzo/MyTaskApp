<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A casca MAUI do celular (ADR-067): telas, portas da plataforma e os
    arquivos de Android e iOS. Toda a lógica está em MyTaskApp.Mobile.Core.

    Fica fora do MyTaskApp.slnx (que o CI do desktop compila sem workload);
    a solução dela é MyTaskApp.Mobile.slnx. O iOS só entra no macOS, ou com
    -p:IncludeIos=true para conferir a configuração em outro sistema.

    -p:IncludeAndroid=false tira o Android: o restore avalia todos os alvos,
    mesmo com -f, e pediria o workload do Android num Mac que só compila o
    iOS (mobile-ios.yml).
  -->

  <PropertyGroup>
    <!-- O Directory.Build.props fixa net10.0 para todos; aqui são vários alvos. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks Condition="'$(IncludeAndroid)' != 'false'">net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx')) or '$(IncludeIos)' == 'true'">$(TargetFrameworks);net10.0-ios</TargetFrameworks>
    <TargetFrameworks>$(TargetFrameworks.Trim(';'))</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>MyTaskApp.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>

    <ApplicationTitle>MyTaskApp</ApplicationTitle>
    <!-- O mesmo domínio reverso do esquema de volta do login (SyncSchema.MobileRedirectScheme). -->
    <ApplicationId>io.github.adrianoguzzo.mytaskapp</ApplicationId>

    <!-- A versão é a do produto (Release Please); o código de versão sobe junto: 1.15.0 → 11500. -->
    <ApplicationDisplayVersion>$(VersionPrefix)</ApplicationDisplayVersion>
    <ApplicationVersion>$([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($([System.Version]::Parse($(VersionPrefix)).Major), 10000)), $([MSBuild]::Multiply($([System.Version]::Parse($(VersionPrefix)).Minor), 100)))), $([System.Version]::Parse($(VersionPrefix)).Build)))</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>

    <!-- Bindings compilados também com Source: um binding errado é erro de build, não tela vazia. -->
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

    <!--
      O identificador do dispositivo, a captura da sincronização e a hidratação
      dos lugares usam System.Text.Json por reflexão; com o trimming do MAUI,
      isso vem desligado por padrão.
    -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>

    <!-- O EF Core e a reflexão do JSON avisam no trimming, como esperado; o trimming é parcial (abaixo). -->
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
    <TrimMode>partial</TrimMode>

    <!--
      Nenhum servidor vem da build (ADR-078): o usuário configura na tela. No
      Debug, o campo só vem preenchido com o servidor local (adb reverse), e
      nada é usado antes de o desenvolvedor salvar.
    -->
    <SyncServerSuggestion Condition="'$(SyncServerSuggestion)' == '' and '$(Configuration)' == 'Debug'">http://localhost:5280/</SyncServerSuggestion>
  </PropertyGroup>

  <!-- iOS: o EF Core compila expressões em tempo de execução; sem JIT, o interpretador faz isso. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <UseInterpreter>true</UseInterpreter>
    <CodesignEntitlements>Platforms\iOS\Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>

  <ItemGroup Condition="'$(SyncServerSuggestion)' != ''">
    <AssemblyMetadata Include="SyncServerSuggestion" Value="$(SyncServerSuggestion)" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="MyTaskApp.Domain" />
    <TrimmerRootAssembly Include="MyTaskApp.Application" />
    <TrimmerRootAssembly Include="MyTaskApp.Infrastructure" />
    <TrimmerRootAssembly Include="MyTaskApp.Sync.Contracts" />
    <TrimmerRootAssembly Include="MyTaskApp.Mobile.Core" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#17181C" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#17181C" BaseSize="128,128" />
    <!-- Os ícones das abas: traço preto, que a barra pinta na cor do tema. -->
    <MauiImage Include="Resources\Images\*.svg" BaseSize="24,24" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyTaskApp.Mobile.Core\MyTaskApp.Mobile.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

</Project>
