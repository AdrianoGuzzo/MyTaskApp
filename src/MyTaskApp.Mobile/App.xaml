<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:adapters="clr-namespace:MyTaskApp.Mobile.Adapters"
             x:Class="MyTaskApp.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- As cores não estão aqui: vêm do tema escolhido (MauiThemeService). -->
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <adapters:HexColorConverter x:Key="HexColor" />
            <adapters:SoftHexColorConverter x:Key="SoftHexColor" />
            <adapters:PriorityColorConverter x:Key="PriorityColor" />
            <adapters:DeadlineColorConverter x:Key="DeadlineColor" />
            <adapters:SyncDotFillConverter x:Key="SyncDotFill" />
            <adapters:SyncDotRingConverter x:Key="SyncDotRing" />
            <adapters:StrikeConverter x:Key="Strike" />
            <adapters:InvertedBoolConverter x:Key="Not" />
            <adapters:HasValueConverter x:Key="HasValue" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
