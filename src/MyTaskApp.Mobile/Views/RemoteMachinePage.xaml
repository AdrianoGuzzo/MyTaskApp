<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyTaskApp.Mobile.Core.ViewModels;assembly=MyTaskApp.Mobile.Core"
             x:Class="MyTaskApp.Mobile.Views.RemoteMachinePage"
             x:DataType="vm:RemoteMachineViewModel"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Ver o ambiente" Command="{Binding InspectCommand}" />
    </ContentPage.ToolbarItems>

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="8">

                <Label Text="{Binding LoadError}" Style="{StaticResource Error}" IsVisible="{Binding LoadError, Converter={StaticResource HasValue}}" />

                <!-- O Claude no terminal do agente desta máquina (ADR-101). -->
                <Label Text="Terminais do Claude" Style="{StaticResource Section}" IsVisible="{Binding HasTerminals}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Terminals}" Spacing="4">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:TerminalLine">
                            <Grid ColumnDefinitions="*,Auto" Padding="0,6">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RemoteMachineViewModel}}, x:DataType=vm:RemoteMachineViewModel, Path=OpenTerminalCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout>
                                    <Label Text="{Binding Title}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding NeedsAttention}" Value="True">
                                                <Setter Property="FontAttributes" Value="Bold" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding Detail}" Style="{StaticResource Muted}" />
                                    <Label Text="{Binding BypassWarning}" Style="{StaticResource Error}" IsVisible="{Binding HasBypassWarning}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="›" Style="{StaticResource Muted}" VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="Worktrees prontos" Style="{StaticResource Section}" />
                <Label Text="Nenhum por enquanto. Para criar um, abra a tarefa e toque em &quot;Preparar em…&quot;."
                       Style="{StaticResource Muted}"
                       IsVisible="{Binding HasEnvironments, Converter={StaticResource Not}}" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Environments}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:EnvironmentLine">
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" />
                                    <Label Text="{Binding Detail}" Style="{StaticResource Muted}" />
                                    <FlexLayout Wrap="Wrap" JustifyContent="Start" Margin="0,4,0,0">
                                        <Button Text="Rodar comando"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RemoteMachineViewModel}}, x:DataType=vm:RemoteMachineViewModel, Path=RunCommandCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding HasCommands}"
                                                Margin="0,0,8,8" />
                                        <Button Text="Claude"
                                                Style="{StaticResource Secondary}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RemoteMachineViewModel}}, x:DataType=vm:RemoteMachineViewModel, Path=StartAgentCommand}"
                                                CommandParameter="{Binding .}"
                                                Margin="0,0,8,8" />
                                        <Button Text="No terminal de lá"
                                                Style="{StaticResource Secondary}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RemoteMachineViewModel}}, x:DataType=vm:RemoteMachineViewModel, Path=StartTerminalCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:RemoteMachineViewModel}}, x:DataType=vm:RemoteMachineViewModel, Path=OffersTerminal}"
                                                Margin="0,0,8,8" />
                                        <Button Text="Apagar"
                                                Style="{StaticResource Destructive}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RemoteMachineViewModel}}, x:DataType=vm:RemoteMachineViewModel, Path=RemoveCommand}"
                                                CommandParameter="{Binding .}"
                                                Margin="0,0,8,8" />
                                    </FlexLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
