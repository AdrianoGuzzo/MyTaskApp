<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyTaskApp.Mobile.Core.ViewModels;assembly=MyTaskApp.Mobile.Core"
             xmlns:remote="clr-namespace:MyTaskApp.Mobile.Core.Remote;assembly=MyTaskApp.Mobile.Core"
             x:Class="MyTaskApp.Mobile.Views.RemoteOperationPage"
             x:DataType="vm:RemoteOperationViewModel"
             Title="Operação">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">

            <Label Text="{Binding Status}" Style="{StaticResource Title}" />
            <Label Text="{Binding Summary}" LineBreakMode="WordWrap" IsVisible="{Binding Summary, Converter={StaticResource HasValue}}" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Approvals}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="remote:ApprovalLine">
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Title}" FontAttributes="Bold" />
                                <Label Text="{Binding Summary}" LineBreakMode="WordWrap" />
                                <Label Text="{Binding Detail}" Style="{StaticResource Muted}" />
                                <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                                    <Button Text="Permitir"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RemoteOperationViewModel}}, x:DataType=vm:RemoteOperationViewModel, Path=AllowCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Negar"
                                            Style="{StaticResource Destructive}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RemoteOperationViewModel}}, x:DataType=vm:RemoteOperationViewModel, Path=DenyCommand}"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding RememberLabel}" Style="{StaticResource Muted}" LineBreakMode="WordWrap" IsVisible="{Binding CanRemember}" />
                                <Button Text="Permitir nesta conversa" HorizontalOptions="Start" IsVisible="{Binding CanRemember}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RemoteOperationViewModel}}, x:DataType=vm:RemoteOperationViewModel, Path=AllowForConversationCommand}"
                                        CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <FlexLayout Wrap="Wrap" JustifyContent="Start">
                <Button Text="Cancelar" Style="{StaticResource Destructive}" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" Margin="0,0,8,8" />
                <Button Text="Mais um prompt" Command="{Binding ContinueCommand}" IsVisible="{Binding HasConversation}" Margin="0,0,8,8" />
                <Button Text="Parar o Claude" Style="{StaticResource Secondary}" Command="{Binding StopAgentCommand}" IsVisible="{Binding HasConversation}" Margin="0,0,8,8" />
            </FlexLayout>

            <Label Text="Saída" Style="{StaticResource Section}" IsVisible="{Binding Output, Converter={StaticResource HasValue}}" />
            <Border Style="{StaticResource Card}" IsVisible="{Binding Output, Converter={StaticResource HasValue}}">
                <Label Text="{Binding Output}" FontFamily="monospace" FontSize="12" LineBreakMode="CharacterWrap" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
