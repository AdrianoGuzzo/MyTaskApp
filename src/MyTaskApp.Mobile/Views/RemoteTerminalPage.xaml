<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyTaskApp.Mobile.Core.ViewModels;assembly=MyTaskApp.Mobile.Core"
             x:Class="MyTaskApp.Mobile.Views.RemoteTerminalPage"
             x:DataType="vm:RemoteTerminalViewModel"
             Title="Terminal do Claude">

    <!--
      O terminal do Claude de outra máquina (ADR-101): a mesma tela de lá, ao
      vivo. De longe, a vez de digitar é pedida por botão; o prompt vai por um
      campo normal, e a barra traz as teclas que o teclado do celular não tem.
    -->
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" Padding="8,8,8,4" RowSpacing="6">

        <!-- O estado, a máquina, a vez de digitar e o que mais dá para fazer. -->
        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Text="{Binding Title}" Style="{StaticResource Section}" LineBreakMode="TailTruncation" />
            <Label Style="{StaticResource Muted}" LineBreakMode="TailTruncation">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding Machine}" />
                        <Span Text=" · " />
                        <Span Text="{Binding StatusText}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Label Text="{Binding LeaseText}" Style="{StaticResource Muted}" LineBreakMode="WordWrap" IsVisible="{Binding HasLeaseText}" />
            <Label Text="{Binding BypassWarning}" Style="{StaticResource Error}" LineBreakMode="WordWrap" IsVisible="{Binding HasBypassWarning}" />
            <Label Text="{Binding MonitoringWarning}" Style="{StaticResource Muted}" LineBreakMode="WordWrap" IsVisible="{Binding HasMonitoringWarning}" />
            <Label Text="{Binding Message}" Style="{StaticResource Muted}" LineBreakMode="WordWrap" IsVisible="{Binding HasMessage}" />
            <Label Text="{Binding LoadError}" Style="{StaticResource Error}" LineBreakMode="WordWrap" IsVisible="{Binding HasLoadError}" />
            <FlexLayout Wrap="Wrap" JustifyContent="Start" Margin="0,4,0,0">
                <Button x:Name="TakeControlButton" Text="Assumir o controle" Command="{Binding TakeControlCommand}" IsVisible="{Binding CanTakeControl}" Margin="0,0,8,6" />
                <Button Text="Soltar o controle" Style="{StaticResource Secondary}" Command="{Binding ReleaseControlCommand}" IsVisible="{Binding CanReleaseControl}" Margin="0,0,8,6" />
                <Button Text="Interromper (Esc)" Style="{StaticResource Secondary}" Command="{Binding InterruptCommand}" IsVisible="{Binding CanInterrupt}" Margin="0,0,8,6" />
                <Button Text="Reconectar" Command="{Binding ReconnectCommand}" IsVisible="{Binding IsDisconnected}" Margin="0,0,8,6" />
                <Button x:Name="MoreButton" Text="⋯" Style="{StaticResource Secondary}" Command="{Binding MoreCommand}" IsVisible="{Binding CanStop}" Margin="0,0,8,6" />
            </FlexLayout>
        </VerticalStackLayout>

        <!-- O pedido de permissão do Claude, respondido daqui. -->
        <Border Grid.Row="1" Style="{StaticResource Card}" IsVisible="{Binding HasDialog}">
            <VerticalStackLayout Spacing="4">
                <Label Text="O Claude pede permissão" FontAttributes="Bold" />
                <Label Text="{Binding DialogText}" LineBreakMode="WordWrap" />
                <HorizontalStackLayout Spacing="8" IsVisible="{Binding CanAnswer}">
                    <Button Text="Permitir" Command="{Binding AllowCommand}" />
                    <Button Text="Negar" Style="{StaticResource Destructive}" Command="{Binding DenyCommand}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- A tela de lá. Pinça muda a letra; arrastar na vertical rola o histórico; tocar abre o teclado. -->
        <Border Grid.Row="2" StrokeThickness="0" BackgroundColor="#1E1E1E" Padding="2">
            <GraphicsView x:Name="TerminalView" />
        </Border>

        <!-- O prompt pronto: vai colado, com Enter, quando o Claude espera. -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding CanPrompt}">
            <Entry x:Name="PromptEntry"
                   Placeholder="Prompt para o Claude"
                   Text="{Binding Prompt}"
                   ReturnType="Send"
                   ReturnCommand="{Binding SendPromptCommand}" />
            <Button Grid.Column="1" Text="Mandar" Command="{Binding SendPromptCommand}" />
        </Grid>

        <!-- As teclas que o teclado do celular não tem. -->
        <ScrollView Grid.Row="4" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" IsVisible="{Binding CanType}">
            <HorizontalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Keys}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:TerminalKeyButton">
                        <Button Text="{Binding Label}"
                                Style="{StaticResource Chip}"
                                FontFamily="monospace"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RemoteTerminalViewModel}}, x:DataType=vm:RemoteTerminalViewModel, Path=PressCommand}"
                                CommandParameter="{Binding Key}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- O teclado do sistema digita direto no terminal, tecla por tecla. -->
        <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" IsVisible="{Binding CanType}">
            <Entry x:Name="KeyboardEntry"
                   Placeholder="Toque para digitar no terminal"
                   Keyboard="Plain"
                   IsSpellCheckEnabled="False"
                   IsTextPredictionEnabled="False"
                   TextChanged="OnKeyboardTextChanged"
                   Completed="OnKeyboardCompleted" />
            <Button Grid.Column="1" Text="A−" Style="{StaticResource Chip}" Command="{Binding ZoomOutCommand}" />
            <Button Grid.Column="2" Text="A+" Style="{StaticResource Chip}" Command="{Binding ZoomInCommand}" />
        </Grid>
    </Grid>
</ContentPage>
