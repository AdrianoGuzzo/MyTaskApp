<?xml version="1.0" encoding="utf-8" ?>
<!--
    A lista das abas Tarefas e Histórico (ADR-076): o ViewModel de cada aba
    muda só os atalhos de status e as frases. Os comandos das linhas sobem
    até o ViewModel pela base comum.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyTaskApp.Mobile.Core.ViewModels;assembly=MyTaskApp.Mobile.Core"
             xmlns:pres="clr-namespace:MyTaskApp.Mobile.Core.Presentation;assembly=MyTaskApp.Mobile.Core"
             x:Class="MyTaskApp.Mobile.Views.TaskListView"
             x:DataType="vm:TaskListViewModelBase">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <!--
            O topo da lista (ADR-079): o dispositivo em foco é o título, e um
            toque nele abre a folha para trocar. Busca e filtros ficam em ícones,
            desenhados em vetor na cor do tema (sem gatilho de cor).
        -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Padding="16,8,8,0">
            <VerticalStackLayout VerticalOptions="Center"
                                 MinimumHeightRequest="44"
                                 SemanticProperties.Description="{Binding DeviceTitle, StringFormat='Mostrando as tarefas de {0}. Toque para trocar o dispositivo.'}">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ChooseDeviceCommand}" />
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="{Binding HeaderCaption}"
                       Style="{StaticResource Section}"
                       Margin="0"
                       TextTransform="Uppercase"
                       IsVisible="{Binding ShowsDevices}" />
                <!-- Grid, e não pilha horizontal: um nome comprido corta com "…" e o "⌄" fica junto, sem empurrar os ícones. -->
                <Grid ColumnDefinitions="Auto,28" ColumnSpacing="4" HorizontalOptions="Start">
                    <Label Text="{Binding DeviceTitle}"
                           Style="{StaticResource Title}"
                           FontSize="26"
                           MaxLines="1"
                           LineBreakMode="TailTruncation"
                           VerticalOptions="Center" />
                    <Path Grid.Column="1"
                          Data="M 6,9 L 12,15 L 18,9"
                          WidthRequest="24"
                          HeightRequest="24"
                          VerticalOptions="Center"
                          Stroke="{DynamicResource AccentText}"
                          StrokeThickness="2.5"
                          StrokeLineCap="Round"
                          StrokeLineJoin="Round"
                          IsVisible="{Binding ShowsDevices}" />
                </Grid>
            </VerticalStackLayout>

            <Grid Grid.Column="1"
                  WidthRequest="44"
                  HeightRequest="44"
                  VerticalOptions="End"
                  SemanticProperties.Description="Buscar tarefas">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleSearchCommand}" />
                </Grid.GestureRecognizers>
                <Path Data="M 4,11 A 7,7 0 1 0 18,11 A 7,7 0 1 0 4,11 M 16,16 L 21,21"
                      WidthRequest="24"
                      HeightRequest="24"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      Stroke="{DynamicResource TextMid}"
                      StrokeThickness="2"
                      StrokeLineCap="Round" />
            </Grid>

            <!-- O ponto no funil diz que a folha tem algo ligado; o leitor de tela ouve "Filtros (2)". -->
            <Grid Grid.Column="2"
                  WidthRequest="44"
                  HeightRequest="44"
                  VerticalOptions="End"
                  SemanticProperties.Description="{Binding FiltersLabel}">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenFiltersCommand}" />
                </Grid.GestureRecognizers>
                <Path Data="M 3,5 L 21,5 L 14,13 L 14,19 L 10,21 L 10,13 Z"
                      WidthRequest="24"
                      HeightRequest="24"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      Stroke="{DynamicResource TextMid}"
                      StrokeThickness="2"
                      StrokeLineJoin="Round" />
                <Ellipse WidthRequest="9"
                         HeightRequest="9"
                         HorizontalOptions="End"
                         VerticalOptions="Start"
                         Margin="0,8,8,0"
                         Fill="{DynamicResource Accent}"
                         IsVisible="{Binding HasSheetFilters}" />
            </Grid>
        </Grid>

        <!--
            O estado da sincronização, sempre à vista: a bolinha com as cores do
            desktop (ADR-063) e a frase curta. Tocar leva à aba Conta, com o detalhe.
        -->
        <Border Grid.Row="1"
                Style="{StaticResource Pill}"
                HorizontalOptions="Start"
                Margin="16,4,16,0"
                IsVisible="{Binding Sync.IsVisible, FallbackValue=False}"
                SemanticProperties.Description="{Binding Sync.Detail, StringFormat='Sincronização: {0} Toque para ver a conta.', FallbackValue=''}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenAccountCommand}" />
            </Border.GestureRecognizers>
            <HorizontalStackLayout Spacing="8">
                <!-- Miolo e anel por conversor, que lê a cor do tema: sem gatilho de cor (veja Converters.cs). -->
                <Ellipse x:Name="SyncDot"
                         WidthRequest="10"
                         HeightRequest="10"
                         VerticalOptions="Center"
                         StrokeThickness="2"
                         Fill="{Binding Sync.Kind, Converter={StaticResource SyncDotFill}, FallbackValue={x:Null}}"
                         Stroke="{Binding Sync.Kind, Converter={StaticResource SyncDotRing}, FallbackValue={x:Null}}" />
                <Label Text="{Binding SyncLine}"
                       FontSize="13"
                       TextColor="{DynamicResource TextMid}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- A busca fica atrás da lupa; com texto digitado, continua aberta. -->
        <SearchBar x:Name="Search"
                   Grid.Row="2"
                   Margin="8,4,8,0"
                   Placeholder="Buscar tarefas"
                   Text="{Binding SearchText}"
                   IsVisible="{Binding ShowsSearch}"
                   SearchButtonPressed="OnSearchPressed"
                   SemanticProperties.Description="Buscar no título e na descrição das tarefas" />

        <!-- Os atalhos de status só quando há escolha: no Histórico. A aba Tarefas é só de pendentes. -->
        <ScrollView Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    IsVisible="{Binding ShowsPresets}">
            <HorizontalStackLayout Spacing="8" Padding="16,8" BindableLayout.ItemsSource="{Binding Presets}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:PresetChip">
                        <!--
                            Dois botões, e não um com gatilho: no Button, o gatilho que sai
                            devolvia a cor do tema de antes de uma troca de tema.
                        -->
                        <Grid>
                            <Button Style="{StaticResource Chip}"
                                    Text="{Binding Label}"
                                    IsVisible="{Binding IsSelected, Converter={StaticResource Not}}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TaskListViewModelBase}}, x:DataType=vm:TaskListViewModelBase, Path=SelectPresetCommand}"
                                    CommandParameter="{Binding Value}" />
                            <Button Style="{StaticResource SelectedChip}"
                                    Text="{Binding Label}"
                                    IsVisible="{Binding IsSelected}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TaskListViewModelBase}}, x:DataType=vm:TaskListViewModelBase, Path=SelectPresetCommand}"
                                    CommandParameter="{Binding Value}" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <RefreshView Grid.Row="4"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Tasks}"
                            SelectionMode="None"
                            RemainingItemsThreshold="10"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                            Margin="0,0,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="pres:TaskRow">
                        <!--
                            Arrastar só revela o botão: concluir é tocar nele. Arrastar
                            sem querer não muda nada, e o que muda tem "Desfazer".
                        -->
                        <SwipeView Margin="12,4">
                            <SwipeView.LeftItems>
                                <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">
                                    <SwipeItem Text="{Binding ToggleLabel}"
                                               IsVisible="{Binding CanToggle}"
                                               BackgroundColor="{DynamicResource Success}"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TaskListViewModelBase}}, x:DataType=vm:TaskListViewModelBase, Path=ToggleCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.LeftItems>

                            <Border Style="{StaticResource Card}"
                                    Padding="0"
                                    SemanticProperties.Description="{Binding AccessibleDescription}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TaskListViewModelBase}}, x:DataType=vm:TaskListViewModelBase, Path=OpenCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="4,Auto,*" ColumnSpacing="0">
                                    <!--
                                        A faixa da prioridade. Nas linhas, nenhuma cor do tema passa por
                                        gatilho: no Android, o gatilho que sai numa linha reciclada
                                        devolvia a cor do tema de antes de uma troca (Converters.cs).
                                    -->
                                    <BoxView Grid.Column="0" Color="{Binding Priority, Converter={StaticResource PriorityColor}}" />

                                    <!--
                                        O círculo de concluir, como nos Lembretes do iOS: 24 pontos de
                                        desenho, 44 de toque. Concluída fica cheia, com o visto.
                                    -->
                                    <Grid Grid.Column="1"
                                          WidthRequest="48"
                                          HeightRequest="48"
                                          Margin="2,0,0,0"
                                          VerticalOptions="Start"
                                          IsVisible="{Binding CanToggle}"
                                          SemanticProperties.Description="{Binding ToggleLabel}">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TaskListViewModelBase}}, x:DataType=vm:TaskListViewModelBase, Path=ToggleCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <!-- Vazio e cheio são duas formas, alternadas: cor sem gatilho. -->
                                        <Border WidthRequest="24"
                                                HeightRequest="24"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                StrokeShape="RoundRectangle 12"
                                                StrokeThickness="2"
                                                Stroke="{DynamicResource TextLow}"
                                                BackgroundColor="Transparent"
                                                IsVisible="{Binding IsCompleted, Converter={StaticResource Not}}" />
                                        <Border WidthRequest="24"
                                                HeightRequest="24"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                StrokeShape="RoundRectangle 12"
                                                StrokeThickness="2"
                                                Stroke="{DynamicResource Success}"
                                                BackgroundColor="{DynamicResource Success}"
                                                IsVisible="{Binding IsCompleted}">
                                            <Label Text="✓"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   TextColor="{DynamicResource Canvas}" />
                                        </Border>
                                    </Grid>

                                    <VerticalStackLayout Grid.Column="2" Padding="4,12,14,12" Spacing="4">
                                        <!-- Concluída fica riscada e esmaecida: opacidade, que não é cor do tema. -->
                                        <Label Text="{Binding Title}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2"
                                               TextDecorations="{Binding IsCompleted, Converter={StaticResource Strike}}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                                    <Setter Property="Opacity" Value="0.6" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <Label Text="{Binding Summary}"
                                               Style="{StaticResource Muted}"
                                               MaxLines="1"
                                               LineBreakMode="TailTruncation"
                                               IsVisible="{Binding Summary, Converter={StaticResource HasValue}}" />

                                        <!-- "Pendente" em toda linha da aba Tarefas não diz nada: o status só aparece quando foge disso. -->
                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="{Binding StatusLabel}" Style="{StaticResource Muted}" IsVisible="{Binding ShowsStatus}" />
                                            <Label Text="{Binding PriorityLabel}" Style="{StaticResource Muted}" />
                                            <Label Text="{Binding Origin}" Style="{StaticResource Muted}" />
                                        </HorizontalStackLayout>

                                        <Label Text="{Binding DeadlineLabel}"
                                               Style="{StaticResource Muted}"
                                               TextColor="{Binding DeadlineSeverity, Converter={StaticResource DeadlineColor}}"
                                               IsVisible="{Binding DeadlineLabel, Converter={StaticResource HasValue}}" />

                                        <FlexLayout Wrap="Wrap"
                                                    BindableLayout.ItemsSource="{Binding Tags}"
                                                    IsVisible="{Binding Tags, Converter={StaticResource HasValue}}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="pres:TagChip">
                                                    <Border Margin="0,2,6,0"
                                                            Padding="8,2"
                                                            StrokeThickness="1"
                                                            BackgroundColor="{Binding ColorHex, Converter={StaticResource SoftHexColor}}"
                                                            Stroke="{Binding ColorHex, Converter={StaticResource HexColor}}"
                                                            StrokeShape="RoundRectangle 9">
                                                        <Label Text="{Binding Name}"
                                                               FontSize="12"
                                                               TextColor="{Binding ColorHex, Converter={StaticResource HexColor}}" />
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </FlexLayout>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <!-- Espaço para a barra Desfazer não cobrir a última tarefa. -->
                    <VerticalStackLayout Padding="16,8,16,72">
                        <ActivityIndicator IsRunning="{Binding IsLoadingMore}" IsVisible="{Binding IsLoadingMore}" HeightRequest="24" />
                        <Label Text="Há muitas tarefas com estes filtros. Refine a busca para ver as mais antigas."
                               Style="{StaticResource Muted}"
                               HorizontalTextAlignment="Center"
                               IsVisible="{Binding IsTruncated}" />
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <!-- Os estados da lista: cada um com a sua frase e o que fazer. -->
        <ActivityIndicator Grid.Row="4" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" VerticalOptions="Center" />

        <VerticalStackLayout Grid.Row="4" IsVisible="{Binding IsEmpty}" VerticalOptions="Center" Padding="32" Spacing="12">
            <Label Text="{Binding EmptyTitle}" Style="{StaticResource Title}" HorizontalTextAlignment="Center" />
            <Label Text="{Binding EmptyMessage}"
                   Style="{StaticResource Muted}"
                   HorizontalTextAlignment="Center" />
            <Button Text="Entrar com sua conta"
                    Style="{StaticResource Secondary}"
                    Command="{Binding OpenAccountCommand}"
                    IsVisible="{Binding OffersSignInWhenEmpty}"
                    HorizontalOptions="Center" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="4" IsVisible="{Binding IsNoResults}" VerticalOptions="Center" Padding="32" Spacing="12">
            <Label Text="Nada com estes filtros" Style="{StaticResource Title}" HorizontalTextAlignment="Center" />
            <Label Text="Nenhuma tarefa combina com a busca, o dispositivo e os filtros escolhidos." Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
            <Button Text="Limpar filtros" Command="{Binding ClearFiltersCommand}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="4" IsVisible="{Binding IsError}" VerticalOptions="Center" Padding="32" Spacing="12">
            <Label Text="Não deu para mostrar as tarefas" Style="{StaticResource Title}" HorizontalTextAlignment="Center" />
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource Error}" HorizontalTextAlignment="Center" />
            <Button Text="Tentar de novo" Command="{Binding LoadCommand}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- "Tarefa concluída · Desfazer": igual no iOS e no Android, some sozinha. -->
        <Border x:Name="UndoBar"
                Grid.Row="4"
                Style="{StaticResource Snackbar}"
                VerticalOptions="End"
                Margin="16,0,16,12"
                IsVisible="False"
                Opacity="0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Text="{Binding UndoMessage}"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation" />
                <Button Grid.Column="1"
                        Text="Desfazer"
                        Style="{StaticResource TextAction}"
                        Command="{Binding UndoCommand}"
                        SemanticProperties.Description="Desfazer a última conclusão" />
            </Grid>
        </Border>

        <!--
            "Nova tarefa" discreta, como nos Lembretes do iOS (ADR-079): só texto
            no destaque, numa faixa própria que não cobre a lista. O Histórico
            não cria tarefa: o que nasce é pendente, e mora na aba Tarefas.
        -->
        <Button Grid.Row="5"
                Style="{StaticResource TextAction}"
                Text="＋  Nova tarefa"
                HorizontalOptions="Start"
                Margin="8,0,0,4"
                IsVisible="{Binding IsHistory, Converter={StaticResource Not}}"
                Command="{Binding NewTaskCommand}"
                SemanticProperties.Description="Nova tarefa" />
    </Grid>
</ContentView>
