<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:MyTaskApp.Mobile.Views"
       x:Class="MyTaskApp.Mobile.AppShell"
       Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="Tarefas"
                      Route="tasks"
                      ContentTemplate="{DataTemplate views:TaskListPage}" />
        <ShellContent Title="Conta"
                      Route="account"
                      ContentTemplate="{DataTemplate views:AccountPage}" />
    </TabBar>

</Shell>
