<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- [LibraryImport] e a tabela de handles do sistema (WindowsDirectoryLockFinder). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <!-- [LibraryImport] gera codigo unsafe (WindowsTerminalWindowManager, ADR-030). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyTaskApp.Application\MyTaskApp.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <!--
    O app OAuth do Jira (ADR-045). O client id e o secret NAO ficam no repositorio:
    o CI passa -p:JiraClientId=... -p:JiraClientSecret=... a partir dos secrets do
    GitHub, e eles viram metadado do assembly, lido por JiraOptions.FromBuild().
    Sem eles, a build so oferece o caminho do API token.
  -->
  <ItemGroup Condition="'$(JiraClientId)' != ''">
    <AssemblyMetadata Include="JiraClientId" Value="$(JiraClientId)" />
  </ItemGroup>

  <ItemGroup Condition="'$(JiraClientSecret)' != ''">
    <AssemblyMetadata Include="JiraClientSecret" Value="$(JiraClientSecret)" />
  </ItemGroup>

  <ItemGroup>
    <!-- A implementação concreta fica escondida do Desktop, que conhece apenas as
         interfaces da Application; os testes de integração precisam alcançá-la. -->
    <InternalsVisibleTo Include="MyTaskApp.Infrastructure.Tests" />
  </ItemGroup>

</Project>
