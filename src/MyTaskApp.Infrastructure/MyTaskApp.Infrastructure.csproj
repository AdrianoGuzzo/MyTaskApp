<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- [LibraryImport] e a tabela de handles do sistema (WindowsDirectoryLockFinder). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <!-- [LibraryImport] gera codigo unsafe (WindowsTerminalWindowManager, ADR-030). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyTaskApp.Application\MyTaskApp.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <!-- A implementação concreta fica escondida do Desktop, que conhece apenas as
         interfaces da Application; os testes de integração precisam alcançá-la. -->
    <InternalsVisibleTo Include="MyTaskApp.Infrastructure.Tests" />
  </ItemGroup>

</Project>
