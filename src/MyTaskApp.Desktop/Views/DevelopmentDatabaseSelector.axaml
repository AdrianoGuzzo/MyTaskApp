<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyTaskApp.Desktop.ViewModels"
             xmlns:db="using:MyTaskApp.Application.DatabaseOperations"
             x:Class="MyTaskApp.Desktop.Views.DevelopmentDatabaseSelector"
             x:DataType="vm:DevelopmentDatabaseViewModel">

  <!--
    O que copiar para o ambiente (ADR-060): um apelido e o servidor que recebe
    o banco novo, ou um perfil de cópia. Aparece no formulário de criar o
    worktree e no card do banco, ligado ao mesmo ViewModel. Os botões de
    executar ficam com quem hospeda.
  -->

  <StackPanel Spacing="8" IsEnabled="{Binding CanEdit}">
    <StackPanel Orientation="Horizontal" Spacing="16">
      <RadioButton x:Name="ByAliasOption"
                   GroupName="DevelopmentDatabaseMode"
                   Content="Apelido + servidor"
                   IsChecked="{Binding ByAlias}" />
      <RadioButton x:Name="ByProfileOption"
                   GroupName="DevelopmentDatabaseMode"
                   Content="Perfil de cópia"
                   IsChecked="{Binding ByProfile}" />
    </StackPanel>

    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8"
          IsVisible="{Binding ByAlias}">
      <TextBlock Classes="fieldLabel" Text="Apelido" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" x:Name="SavedDatabaseBox" HorizontalAlignment="Stretch"
                PlaceholderText="O banco de origem, cadastrado em Bancos de Dados"
                ItemsSource="{Binding SavedDatabases}" SelectedItem="{Binding SelectedSavedDatabase}">
        <ComboBox.ItemTemplate>
          <!-- Dois TextBlock, e não Run: Run com binding no template do ComboBox estoura a pilha no Avalonia 12. -->
          <DataTemplate x:DataType="db:SavedDatabaseRow">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Alias}" FontWeight="SemiBold" />
              <TextBlock Classes="hint" Text="{Binding DatabaseName}" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Grid.Row="1" Classes="fieldLabel" Text="Servidor" VerticalAlignment="Center" />
      <ComboBox Grid.Row="1" Grid.Column="1" x:Name="DestinationBox" HorizontalAlignment="Stretch"
                PlaceholderText="Onde o banco novo é criado"
                ItemsSource="{Binding Destinations}" SelectedItem="{Binding SelectedDestination}" />

      <TextBlock Grid.Row="2" Classes="fieldLabel" Text="Anonimizar" VerticalAlignment="Center" />
      <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <CheckBox x:Name="AnonymizeBox" IsChecked="{Binding Anonymize}" />
        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" IsVisible="{Binding Anonymize}"
                  PlaceholderText="Perfil de anonimização"
                  ItemsSource="{Binding AnonymizationProfiles}" SelectedItem="{Binding SelectedAnonymizationProfile}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="db:AnonymizationProfileRow">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>
    </Grid>

    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" IsVisible="{Binding ByProfile}">
      <TextBlock Classes="fieldLabel" Text="Perfil" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" x:Name="CopyProfileBox" HorizontalAlignment="Stretch"
                PlaceholderText="Origem, destino e anonimização já salvos"
                ItemsSource="{Binding CopyProfiles}" SelectedItem="{Binding SelectedCopyProfile}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="db:DatabaseCopyProfileRow">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>

    <TextBlock x:Name="DatabasePreview"
               Classes="hint"
               TextWrapping="Wrap"
               Text="{Binding DestinationPreview}"
               IsVisible="{Binding DestinationPreview, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <TextBlock Classes="hint"
               TextWrapping="Wrap"
               Text="{Binding CatalogMessage}"
               IsVisible="{Binding HasCatalogMessage}" />

    <TextBlock x:Name="DatabaseError"
               Classes="body bad"
               TextWrapping="Wrap"
               Text="{Binding ErrorMessage}"
               IsVisible="{Binding HasError}" />

    <ItemsControl ItemsSource="{Binding Problems}" IsVisible="{Binding HasProblems}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="x:String">
          <TextBlock Classes="hint" TextWrapping="Wrap" Text="{Binding StringFormat='• {0}'}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Button HorizontalAlignment="Left"
            Content="Gerenciar em Bancos de Dados…"
            Command="{Binding ManageCommand}" />
  </StackPanel>
</UserControl>
