<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyTaskApp.Desktop.ViewModels"
        x:Class="MyTaskApp.Desktop.Views.TagsWindow"
        x:DataType="vm:TagsViewModel"
        x:Name="Root"
        Title="Etiquetas"
        Width="540"
        Height="640"
        MinWidth="440"
        MinHeight="440"
        WindowStartupLocation="CenterOwner">

  <!--
    Criar, editar e excluir etiquetas (ADR-025). A lista de hoje só mostra as
    bolinhas e o seletor da linha só marca: nome e cor se decidem aqui.
  -->

  <Window.Styles>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource WidgetSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WidgetStrokeSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource WidgetCardRadius}" />
      <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
    </Style>

    <Style Selector="TextBlock.meta">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextLowBrush}" />
    </Style>

    <Style Selector="TextBlock.empty">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,24,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.tagChip">
      <Setter Property="CornerRadius" Value="{StaticResource WidgetPillRadius}" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style Selector="Border.tagChip TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- A amostra da paleta. O anel marca a escolhida sem depender só da cor. -->
    <Style Selector="Button.swatch">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.swatch.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource WidgetTextHighBrush}" />
    </Style>

    <Style Selector="ToggleButton.rowAction">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.rowAction">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

  </Window.Styles>

  <DockPanel Margin="16,14">

    <!-- Erro e confirmação no mesmo lugar, como no gerenciamento de dados. -->
    <Border DockPanel.Dock="Bottom"
            Margin="0,10,0,0"
            Padding="10,7"
            CornerRadius="6"
            Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
            IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding ErrorMessage}"
                 FontSize="12"
                 Foreground="{DynamicResource WidgetDangerBrush}"
                 TextWrapping="Wrap" />
    </Border>

    <Border DockPanel.Dock="Bottom"
            Margin="0,10,0,0"
            Padding="10,7"
            CornerRadius="6"
            Background="{DynamicResource WidgetAccentSoftBrush}"
            IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding StatusMessage}"
                 FontSize="12"
                 TextWrapping="Wrap" />
    </Border>

    <!-- ============================ FORMULÁRIO ============================ -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12">
      <StackPanel Spacing="10">

        <TextBlock Classes="sectionTitle" Text="{Binding FormTitle}" />

        <TextBox x:Name="NameBox"
                 FontSize="12"
                 MaxLength="40"
                 PlaceholderText="Nome da etiqueta (ex.: Urgente)"
                 Text="{Binding Name}" />

        <ItemsControl ItemsSource="{Binding Palette}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SwatchViewModel">
              <Button Classes="swatch"
                      Classes.selected="{Binding IsSelected}"
                      Background="{Binding Fill}"
                      ToolTip.Tip="{Binding ColorHex}"
                      Command="{Binding #Root.((vm:TagsViewModel)DataContext).PickColorCommand}"
                      CommandParameter="{Binding ColorHex}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ToggleButton HorizontalAlignment="Left"
                      FontSize="11"
                      Padding="8,3"
                      Content="Personalizar cor…"
                      IsChecked="{Binding IsCustomizing}" />

        <!--
          Cor livre. Alfa fora: a cor é salva como #RRGGBB. A aba de paleta do
          próprio ColorView sai também — a paleta que importa é a de cima.
        -->
        <ColorView IsVisible="{Binding IsCustomizing}"
                   Color="{Binding Color}"
                   IsAlphaEnabled="False"
                   IsAlphaVisible="False"
                   IsColorPaletteVisible="False"
                   HorizontalAlignment="Left" />

        <Grid ColumnDefinitions="Auto,*,Auto,Auto">

          <!-- A prévia: nome sobre a cor, com o texto que mais contrasta. -->
          <Border Grid.Column="0"
                  Classes="tagChip"
                  MaxWidth="200"
                  Background="{Binding PreviewFill}"
                  ToolTip.Tip="{Binding ColorHex}">
            <TextBlock Text="{Binding PreviewName}"
                       Foreground="{Binding PreviewForeground}" />
          </Border>

          <Button Grid.Column="2"
                  Margin="0,0,8,0"
                  Content="Cancelar"
                  IsVisible="{Binding IsEditing}"
                  Command="{Binding CancelEditCommand}" />

          <Button Grid.Column="3"
                  Classes="accent"
                  Content="{Binding SaveLabel}"
                  IsDefault="True"
                  Command="{Binding SaveCommand}" />
        </Grid>

      </StackPanel>
    </Border>

    <!-- ============================== LISTA =============================== -->
    <DockPanel>

      <TextBlock DockPanel.Dock="Top"
                 Classes="meta"
                 Margin="2,0,0,6"
                 Text="Carregando…"
                 IsVisible="{Binding IsBusy}" />

      <TextBlock DockPanel.Dock="Top"
                 Classes="empty"
                 IsVisible="{Binding IsEmpty}"
                 Text="Nenhuma etiqueta ainda. Crie a primeira acima — depois é só marcar nas tarefas pelo botão de etiqueta da linha." />

      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Tags}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TagListItemViewModel">
              <Border Classes="card" Margin="0,0,0,6" Padding="10,7">
                <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">

                  <Ellipse Grid.Column="0"
                           Width="12"
                           Height="12"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           Fill="{Binding Chip.Fill}" />

                  <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Chip.Name}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="meta" Text="{Binding UsageLabel}" />
                  </StackPanel>

                  <ToggleButton Grid.Column="2"
                                Classes="rowAction"
                                Margin="8,0,0,0"
                                Content="{Binding DirectoriesLabel}"
                                IsChecked="{Binding IsExpanded, Mode=OneWay}"
                                ToolTip.Tip="Pastas desta etiqueta. O alias delas insere o caminho na anotação."
                                Command="{Binding #Root.((vm:TagsViewModel)DataContext).ToggleDirectoriesCommand}"
                                CommandParameter="{Binding}" />

                  <Button Grid.Column="3"
                          Classes="rowAction"
                          Margin="6,0,6,0"
                          Content="Editar"
                          Command="{Binding #Root.((vm:TagsViewModel)DataContext).EditCommand}"
                          CommandParameter="{Binding}" />

                  <Button Grid.Column="4"
                          Classes="rowAction danger"
                          Content="Excluir"
                          Command="{Binding #Root.((vm:TagsViewModel)DataContext).DeleteCommand}"
                          CommandParameter="{Binding}" />
                </Grid>

                <!--
                  Diretórios da etiqueta (ADR-026). O alias é só atalho: na
                  anotação, "@" + alias insere o path, e o texto não guarda
                  vínculo nenhum com este cadastro.
                -->
                <StackPanel Spacing="6" IsVisible="{Binding IsExpanded}">

                  <Border Height="1" Background="{DynamicResource WidgetStrokeSoftBrush}" />

                  <TextBlock Classes="meta"
                             TextWrapping="Wrap"
                             IsVisible="{Binding HasNoDirectories}"
                             Text="Nenhum diretório ainda. Na anotação de uma tarefa com esta etiqueta, digitar @ + alias insere o caminho da pasta." />

                  <ItemsControl ItemsSource="{Binding Directories}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TagDirectoryItemViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,4">

                          <!-- ✓ a pasta existe agora; ⚠ não existe (o cadastro continua valendo). -->
                          <Panel Grid.Column="0" Width="18" Margin="0,1,6,0"
                                 VerticalAlignment="Top"
                                 ToolTip.Tip="{Binding ExistenceTip}">
                            <TextBlock Text="&#x2713;"
                                       FontSize="12"
                                       Foreground="{DynamicResource WidgetAccentBrush}"
                                       IsVisible="{Binding IsFound}" />
                            <TextBlock Text="&#x26A0;"
                                       FontSize="12"
                                       Foreground="{DynamicResource WidgetCautionBrush}"
                                       IsVisible="{Binding IsMissing}" />
                          </Panel>

                          <StackPanel Grid.Column="1" Spacing="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding Alias}"
                                         FontSize="12"
                                         FontWeight="SemiBold" />
                              <TextBlock Classes="meta"
                                         Text="{Binding Name}"
                                         IsVisible="{Binding HasName}"
                                         TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Classes="meta"
                                       Text="{Binding Path}"
                                       TextTrimming="PrefixCharacterEllipsis"
                                       ToolTip.Tip="{Binding Path}" />
                            <TextBlock Classes="meta"
                                       Text="{Binding Description}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}" />
                          </StackPanel>

                          <Button Grid.Column="2"
                                  Classes="rowAction"
                                  Margin="6,0,6,0"
                                  VerticalAlignment="Top"
                                  Content="Editar"
                                  Command="{Binding #Root.((vm:TagsViewModel)DataContext).EditDirectoryCommand}"
                                  CommandParameter="{Binding}" />

                          <Button Grid.Column="3"
                                  Classes="rowAction danger"
                                  VerticalAlignment="Top"
                                  Content="Excluir"
                                  Command="{Binding #Root.((vm:TagsViewModel)DataContext).DeleteDirectoryCommand}"
                                  CommandParameter="{Binding}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Formulário: acrescenta, ou altera o diretório escolhido em "Editar". -->
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto"
                        ColumnSpacing="6" RowSpacing="6">

                    <TextBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                             FontSize="12"
                             MaxLength="40"
                             PlaceholderText="Alias (ex.: @ecossistema-core)"
                             Text="{Binding Alias}" />

                    <TextBox Grid.Row="1" Grid.Column="0"
                             FontSize="12"
                             MaxLength="1024"
                             PlaceholderText="Caminho (ex.: C:\Projetos\ecossistema-core)"
                             Text="{Binding Path}" />

                    <Button Grid.Row="1" Grid.Column="1"
                            Classes="rowAction"
                            Content="Procurar…"
                            ToolTip.Tip="Escolher a pasta"
                            Click="OnBrowseFolderClick" />

                    <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                             FontSize="12"
                             MaxLength="80"
                             PlaceholderText="Nome (opcional)"
                             Text="{Binding DirectoryName}" />

                    <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                             FontSize="12"
                             MaxLength="500"
                             PlaceholderText="Descrição (opcional)"
                             Text="{Binding DirectoryDescription}" />
                  </Grid>

                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                    <Button Classes="rowAction"
                            Content="Cancelar"
                            IsVisible="{Binding IsEditingDirectory}"
                            Command="{Binding #Root.((vm:TagsViewModel)DataContext).CancelDirectoryEditCommand}"
                            CommandParameter="{Binding}" />
                    <Button Classes="rowAction accent"
                            Content="{Binding DirectorySaveLabel}"
                            Command="{Binding #Root.((vm:TagsViewModel)DataContext).SaveDirectoryCommand}"
                            CommandParameter="{Binding}" />
                  </StackPanel>

                </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    </DockPanel>

  </DockPanel>
</Window>
