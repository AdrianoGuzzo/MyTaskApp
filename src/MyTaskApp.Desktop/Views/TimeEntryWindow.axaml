<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyTaskApp.Desktop.ViewModels"
        x:Class="MyTaskApp.Desktop.Views.TimeEntryWindow"
        x:DataType="vm:TimeEntryEditorViewModel"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <!--
    "Adicionar tempo" e "Editar período" (ADR-052): o dia, o início e o fim, em
    hora de parede. A regra (fim depois do início, nada no futuro, sem
    sobreposição) é do caso de uso; a recusa aparece aqui, com o diálogo aberto
    e o que foi digitado intacto.
  -->

  <StackPanel Margin="24,20" Spacing="12">

    <TextBlock x:Name="HeadingText"
               FontSize="16"
               FontWeight="SemiBold"
               Text="{Binding Heading}" />

    <!--
      Tudo digitável: 0831 é 08:31, 0610 é 06/10 (WallClockInput). Ao sair do
      campo o texto volta por extenso, ou a mensagem diz o que não foi lido. O
      calendário fica ao lado da data para quem prefere o mouse.
    -->
    <StackPanel Spacing="4">
      <TextBlock FontSize="12" FontWeight="SemiBold" Text="Data" />
      <StackPanel Orientation="Horizontal" Spacing="4">
        <TextBox x:Name="DateBox"
                 Width="120"
                 MaxLength="10"
                 PlaceholderText="dd/mm/aaaa"
                 Text="{Binding DateText}"
                 GotFocus="OnFieldGotFocus"
                 LostFocus="OnFieldLostFocus" />
        <Button x:Name="CalendarButton"
                Content="📅"
                Padding="8,4"
                ToolTip.Tip="Escolher no calendário"
                Focusable="False">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft" Opening="OnCalendarOpening">
              <Calendar x:Name="DayCalendar" SelectedDatesChanged="OnCalendarPicked" />
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </StackPanel>

    <!-- Lado a lado: a caixa de texto é estreita. A duração fecha a linha, onde se confere o que foi digitado. -->
    <StackPanel Orientation="Horizontal" Spacing="12">
      <StackPanel Spacing="4">
        <TextBlock FontSize="12" FontWeight="SemiBold" Text="Início" />
        <TextBox x:Name="StartBox"
                 Width="80"
                 MaxLength="5"
                 PlaceholderText="hh:mm"
                 Text="{Binding StartText}"
                 GotFocus="OnFieldGotFocus"
                 LostFocus="OnFieldLostFocus" />
      </StackPanel>
      <StackPanel Spacing="4">
        <TextBlock FontSize="12" FontWeight="SemiBold" Text="Fim" />
        <TextBox x:Name="EndBox"
                 Width="80"
                 MaxLength="5"
                 PlaceholderText="hh:mm"
                 Text="{Binding EndText}"
                 GotFocus="OnFieldGotFocus"
                 LostFocus="OnFieldLostFocus" />
      </StackPanel>
      <TextBlock VerticalAlignment="Bottom"
                 Margin="0,0,0,7"
                 FontSize="12"
                 Opacity="0.75"
                 Text="{Binding DurationText}" />
    </StackPanel>

    <TextBlock x:Name="InputErrorText"
               FontSize="11.5"
               Foreground="{DynamicResource WidgetDangerBrush}"
               TextWrapping="Wrap"
               IsVisible="{Binding InputError, Converter={x:Static ObjectConverters.IsNotNull}}"
               Text="{Binding InputError}" />

    <CheckBox x:Name="EndsLaterBox"
              FontSize="12"
              IsVisible="{Binding ShowsEndsLater}"
              IsChecked="{Binding EndsLater}"
              Content="{Binding EndsLaterLabel}" />

    <StackPanel Spacing="4">
      <TextBlock FontSize="12" FontWeight="SemiBold" Text="Observação" />
      <TextBox x:Name="NoteBox"
               FontSize="12"
               AcceptsReturn="False"
               MaxLength="{Binding MaxNoteLength}"
               PlaceholderText="Opcional"
               Text="{Binding Note}" />
    </StackPanel>

    <TextBlock x:Name="ErrorText"
               FontSize="11.5"
               Foreground="{DynamicResource WidgetDangerBrush}"
               TextWrapping="Wrap"
               IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
               Text="{Binding ErrorMessage}" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="CancelButton"
              MinWidth="96"
              Content="Cancelar"
              IsCancel="True"
              Click="OnCancel" />
      <Button x:Name="AcceptButton"
              MinWidth="96"
              Classes="accent"
              IsDefault="True"
              Content="{Binding AcceptLabel}"
              IsEnabled="{Binding CanAccept}"
              Click="OnAccept" />
    </StackPanel>

  </StackPanel>

</Window>
