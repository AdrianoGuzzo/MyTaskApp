<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyTaskApp.Desktop.ViewModels"
        xmlns:views="using:MyTaskApp.Desktop.Views"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="MyTaskApp.Desktop.Views.StickyNoteWindow"
        x:DataType="vm:StickyNoteViewModel"
        Title="{Binding WindowTitle}"
        Width="280"
        Height="200"
        MinWidth="200"
        MinHeight="120"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False"
        Topmost="{Binding IsPinned}">

  <!--
    Um post-it (ADR-054): uma janela por anotação, cada uma com o próprio
    "sempre no topo" — independente do widget e do HUD. Sem botão na barra de
    tarefas: cinco post-its não podem virar cinco botões lá embaixo. Quem os
    acha de volta é a lista de post-its, no painel e na bandeja.
  -->

  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding NewNoteCommand}" />
  </Window.KeyBindings>

  <Window.Resources>
    <!-- Os rádios dos submenus (cor, etiqueta, opacidade): um tema, três listas. -->
    <ControlTheme x:Key="StickyChoiceItem"
                  TargetType="MenuItem"
                  BasedOn="{StaticResource {x:Type MenuItem}}"
                  x:DataType="vm:StickyNoteChoiceViewModel">
      <Setter Property="ToggleType" Value="Radio" />
      <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
      <Setter Property="Command" Value="{Binding Select}" />
    </ControlTheme>

    <DataTemplate x:Key="StickyChoiceTemplate" x:DataType="vm:StickyNoteChoiceViewModel">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Ellipse Width="10"
                 Height="10"
                 Fill="{Binding Swatch}"
                 IsVisible="{Binding HasSwatch}"
                 VerticalAlignment="Center" />
        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Window.Styles>

    <!-- O cartão: a mesma casca do widget, num raio de cartão. -->
    <Style Selector="Border.stickyNote">
      <!-- O anel de 8px é da sombra e das alças de redimensionar. -->
      <Setter Property="Margin" Value="8" />
      <Setter Property="Background" Value="{DynamicResource WidgetSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WidgetStrokeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource WidgetShellRadius}" />
      <Setter Property="BoxShadow" Value="{DynamicResource WidgetPopupShadow}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- Barra de arrasto: área, não elemento — por isso transparente, e não nula. -->
    <Style Selector="Border.stickyHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10,4,4,0" />
      <Setter Property="MinHeight" Value="30" />
    </Style>

    <Style Selector="TextBlock.stickyGlyph">
      <Setter Property="FontFamily" Value="{StaticResource WidgetIconFont}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextLowBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <!--
      Os controles só aparecem com o mouse no post-it ou com o foco nele
      (teclado também chega). Opacidade, e não IsVisible: o cabeçalho não muda
      de tamanho no hover, e a ordem de Tab continua alcançando os botões.
    -->
    <Style Selector="Button.stickyControl">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
          <BrushTransition Property="Background" Duration="0:0:0.12" />
          <BrushTransition Property="Foreground" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.stickyNote:pointerover Button.stickyControl">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Border.stickyNote:focus-within Button.stickyControl">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Fixado, o alfinete fica: é a indicação de que este post-it não sai da frente. -->
    <Style Selector="Button.stickyControl.on">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="TextBox.stickyEditor">
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="12,4,12,10" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

    <Style Selector="Border.stickyError">
      <Setter Property="Background" Value="{DynamicResource WidgetDangerSoftBrush}" />
      <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style Selector="Border.stickyError > TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

  </Window.Styles>

  <Panel>

    <!--
      As cores do cartão são calculadas para o tema ativo (StickyNoteTint): a cor
      do post-it é tinta sobre o cartão do tema, nunca um fundo que derrube o
      contraste do texto. A opacidade escolhida está no pincel do fundo.
    -->
    <Border x:Name="Card"
            Classes="stickyNote"
            Background="{Binding NoteBackground}"
            BorderBrush="{Binding NoteBorderBrush}"
            BorderThickness="{Binding NoteBorderThickness}">

      <DockPanel>

        <!-- Atenção: uma faixa lateral na cor do post-it. Sem piscar nada. -->
        <Border x:Name="Stripe"
                DockPanel.Dock="Left"
                Width="3"
                Background="{Binding StripeBrush}"
                IsVisible="{Binding HasStripe}" />

        <Border x:Name="Header"
                DockPanel.Dock="Top"
                Classes="stickyHeader"
                Background="{Binding NoteHeaderBackground}"
                chrome:WindowDecorationProperties.ElementRole="TitleBar"
                PointerPressed="OnHeaderPointerPressed">

          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">

            <TextBlock Grid.Column="0" Classes="stickyGlyph" Text="&#xE70F;" />

            <TextBlock x:Name="AttentionGlyph"
                       Grid.Column="1"
                       Classes="stickyGlyph"
                       Text="&#xEA8F;"
                       Foreground="{Binding StripeBrush}"
                       IsVisible="{Binding IsAttention}"
                       ToolTip.Tip="Atenção" />

            <!-- A etiqueta: a bolinha na cor dela, o nome no balão — como na linha do checklist. -->
            <Ellipse x:Name="TagDot"
                     Grid.Column="2"
                     Width="8"
                     Height="8"
                     Margin="0,0,6,0"
                     VerticalAlignment="Center"
                     Fill="{Binding TagDotBrush}"
                     IsVisible="{Binding HasTag}"
                     ToolTip.Tip="{Binding TagTip}" />

            <!--
              Sem título: a primeira linha já está logo abaixo, no texto, e
              repeti-la no cabeçalho era ruído. Ela vive no título da janela
              (Alt+Tab, leitor de tela) e na lista de post-its.
            -->

            <Button x:Name="PinButton"
                    Grid.Column="4"
                    Classes="chrome stickyControl"
                    Classes.on="{Binding IsPinned}"
                    Content="{Binding PinGlyph}"
                    chrome:WindowDecorationProperties.ElementRole="User"
                    ToolTip.Tip="{Binding PinTip}"
                    Command="{Binding TogglePinCommand}" />

            <Button x:Name="MenuButton"
                    Grid.Column="5"
                    Classes="chrome stickyControl"
                    Content="&#xE712;"
                    chrome:WindowDecorationProperties.ElementRole="User"
                    ToolTip.Tip="Cor, etiqueta e mais ações">
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="OnMenuOpening">
                  <MenuItem Header="Cor"
                            ItemsSource="{Binding ColorChoices}"
                            ItemContainerTheme="{StaticResource StickyChoiceItem}"
                            ItemTemplate="{StaticResource StickyChoiceTemplate}" />
                  <MenuItem Header="Etiqueta"
                            ItemsSource="{Binding TagChoices}"
                            ItemContainerTheme="{StaticResource StickyChoiceItem}"
                            ItemTemplate="{StaticResource StickyChoiceTemplate}" />
                  <MenuItem Header="Atenção"
                            ToggleType="CheckBox"
                            IsChecked="{Binding IsAttention, Mode=OneWay}"
                            Command="{Binding ToggleAttentionCommand}" />
                  <MenuItem Header="Opacidade"
                            ItemsSource="{Binding OpacityChoices}"
                            ItemContainerTheme="{StaticResource StickyChoiceItem}"
                            ItemTemplate="{StaticResource StickyChoiceTemplate}" />
                  <Separator />
                  <MenuItem Header="Novo post-it" InputGesture="Ctrl+Shift+N" Command="{Binding NewNoteCommand}" />
                  <Separator />
                  <MenuItem Header="Arquivar" Command="{Binding ArchiveCommand}" />
                  <MenuItem Header="Excluir" Command="{Binding MoveToTrashCommand}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>

            <Button x:Name="CloseButton"
                    Grid.Column="6"
                    Classes="chrome stickyControl"
                    Content="&#xE711;"
                    chrome:WindowDecorationProperties.ElementRole="User"
                    ToolTip.Tip="Fechar (o post-it continua salvo) — Esc"
                    Command="{Binding CloseCommand}" />

          </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Classes="stickyError" IsVisible="{Binding HasError}">
          <TextBlock Text="{Binding ErrorMessage}" />
        </Border>

        <TextBox x:Name="Editor"
                 Classes="stickyEditor"
                 Text="{Binding Content}"
                 PlaceholderText="Escreva aqui…" />

      </DockPanel>
    </Border>

    <views:ResizeGrips />

  </Panel>

</Window>
