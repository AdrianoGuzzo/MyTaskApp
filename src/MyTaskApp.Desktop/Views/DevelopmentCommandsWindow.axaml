<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyTaskApp.Desktop.ViewModels"
        xmlns:spell="using:MyTaskApp.Desktop.SpellChecking"
        xmlns:views="using:MyTaskApp.Desktop.Views"
        x:Class="MyTaskApp.Desktop.Views.DevelopmentCommandsWindow"
        x:DataType="vm:DevelopmentCommandsViewModel"
        x:Name="Root"
        Title="Comandos globais"
        Width="640"
        Height="720"
        MinWidth="480"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">

  <!--
    Os comandos que a lista pós-Worktree chama por @alias (ADR-028). Mesmo
    desenho da janela de etiquetas: formulário em cima, lista embaixo.
  -->

  <Window.Styles>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource WidgetSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WidgetStrokeSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource WidgetCardRadius}" />
      <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
    </Style>

    <Style Selector="TextBlock.meta">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextLowBrush}" />
    </Style>

    <Style Selector="TextBlock.code">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextMidBrush}" />
    </Style>

    <Style Selector="TextBlock.empty">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,24,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.rowAction">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

  </Window.Styles>

  <DockPanel Margin="16,14">

    <Border DockPanel.Dock="Bottom"
            Margin="0,10,0,0"
            Padding="10,7"
            CornerRadius="6"
            Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
            IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock x:Name="ErrorText"
                 Text="{Binding ErrorMessage}"
                 FontSize="12"
                 Foreground="{DynamicResource WidgetDangerBrush}"
                 TextWrapping="Wrap" />
    </Border>

    <Border DockPanel.Dock="Bottom"
            Margin="0,10,0,0"
            Padding="10,7"
            CornerRadius="6"
            Background="{DynamicResource WidgetAccentSoftBrush}"
            IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding StatusMessage}"
                 FontSize="12"
                 TextWrapping="Wrap" />
    </Border>

    <!-- ============================== TESTE =============================== -->
    <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,12,0,0">
      <StackPanel Spacing="8">
        <TextBlock Classes="sectionTitle" Text="Testar" />
        <TextBlock Classes="meta"
                   TextWrapping="Wrap"
                   Text="&quot;Testar&quot; roda o comando de verdade, na pasta abaixo. Nada roda sem esse clique." />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <TextBox Grid.Column="0"
                   x:Name="TestDirectoryBox"
                   FontSize="12"
                   PlaceholderText="Pasta onde testar (ex.: C:\Projetos\meu-projeto)"
                   Text="{Binding TestDirectory}" />
          <Button Grid.Column="1"
                  Classes="rowAction"
                  Content="Procurar…"
                  Click="OnBrowseTestDirectoryClick" />
        </Grid>
        <TextBox x:Name="TestArgumentsBox"
                 FontSize="12"
                 FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace"
                 PlaceholderText="Parâmetros do teste, para comandos com {nome} (ex.: nomebanco=MeuBanco)"
                 Text="{Binding TestArguments}" />

        <StackPanel Spacing="6" IsVisible="{Binding HasTest}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Classes="meta"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding TestTitle}" />
            <Button Grid.Column="1"
                    Classes="rowAction"
                    Content="Cancelar"
                    IsVisible="{Binding IsTesting}"
                    Command="{Binding CancelTestCommand}" />
          </Grid>
          <views:CommandOutputView x:Name="TestTerminal" DataContext="{Binding TestOutput}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ============================ FORMULÁRIO ============================ -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12">
      <StackPanel Spacing="8">

        <TextBlock Classes="sectionTitle" Text="{Binding FormTitle}" />

        <TextBox x:Name="AliasBox"
                 FontSize="12"
                 MaxLength="40"
                 PlaceholderText="Apelido (ex.: @restore)"
                 Text="{Binding Alias}" />

        <TextBox x:Name="CommandBox"
                 FontSize="12"
                 FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace"
                 MaxLength="2000"
                 PlaceholderText="Comando (ex.: dotnet restore ou eco-sync {nomebanco} -Dev)"
                 Text="{Binding Command}" />

        <TextBlock Classes="meta"
                   TextWrapping="Wrap"
                   Text="Parâmetros: escreva {nome} no comando para criar uma variável — ex.: eco-sync {nomebanco} -Dev. Quem chama preenche na própria linha: @eco-sync nomebanco=MeuBanco." />

        <TextBlock x:Name="DetectedParametersText"
                   Classes="code"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource WidgetAccentBrush}"
                   Text="{Binding DetectedParameters}"
                   IsVisible="{Binding HasDetectedParameters}" />

        <TextBox FontSize="12"
                 MaxLength="500"
                 PlaceholderText="Descrição (opcional)"
                 Text="{Binding Description}"
                 spell:SpellCheck.IsEnabled="True" />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancelar"
                  IsVisible="{Binding IsEditing}"
                  Command="{Binding CancelEditCommand}" />
          <Button Classes="accent"
                  x:Name="SaveButton"
                  Content="{Binding SaveLabel}"
                  IsDefault="True"
                  Command="{Binding SaveCommand}" />
        </StackPanel>

      </StackPanel>
    </Border>

    <!-- ============================== LISTA =============================== -->
    <DockPanel>

      <TextBox DockPanel.Dock="Top"
               x:Name="SearchBox"
               Margin="0,0,0,8"
               FontSize="12"
               PlaceholderText="Pesquisar por apelido, comando ou descrição"
               Text="{Binding Search}" />

      <TextBlock DockPanel.Dock="Top"
                 Classes="meta"
                 Margin="2,0,0,6"
                 Text="Carregando…"
                 IsVisible="{Binding IsBusy}" />

      <TextBlock DockPanel.Dock="Top"
                 Classes="empty"
                 IsVisible="{Binding IsEmpty}"
                 Text="Nenhum comando ainda. Crie o primeiro acima — use {nome} para um parâmetro. Depois, na aba Desenvolvimento de uma tarefa, digite @ no campo de comando." />

      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="CommandList" ItemsSource="{Binding Commands}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DevelopmentCommandListItemViewModel">
              <Border Classes="card" Margin="0,0,0,6" Padding="10,7">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">

                  <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Alias}" FontSize="12.5" FontWeight="SemiBold" />
                    <TextBlock Classes="code"
                               Text="{Binding Command}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Command}" />
                    <TextBlock Classes="code"
                               Foreground="{DynamicResource WidgetAccentBrush}"
                               Text="{Binding Usage}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasParameters}" />
                    <TextBlock Classes="meta"
                               Text="{Binding Description}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasDescription}" />
                  </StackPanel>

                  <Button Grid.Column="1"
                          Classes="rowAction"
                          Margin="8,0,0,0"
                          Content="Testar"
                          IsEnabled="{Binding !#Root.((vm:DevelopmentCommandsViewModel)DataContext).IsTesting}"
                          Command="{Binding #Root.((vm:DevelopmentCommandsViewModel)DataContext).TestCommand}"
                          CommandParameter="{Binding}" />

                  <Button Grid.Column="2"
                          Classes="rowAction"
                          Margin="6,0,6,0"
                          Content="Editar"
                          Command="{Binding #Root.((vm:DevelopmentCommandsViewModel)DataContext).EditCommand}"
                          CommandParameter="{Binding}" />

                  <Button Grid.Column="3"
                          Classes="rowAction danger"
                          Content="Excluir"
                          Command="{Binding #Root.((vm:DevelopmentCommandsViewModel)DataContext).DeleteCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    </DockPanel>

  </DockPanel>
</Window>
