<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyTaskApp.Desktop.ViewModels"
        xmlns:spell="using:MyTaskApp.Desktop.SpellChecking"
        xmlns:views="using:MyTaskApp.Desktop.Views"
        x:Class="MyTaskApp.Desktop.Views.DevelopmentCommandsWindow"
        x:DataType="vm:DevelopmentCommandsViewModel"
        x:Name="Root"
        Title="Comandos globais"
        Width="680"
        Height="820"
        MinWidth="480"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">

  <!--
    Os comandos que a lista pós-Worktree chama por @alias (ADR-028), e que viram
    botão no worktree quando ligados a um diretório de etiqueta (ADR-051). Mesmo
    desenho da janela de etiquetas: formulário em cima, lista embaixo.
  -->

  <Window.Styles>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource WidgetSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WidgetStrokeSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource WidgetCardRadius}" />
      <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
    </Style>

    <Style Selector="TextBlock.meta">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextLowBrush}" />
    </Style>

    <Style Selector="TextBlock.code">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextMidBrush}" />
    </Style>

    <Style Selector="TextBlock.empty">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,24,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.rowAction">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

  </Window.Styles>

  <DockPanel Margin="16,14">

    <Border DockPanel.Dock="Bottom"
            Margin="0,10,0,0"
            Padding="10,7"
            CornerRadius="6"
            Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
            IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock x:Name="ErrorText"
                 Text="{Binding ErrorMessage}"
                 FontSize="12"
                 Foreground="{DynamicResource WidgetDangerBrush}"
                 TextWrapping="Wrap" />
    </Border>

    <Border DockPanel.Dock="Bottom"
            Margin="0,10,0,0"
            Padding="10,7"
            CornerRadius="6"
            Background="{DynamicResource WidgetAccentSoftBrush}"
            IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding StatusMessage}"
                 FontSize="12"
                 TextWrapping="Wrap" />
    </Border>

    <!-- ============================== TESTE =============================== -->
    <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,12,0,0">
      <StackPanel Spacing="8">
        <TextBlock Classes="sectionTitle" Text="Testar" />
        <TextBlock Classes="meta"
                   TextWrapping="Wrap"
                   Text="&quot;Testar&quot; roda o comando de verdade, na pasta abaixo. Nada roda sem esse clique." />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <TextBox Grid.Column="0"
                   x:Name="TestDirectoryBox"
                   FontSize="12"
                   PlaceholderText="Pasta onde testar (ex.: C:\Projetos\meu-projeto)"
                   Text="{Binding TestDirectory}" />
          <Button Grid.Column="1"
                  Classes="rowAction"
                  Content="Procurar…"
                  Click="OnBrowseTestDirectoryClick" />
        </Grid>
        <TextBox x:Name="TestArgumentsBox"
                 FontSize="12"
                 FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace"
                 PlaceholderText="Parâmetros do teste, para comandos com {nome} (ex.: nomebanco=MeuBanco)"
                 Text="{Binding TestArguments}" />

        <StackPanel Spacing="6" IsVisible="{Binding HasTest}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Classes="meta"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding TestTitle}" />
            <Button Grid.Column="1"
                    Classes="rowAction"
                    Content="Cancelar"
                    IsVisible="{Binding IsTesting}"
                    Command="{Binding CancelTestCommand}" />
          </Grid>
          <views:CommandOutputView x:Name="TestTerminal" DataContext="{Binding TestOutput}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ============================ FORMULÁRIO ============================ -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12">
      <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="8">

        <TextBlock Classes="sectionTitle" Text="{Binding FormTitle}" />

        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
          <TextBox Grid.Column="0"
                   x:Name="NameBox"
                   FontSize="12"
                   MaxLength="80"
                   PlaceholderText="Nome do botão (ex.: Executar aplicação)"
                   Text="{Binding Name}" />
          <TextBox Grid.Column="1"
                   x:Name="AliasBox"
                   FontSize="12"
                   MaxLength="40"
                   PlaceholderText="Apelido (ex.: @restore)"
                   Text="{Binding Alias}" />
        </Grid>

        <TextBox x:Name="CommandBox"
                 FontSize="12"
                 FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace"
                 MaxLength="2000"
                 PlaceholderText="Comando (ex.: dotnet restore ou eco-sync {nomebanco} -Dev)"
                 Text="{Binding Command}" />

        <TextBlock Classes="meta"
                   TextWrapping="Wrap"
                   Text="Parâmetros: escreva {nome} no comando para criar uma variável — ex.: eco-sync {nomebanco} -Dev. Quem chama preenche na própria linha: @eco-sync nomebanco=MeuBanco." />

        <TextBlock x:Name="DetectedParametersText"
                   Classes="code"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource WidgetAccentTextBrush}"
                   Text="{Binding DetectedParameters}"
                   IsVisible="{Binding HasDetectedParameters}" />

        <TextBlock x:Name="VariablesHintText"
                   Classes="meta"
                   TextWrapping="Wrap"
                   Text="{Binding VariablesHint}" />

        <!-- Como o botão roda no worktree (ADR-051). -->
        <StackPanel x:Name="ModeChoice" Orientation="Horizontal" Spacing="16">
          <RadioButton GroupName="CommandMode"
                       FontSize="12"
                       Content="Execução (resultado na tela)"
                       IsChecked="{Binding IsExecute}" />
          <RadioButton x:Name="TerminalMode"
                       GroupName="CommandMode"
                       FontSize="12"
                       Content="Terminal (abre uma janela)"
                       IsChecked="{Binding IsTerminal}" />
        </StackPanel>

        <TextBox x:Name="WorkingDirectoryBox"
                 FontSize="12"
                 FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace"
                 MaxLength="1024"
                 PlaceholderText="Pasta: raiz do worktree (ou uma subpasta, ex.: src/Eco.Web)"
                 Text="{Binding WorkingDirectory}" />

        <WrapPanel ItemSpacing="16" LineSpacing="4">
          <CheckBox FontSize="12"
                    Content="Manter o terminal aberto quando o comando terminar"
                    IsVisible="{Binding IsTerminal}"
                    IsChecked="{Binding KeepTerminalOpen}" />
          <CheckBox x:Name="RequiresConfirmationBox"
                    FontSize="12"
                    Content="Pedir confirmação antes de executar"
                    IsChecked="{Binding RequiresConfirmation}" />
        </WrapPanel>

        <!-- Uma linha por {nome}: como a tela pergunta o valor antes de executar. -->
        <StackPanel Spacing="6" IsVisible="{Binding HasParameterEditors}">
          <TextBlock Classes="meta" Text="Parâmetros — perguntados antes de executar o botão:" />
          <ItemsControl x:Name="ParameterEditorList" ItemsSource="{Binding ParameterEditors}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DevelopmentCommandParameterEditorViewModel">
                <Border Classes="card" Margin="0,0,0,6" Padding="8,6">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                      <TextBlock Grid.Column="0"
                                 Classes="code"
                                 VerticalAlignment="Center"
                                 Text="{Binding Placeholder}" />
                      <TextBox Grid.Column="1"
                               FontSize="12"
                               MaxLength="80"
                               PlaceholderText="Rótulo (ex.: Projeto)"
                               Text="{Binding Label}" />
                      <ComboBox Grid.Column="2"
                                FontSize="12"
                                MinWidth="130"
                                ItemsSource="{x:Static vm:DevelopmentCommandParameterEditorViewModel.TypeOptions}"
                                SelectedIndex="{Binding TypeIndex}" />
                      <CheckBox Grid.Column="3"
                                FontSize="12"
                                Content="Obrigatório"
                                IsChecked="{Binding IsRequired}" />
                    </Grid>
                    <TextBox FontSize="12"
                             MaxLength="500"
                             PlaceholderText="Valor padrão (opcional)"
                             Text="{Binding DefaultValue}" />
                    <TextBox FontSize="12"
                             AcceptsReturn="True"
                             MinHeight="56"
                             PlaceholderText="Opções, uma por linha (ex.: Development)"
                             IsVisible="{Binding IsChoice}"
                             Text="{Binding OptionsText}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <TextBox FontSize="12"
                 MaxLength="500"
                 PlaceholderText="Descrição (opcional)"
                 Text="{Binding Description}"
                 spell:SpellCheck.IsEnabled="True" />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancelar"
                  IsVisible="{Binding IsEditing}"
                  Command="{Binding CancelEditCommand}" />
          <Button Classes="accent"
                  x:Name="SaveButton"
                  Content="{Binding SaveLabel}"
                  IsDefault="True"
                  Command="{Binding SaveCommand}" />
        </StackPanel>

      </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- ============================== LISTA =============================== -->
    <DockPanel>

      <TextBox DockPanel.Dock="Top"
               x:Name="SearchBox"
               Margin="0,0,0,8"
               FontSize="12"
               PlaceholderText="Pesquisar por apelido, comando ou descrição"
               Text="{Binding Search}" />

      <TextBlock DockPanel.Dock="Top"
                 Classes="meta"
                 Margin="2,0,0,6"
                 Text="Carregando…"
                 IsVisible="{Binding IsBusy}" />

      <TextBlock DockPanel.Dock="Top"
                 Classes="empty"
                 IsVisible="{Binding IsEmpty}"
                 Text="Nenhum comando ainda. Crie o primeiro acima — use {nome} para um parâmetro. Depois, ligue-o a um diretório em Etiquetas… para virar um botão no worktree, ou digite @ na lista de comandos pós-Worktree de uma tarefa." />

      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="CommandList" ItemsSource="{Binding Commands}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DevelopmentCommandListItemViewModel">
              <Border Classes="card" Margin="0,0,0,6" Padding="10,7">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">

                  <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold" />
                      <TextBlock Classes="meta"
                                 VerticalAlignment="Center"
                                 Text="{Binding Alias}"
                                 IsVisible="{Binding HasName}" />
                    </StackPanel>
                    <TextBlock Classes="code"
                               Text="{Binding Command}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Command}" />
                    <TextBlock Classes="code"
                               Foreground="{DynamicResource WidgetAccentTextBrush}"
                               Text="{Binding Usage}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasParameters}" />
                    <TextBlock Classes="meta"
                               Text="{Binding Description}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasDescription}" />
                    <TextBlock Classes="meta" Text="{Binding Summary}" />
                  </StackPanel>

                  <Button Grid.Column="1"
                          Classes="rowAction"
                          Margin="8,0,0,0"
                          Content="Testar"
                          IsEnabled="{Binding !#Root.((vm:DevelopmentCommandsViewModel)DataContext).IsTesting}"
                          Command="{Binding #Root.((vm:DevelopmentCommandsViewModel)DataContext).TestCommand}"
                          CommandParameter="{Binding}" />

                  <Button Grid.Column="2"
                          Classes="rowAction"
                          Margin="6,0,6,0"
                          Content="Editar"
                          Command="{Binding #Root.((vm:DevelopmentCommandsViewModel)DataContext).EditCommand}"
                          CommandParameter="{Binding}" />

                  <Button Grid.Column="3"
                          Classes="rowAction danger"
                          Content="Excluir"
                          Command="{Binding #Root.((vm:DevelopmentCommandsViewModel)DataContext).DeleteCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    </DockPanel>

  </DockPanel>
</Window>
