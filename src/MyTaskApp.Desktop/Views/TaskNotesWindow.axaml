<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyTaskApp.Desktop.ViewModels"
        xmlns:spell="using:MyTaskApp.Desktop.SpellChecking"
        xmlns:notes="using:MyTaskApp.Desktop.Notes"
        xmlns:dev="using:MyTaskApp.Desktop.Development"
        xmlns:views="using:MyTaskApp.Desktop.Views"
        xmlns:agents="using:MyTaskApp.Application.Agents"
        xmlns:commands="using:MyTaskApp.Application.Commands"
        x:Class="MyTaskApp.Desktop.Views.TaskNotesWindow"
        x:DataType="vm:TaskNotesViewModel"
        x:Name="Root"
        Title="{Binding WindowTitle}"
        Width="900"
        Height="640"
        MinWidth="460"
        MinHeight="340"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WidgetCanvasBrush}">

  <Window.KeyBindings>
    <!--
      Ctrl+S grava e mantém a janela aberta, igual ao botão. Um atalho que fizesse outra coisa
      que o botão seria uma segunda regra para o mesmo gesto.
    -->
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
  </Window.KeyBindings>

  <Window.Styles>

    <Style Selector="TextBlock.pageTitle">
      <Setter Property="FontSize" Value="21" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
      O título editável se veste de título: mesma fonte do TextBlock.pageTitle,
      sem a moldura de formulário. A borda só aparece no hover e no foco, para
      dizer que dá para escrever sem transformar o cabeçalho num campo.
    -->
    <Style Selector="TextBox.pageTitle">
      <Setter Property="FontSize" Value="21" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="AcceptsReturn" Value="False" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Margin" Value="-6,0,0,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="TextBox.pageTitle /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="TextBox.pageTitle:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource WidgetStrokeBrush}" />
    </Style>

    <Style Selector="TextBox.pageTitle:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource WidgetStrokeBrush}" />
    </Style>

    <Style Selector="TextBlock.pageHint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextLowBrush}" />
    </Style>

    <!-- Etiqueta de estado, como a de arquivado na janela de dados. -->
    <Style Selector="Border.stateTag">
      <Setter Property="Background" Value="{DynamicResource WidgetCautionSoftBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource WidgetPillRadius}" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.stateTag TextBlock">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="LetterSpacing" Value="0.5" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetCautionBrush}" />
    </Style>

    <!--
      Botão da barra de formatação. Mesma receita do Button.chrome: o fundo do
      hover mora no ContentPresenter do template, senão o tema Fluent repinta
      por cima do Setter do Background.
    -->
    <Style Selector="Button.tool">
      <!--
        Não recebe foco, e é isso que faz a barra funcionar: clicar num botão
        focável tira o foco da caixa de texto, e com ele a seleção — o clique em
        B formataria o vazio onde o cursor caiu, e não a palavra escolhida.
        Os atalhos Ctrl+B/I/U continuam sendo o caminho de teclado.
      -->
      <Setter Property="Focusable" Value="False" />
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextMidBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.tool /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource WidgetPillRadius}" />
    </Style>

    <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WidgetSurfaceHoverBrush}" />
    </Style>

    <Style Selector="Button.tool:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
    </Style>

    <Style Selector="Button.tool.bold">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Button.tool.italic">
      <Setter Property="FontStyle" Value="Italic" />
    </Style>

    <Style Selector="Button.tool.underline">
      <Setter Property="TextBlock.TextDecorations" Value="Underline" />
    </Style>

    <Style Selector="Button.tool.strike">
      <Setter Property="TextBlock.TextDecorations" Value="Strikethrough" />
    </Style>

    <!--
      Escrever / Visualizar / Lado a lado. Também não recebe foco: trocar de
      modo não deve tirar o cursor de onde ele estava na caixa de texto.
    -->
    <Style Selector="Button.mode">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextMidBrush}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.mode /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource WidgetPillRadius}" />
    </Style>

    <Style Selector="Button.mode:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WidgetSurfaceHoverBrush}" />
    </Style>

    <Style Selector="Button.mode:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
    </Style>

    <Style Selector="Button.mode.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WidgetAccentSoftBrush}" />
    </Style>

    <Style Selector="Button.mode.active">
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
    </Style>

    <!--
      A coluna de leitura. Lado a lado ela alarga: duas metades de 460px seriam
      estreitas demais para escrever ou para ler.
    -->
    <Style Selector="DockPanel.page">
      <Setter Property="MaxWidth" Value="920" />
    </Style>

    <Style Selector="DockPanel.page.wide">
      <Setter Property="MaxWidth" Value="1680" />
    </Style>

    <Style Selector="Border.toolDivider">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource WidgetStrokeBrush}" />
    </Style>

    <!--
      A folha onde o texto mora. A largura vem da coluna que a contém — ver o
      MaxWidth do DockPanel lá embaixo.
    -->
    <Style Selector="Border.sheet">
      <Setter Property="Background" Value="{DynamicResource WidgetSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WidgetStrokeSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource WidgetCardRadius}" />
      <Setter Property="Padding" Value="22,18" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.sheet.split">
      <Setter Property="Margin" Value="12,0,0,0" />
    </Style>

    <Style Selector="Border.sheet:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource WidgetAccentLineBrush}" />
    </Style>

    <!--
      Autocomplete de diretórios (ADR-026). Os itens não recebem foco: o cursor
      precisa ficar na caixa de texto enquanto o usuário escolhe, pelo mesmo
      motivo do Button.tool.
    -->
    <Style Selector="Border.aliasList">
      <Setter Property="Background" Value="{DynamicResource WidgetSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WidgetStrokeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource WidgetCardRadius}" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="MinWidth" Value="320" />
      <Setter Property="MaxWidth" Value="560" />
    </Style>

    <Style Selector="Border.aliasItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{StaticResource WidgetPillRadius}" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- ===== A issue do Jira (ADR-045) ===== -->

    <Style Selector="Border.issueCard">
      <Setter Property="Background" Value="{DynamicResource WidgetSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WidgetStrokeSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource WidgetCardRadius}" />
      <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style Selector="Border.issueType">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource WidgetStrokeSoftBrush}" />
    </Style>

    <Style Selector="Border.issueType > TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
    </Style>

    <Style Selector="Border.issueType.bug">
      <Setter Property="Background" Value="{DynamicResource WidgetDangerSoftBrush}" />
    </Style>

    <Style Selector="Border.issueType.bug > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource WidgetDangerBrush}" />
    </Style>

    <Style Selector="Border.issueType.story > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource WidgetSuccessBrush}" />
    </Style>

    <Style Selector="Border.issueType.task > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource WidgetInfoBrush}" />
    </Style>

    <!-- A chave é o destaque: é ela que se reconhece entre dez tarefas. -->
    <Style Selector="Button.issueKey">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetAccentBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- O link da PR aberta (ADR-047): o mesmo jeito de link, no tamanho do formulário. -->
    <Style Selector="Button.issueKey.prLink">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.issueStatus">
      <Setter Property="Margin" Value="10,0,0,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextMidBrush}" />
    </Style>

    <Style Selector="SelectableTextBlock.issueTitle">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
    </Style>

    <Style Selector="TextBlock.issueField">
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextLowBrush}" />
    </Style>

    <Style Selector="SelectableTextBlock.issueBranch">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
    </Style>

    <Style Selector="Button.issueAction">
      <Setter Property="Margin" Value="0,0,6,4" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="FontSize" Value="11" />
    </Style>

    <Style Selector="TextBlock.issueMeta">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextLowBrush}" />
    </Style>

    <!-- ===== O prazo (ADR-050) ===== -->

    <Style Selector="Border.deadlineCard Button.small">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="FontSize" Value="11" />
    </Style>

    <Style Selector="Border.deadlineCard Button.chip">
      <Setter Property="Margin" Value="0,0,6,4" />
    </Style>

    <Style Selector="Border.deadlineCard RadioButton, Border.deadlineCard CheckBox">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="MinHeight" Value="24" />
    </Style>

    <Style Selector="Border.deadlineCard TextBlock.planLabel">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextLowBrush}" />
    </Style>

    <Style Selector="Border.deadlineCard TextBox.plan, Border.deadlineCard NumericUpDown.plan">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="28" />
    </Style>

    <!--
      O tema tira a moldura de todo campo (Tokens.axaml): quem a desenha é o
      cartão em volta. Aqui o cartão tem vários campos, então cada um ganha a
      sua — senão "próxima ação" parece rótulo, e a estimativa nem aparece.
    -->
    <Style Selector="Border.deadlineCard TextBox.plan /template/ Border#PART_BorderElement, Border.deadlineCard NumericUpDown.plan TextBox /template/ Border#PART_BorderElement">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource WidgetStrokeBrush}" />
      <Setter Property="Background" Value="{DynamicResource WidgetCanvasBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource WidgetPillRadius}" />
    </Style>

    <Style Selector="Border.deadlineCard TextBox.plan:focus /template/ Border#PART_BorderElement, Border.deadlineCard NumericUpDown.plan TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource WidgetAccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource WidgetCanvasBrush}" />
    </Style>

    <Style Selector="Border.deadlineCard TextBlock.deadlineGlyph">
      <Setter Property="FontFamily" Value="{StaticResource WidgetIconFont}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextMidBrush}" />
    </Style>

    <Style Selector="StackPanel.deadlineSummary TextBlock.deadlineDate">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
    </Style>

    <Style Selector="StackPanel.deadlineSummary TextBlock.deadlineCountdown">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextMidBrush}" />
    </Style>

    <Style Selector="StackPanel.deadlineSummary.attention TextBlock.deadlineCountdown">
      <Setter Property="Foreground" Value="{DynamicResource WidgetCautionBrush}" />
    </Style>

    <Style Selector="StackPanel.deadlineSummary.urgent TextBlock.deadlineCountdown, StackPanel.deadlineSummary.overdue TextBlock.deadlineCountdown">
      <Setter Property="Foreground" Value="{DynamicResource WidgetDangerBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Border.issueSuggestion">
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Border.issueSuggestion:pointerover">
      <Setter Property="Background" Value="{DynamicResource WidgetSurfaceHoverBrush}" />
    </Style>

    <Style Selector="Border.issueSuggestion.selected">
      <Setter Property="Background" Value="{DynamicResource WidgetAccentSoftBrush}" />
    </Style>

    <Style Selector="TextBlock.suggestionKey">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetAccentBrush}" />
    </Style>

    <Style Selector="TextBlock.suggestionTitle">
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
    </Style>

    <Style Selector="Border.aliasItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource WidgetSurfaceHoverBrush}" />
    </Style>

    <Style Selector="Border.aliasItem.selected">
      <Setter Property="Background" Value="{DynamicResource WidgetAccentSoftBrush}" />
    </Style>

    <Style Selector="TextBlock.aliasName">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
    </Style>

    <Style Selector="TextBlock.aliasPath">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextMidBrush}" />
      <Setter Property="TextTrimming" Value="PrefixCharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.aliasTag">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextLowBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.footNote">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextLowBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Abas: Anotação e Desenvolvimento (ADR-027). -->
    <Style Selector="TabControl.taskTabs TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="12,0" />
    </Style>

    <!--
      As abas de repositório da tarefa (ADR-031): pílulas lado a lado, que
      quebram linha quando não cabem. A escolhida ganha o tom de destaque.
    -->
    <Style Selector="ListBox.repoStrip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBox.repoStrip ListBoxItem">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="CornerRadius" Value="{StaticResource WidgetPillRadius}" />
      <Setter Property="Background" Value="{DynamicResource WidgetSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WidgetStrokeSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="ListBox.repoStrip ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WidgetSurfaceHoverBrush}" />
    </Style>

    <Style Selector="ListBox.repoStrip ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WidgetAccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WidgetAccentLineBrush}" />
    </Style>

    <Style Selector="TextBlock.chipTitle">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.chipMeta">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextMidBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.chipAgent">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetAccentTextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Aba Desenvolvimento: cartões empilhados, como a folha da anotação. -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource WidgetSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WidgetStrokeSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource WidgetCardRadius}" />
      <Setter Property="Padding" Value="20,16" />
    </Style>

    <Style Selector="Border.card.danger">
      <Setter Property="BorderBrush" Value="{DynamicResource WidgetDangerBrush}" />
    </Style>

    <Style Selector="Border.card.caution">
      <Setter Property="BorderBrush" Value="{DynamicResource WidgetCautionBrush}" />
    </Style>

    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
    </Style>

    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextMidBrush}" />
    </Style>

    <!-- ===== Aba Tempo (ADR-052) ===== -->

    <Style Selector="TextBlock.timeClock">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetAccentBrush}" />
    </Style>

    <Style Selector="Button.timeToggle">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Button.timeToggle TextBlock.timeGlyph">
      <Setter Property="FontFamily" Value="{StaticResource WidgetIconFont}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.timeEntry">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="{StaticResource WidgetPillRadius}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Border.timeEntry:pointerover">
      <Setter Property="Background" Value="{DynamicResource WidgetSurfaceBrush}" />
    </Style>

    <Style Selector="Border.timeEntry.active">
      <Setter Property="Background" Value="{DynamicResource WidgetAccentSoftBrush}" />
    </Style>

    <Style Selector="TextBlock.timeRange">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
    </Style>

    <Style Selector="TextBlock.timeDuration">
      <Setter Property="Margin" Value="12,0,0,0" />
      <Setter Property="MinWidth" Value="64" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
    </Style>

    <Style Selector="TextBlock.timeSource">
      <Setter Property="Margin" Value="12,0,4,0" />
      <Setter Property="MinWidth" Value="48" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextLowBrush}" />
    </Style>

    <!-- ✎ e 🗑 discretos até o hover, como os botões da linha da lista. -->
    <Style Selector="Button.timeAction">
      <Setter Property="FontFamily" Value="{StaticResource WidgetIconFont}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextMidBrush}" />
    </Style>

    <Style Selector="Border.timeEntry:pointerover Button.timeAction">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="TextBlock.body">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextLowBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
      Passou da estimativa (ADR-052): cor de cautela, e o texto já diz quanto.
      Não bloqueia nada. Depois do TextBlock.hint, para a cor dele não vencer.
    -->
    <Style Selector="TextBlock.hint.over">
      <Setter Property="Foreground" Value="{DynamicResource WidgetCautionBrush}" />
    </Style>

    <Style Selector="TextBlock.ok">
      <Setter Property="Foreground" Value="{DynamicResource WidgetAccentTextBrush}" />
    </Style>

    <Style Selector="TextBlock.bad">
      <Setter Property="Foreground" Value="{DynamicResource WidgetDangerBrush}" />
    </Style>

    <Style Selector="TextBlock.warn">
      <Setter Property="Foreground" Value="{DynamicResource WidgetCautionBrush}" />
    </Style>

    <!-- Comando, caminho e saída do Git: fonte de terminal, selecionável. -->
    <Style Selector="SelectableTextBlock.code">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Border.codeBox">
      <Setter Property="Background" Value="{DynamicResource WidgetCanvasBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource WidgetPillRadius}" />
      <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style Selector="TextBlock.stepGlyph">
      <Setter Property="Width" Value="18" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextLowBrush}" />
    </Style>

    <Style Selector="TextBlock.stepGlyph.done">
      <Setter Property="Foreground" Value="{DynamicResource WidgetAccentBrush}" />
    </Style>

    <Style Selector="TextBlock.stepGlyph.running">
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
    </Style>

    <Style Selector="TextBlock.stepGlyph.warning">
      <Setter Property="Foreground" Value="{DynamicResource WidgetCautionBrush}" />
    </Style>

    <Style Selector="TextBlock.stepGlyph.failed">
      <Setter Property="Foreground" Value="{DynamicResource WidgetDangerBrush}" />
    </Style>

    <Style Selector="TextBlock.stepTitle">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
    </Style>

    <Style Selector="TextBlock.stepTitle.pending">
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextLowBrush}" />
    </Style>

    <Style Selector="TextBlock.branchHeader">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextLowBrush}" />
    </Style>

  </Window.Styles>

  <Window.Resources>

    <!--
      Um item do autocomplete de diretórios (ADR-026). Recurso porque são duas
      listas: a da anotação e a do campo Diretório (ADR-027).
    -->
    <DataTemplate x:Key="AliasSuggestionTemplate" x:DataType="vm:AliasSuggestionViewModel">
      <Border Classes="aliasItem"
              Classes.selected="{Binding IsSelected}"
              ToolTip.Tip="{Binding Details}"
              PointerPressed="OnAliasPressed">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Grid.Column="0" Spacing="1">
            <TextBlock Classes="aliasName" Text="{Binding Alias}" />
            <TextBlock Classes="aliasPath" Text="{Binding Path}" />
          </StackPanel>
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="6"
                      VerticalAlignment="Top">
            <TextBlock Classes="aliasTag"
                       Text="&#x26A0; pasta não encontrada"
                       Foreground="{DynamicResource WidgetCautionBrush}"
                       IsVisible="{Binding IsMissing}" />
            <Ellipse Width="8"
                     Height="8"
                     VerticalAlignment="Center"
                     Fill="{Binding Tag.Fill}" />
            <TextBlock Classes="aliasTag" Text="{Binding Tag.Name}" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <!--
      Um item do "@" no texto do agente (ADR-039): um ambiente da tarefa, uma
      pasta ou um arquivo dele. Mesmo desenho da lista de diretórios.
    -->
    <DataTemplate x:Key="ReferenceSuggestionTemplate" x:DataType="vm:ReferenceSuggestionViewModel">
      <Border Classes="aliasItem"
              Classes.selected="{Binding IsSelected}"
              ToolTip.Tip="{Binding FullPath}"
              PointerPressed="OnReferencePressed">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Grid.Column="0" Spacing="1">
            <TextBlock Classes="aliasName" Text="{Binding Title}" />
            <TextBlock Classes="aliasPath" Text="{Binding Detail}" />
          </StackPanel>
          <TextBlock Grid.Column="1"
                     Classes="aliasTag"
                     VerticalAlignment="Top"
                     Text="{Binding Badge}"
                     IsVisible="{Binding HasBadge}" />
        </Grid>
      </Border>
    </DataTemplate>

  </Window.Resources>

  <!--
    Tudo numa coluna centralizada, e não coladas à esquerda: maximizada, a
    janela tem 1920px, e uma linha de texto dessa largura é ilegível. O teto é
    da coluna inteira — cabeçalho, barra, folha e rodapé — porque alinhar só a
    folha deixaria a barra de formatação flutuando longe do texto que ela
    formata, que foi exatamente o que a primeira versão fez.
  -->
  <DockPanel Classes="page"
             Classes.wide="{Binding IsWide}"
             HorizontalAlignment="Center">

    <!--
      Cabeçalho: o título do item, que é o assunto da janela inteira. Editável
      enquanto a tarefa está em aberto, e gravado pelo mesmo "Salvar" da anotação.
    -->
    <Border DockPanel.Dock="Top" Padding="24,18,24,12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

        <StackPanel Grid.Column="0" Spacing="3">
          <TextBox Classes="pageTitle"
                   x:Name="TitleEditor"
                   spell:SpellCheck.IsEnabled="True"
                   Text="{Binding TaskTitle}"
                   MaxLength="{Binding MaxTitleLength}"
                   PlaceholderText="Título da tarefa"
                   ToolTip.Tip="Clique para editar o título"
                   IsVisible="{Binding IsEditable}"
                   KeyDown="OnTitleKeyDown" />
          <TextBlock Classes="pageTitle"
                     Text="{Binding TaskTitle}"
                     IsVisible="{Binding IsReadOnly}" />
          <TextBlock Classes="pageHint"
                     Text="{Binding TitleError}"
                     Foreground="{DynamicResource WidgetDangerBrush}"
                     IsVisible="{Binding TitleError, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Classes="pageHint"
                     Text="Anote aqui o que mais precisa saber sobre esta tarefa."
                     IsVisible="{Binding IsEditable}" />
          <TextBlock Classes="pageHint"
                     Text="Tarefa concluída. A anotação fica como registro, e só pode ser lida."
                     IsVisible="{Binding IsReadOnly}" />
        </StackPanel>

        <Border Grid.Column="1" Classes="stateTag" IsVisible="{Binding IsReadOnly}">
          <TextBlock Text="SOMENTE LEITURA" />
        </Border>

      </Grid>
    </Border>

    <!--
      A issue do Jira (ADR-045): o que é esta tarefa, sem abrir o Jira — tipo,
      chave em destaque, título, status e a branch da convenção. Desenhado do
      retrato guardado, então aparece igual sem rede; só "Atualizar" vai até lá.
    -->
    <ContentControl DockPanel.Dock="Top"
                    x:Name="IssueSection"
                    Margin="24,0,24,10"
                    Content="{Binding Issue}"
                    IsVisible="{Binding Issue, Converter={x:Static ObjectConverters.IsNotNull}}">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="vm:TaskIssueViewModel">
      <StackPanel Spacing="6">

        <!-- Vinculada -->
        <Border x:Name="IssueCard" Classes="issueCard" IsVisible="{Binding HasLink}">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
              <Border Grid.Column="0"
                      Classes="issueType"
                      Classes.bug="{Binding IsBug}"
                      Classes.story="{Binding IsStory}"
                      Classes.task="{Binding IsTask}">
                <TextBlock Text="{Binding TypeLabel}" />
              </Border>
              <Button Grid.Column="1"
                      x:Name="IssueKeyLink"
                      Classes="issueKey"
                      Content="{Binding Key}"
                      ToolTip.Tip="Abrir no Jira"
                      Command="{Binding OpenInJiraCommand}" />
              <TextBlock Grid.Column="2"
                         Classes="issueStatus"
                         Text="{Binding Status}"
                         IsVisible="{Binding HasStatus}" />
              <Button Grid.Column="3"
                      Classes="issueAction"
                      Content="{Binding OpenLabel}"
                      Command="{Binding OpenInJiraCommand}" />
            </Grid>

            <SelectableTextBlock Classes="issueTitle" Text="{Binding IssueTitle}" />

            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasSuggestedBranch}">
              <TextBlock Classes="issueField" Text="Branch" />
              <SelectableTextBlock Grid.Column="1" Classes="issueBranch" Text="{Binding SuggestedBranch}" />
            </Grid>

            <WrapPanel>
              <Button Classes="issueAction" Content="Copiar chave" Command="{Binding CopyKeyCommand}" />
              <Button Classes="issueAction" Content="Copiar link" Command="{Binding CopyUrlCommand}" />
              <Button Classes="issueAction"
                      Content="Copiar branch"
                      IsVisible="{Binding HasSuggestedBranch}"
                      Command="{Binding CopyBranchCommand}" />
              <Button Classes="issueAction"
                      Content="Atualizar do Jira"
                      IsEnabled="{Binding !IsBusy}"
                      IsVisible="{Binding CanEdit}"
                      Command="{Binding RefreshCommand}" />
              <Button Classes="issueAction"
                      Content="Desvincular"
                      IsVisible="{Binding CanEdit}"
                      Command="{Binding UnlinkCommand}" />
            </WrapPanel>

            <TextBlock Classes="issueMeta" Text="{Binding SyncedLabel}" />
          </StackPanel>
        </Border>

        <!-- Sem issue: vincular é opcional, e fica à mão. -->
        <Button x:Name="LinkIssueButton"
                Classes="issueAction"
                HorizontalAlignment="Left"
                Content="Vincular ao Jira…"
                IsVisible="{Binding CanLink}"
                Command="{Binding StartLinkingCommand}" />

        <!-- A busca do vínculo: a mesma do autocomplete da captura. -->
        <Border Classes="issueCard" IsVisible="{Binding IsLinking}">
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox x:Name="IssueSearchBox"
                       PlaceholderText="Parte do título ou a chave da issue (GAECO-1234)"
                       Text="{Binding SearchText}" />
              <Button Grid.Column="1" Content="Cancelar" Command="{Binding CancelLinkingCommand}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Suggestions.Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:IssueSuggestionViewModel">
                  <Border Classes="issueSuggestion"
                          Classes.selected="{Binding IsSelected}"
                          Cursor="Hand"
                          PointerPressed="OnIssueSuggestionPressed">
                    <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto">
                      <Border Classes="issueType"
                              Classes.bug="{Binding IsBug}"
                              Classes.story="{Binding IsStory}"
                              Classes.task="{Binding IsTask}">
                        <TextBlock Text="{Binding TypeLabel}" />
                      </Border>
                      <TextBlock Grid.Column="1" Classes="suggestionKey" Text="{Binding Key}" />
                      <TextBlock Grid.Column="2" Classes="issueStatus" Text="{Binding Status}" IsVisible="{Binding HasStatus}" />
                      <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Classes="suggestionTitle" Text="{Binding Title}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="issueMeta" Text="Buscando no Jira…" IsVisible="{Binding Suggestions.IsLoading}" />
            <TextBlock Classes="issueMeta"
                       Text="{Binding Suggestions.Notice}"
                       IsVisible="{Binding Suggestions.Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Border>

        <TextBlock Classes="issueMeta"
                   Foreground="{DynamicResource WidgetDangerBrush}"
                   Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Classes="issueMeta"
                   Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <!--
      O prazo (ADR-050): até quando, quanto falta, os avisos desta tarefa e a
      próxima ação. Sem prazo é uma linha só — a tarefa de cinco minutos não
      ganha formulário. Grava cada coisa na hora, como o card do Jira.
    -->
    <ContentControl DockPanel.Dock="Top"
                    x:Name="DeadlineSection"
                    Margin="24,0,24,10"
                    Content="{Binding Deadline}"
                    IsVisible="{Binding Deadline, Converter={x:Static ObjectConverters.IsNotNull}}">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="vm:TaskDeadlineViewModel">
          <Border Classes="issueCard deadlineCard">
            <StackPanel Spacing="8">

              <!-- A linha do prazo: data, quanto falta, e as duas ações. -->
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Classes="deadlineGlyph" Text="&#xE823;" />
                <StackPanel Grid.Column="1"
                            Classes="deadlineSummary"
                            Classes.attention="{Binding IsAttention}"
                            Classes.urgent="{Binding IsUrgent}"
                            Classes.overdue="{Binding IsOverdue}"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                  <TextBlock Classes="deadlineDate"
                             Text="{Binding DateLabel}"
                             IsVisible="{Binding HasDeadline}" />
                  <TextBlock Classes="deadlineCountdown"
                             Text="{Binding Countdown, StringFormat='· {0}'}"
                             IsVisible="{Binding HasDeadline}" />
                  <TextBlock Classes="issueMeta"
                             Text="Sem prazo"
                             IsVisible="{Binding !HasDeadline}" />
                </StackPanel>
                <Button Grid.Column="2"
                        Classes="small"
                        Content="{Binding EditLabel}"
                        IsVisible="{Binding IsEditable}"
                        Command="{Binding ToggleEditingCommand}" />
                <Button Grid.Column="3"
                        Classes="small"
                        Content="Remover"
                        ToolTip.Tip="Remover o prazo desta tarefa"
                        IsVisible="{Binding HasDeadline}"
                        IsEnabled="{Binding IsEditable}"
                        Command="{Binding ClearCommand}" />
              </Grid>

              <!-- Escolher: os atalhos de um clique e, abaixo, dia e hora. -->
              <StackPanel Spacing="8" IsVisible="{Binding IsEditing}">
                <WrapPanel>
                  <Button Classes="small chip" Content="Hoje" Command="{Binding UseShortcutCommand}" CommandParameter="Today" />
                  <Button Classes="small chip" Content="Amanhã" Command="{Binding UseShortcutCommand}" CommandParameter="Tomorrow" />
                  <Button Classes="small chip" Content="Final da semana" Command="{Binding UseShortcutCommand}" CommandParameter="EndOfWeek" />
                  <Button Classes="small chip" Content="Próxima semana" Command="{Binding UseShortcutCommand}" CommandParameter="NextWeek" />
                  <Button Classes="small chip" Content="+3 dias" Command="{Binding UseShortcutCommand}" CommandParameter="InThreeDays" />
                  <Button Classes="small chip" Content="+1 semana" Command="{Binding UseShortcutCommand}" CommandParameter="InOneWeek" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CalendarDatePicker SelectedDate="{Binding CustomDate}"
                                      PlaceholderText="Dia"
                                      Width="150" />
                  <TimePicker SelectedTime="{Binding CustomTime}"
                              ClockIdentifier="24HourClock"
                              MinuteIncrement="5" />
                  <Button Classes="accent small"
                          Content="Aplicar"
                          Command="{Binding ApplyCustomCommand}" />
                </StackPanel>
              </StackPanel>

              <!-- §14 e §15: o próximo passo e quanto deve dar. Opcionais. -->
              <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding ShowsPlan}">
                <TextBlock Grid.Column="0" Classes="planLabel" Text="Próxima ação" />
                <TextBox Grid.Column="1"
                         Classes="plan"
                         Text="{Binding NextAction}"
                         PlaceholderText="ex.: criar endpoint POST /diets"
                         MaxLength="200"
                         IsReadOnly="{Binding IsReadOnly}" />
                <TextBlock Grid.Column="2" Classes="planLabel" Text="Estimativa" />
                <NumericUpDown Grid.Column="3"
                               Classes="plan"
                               Value="{Binding EstimateHours}"
                               ShowButtonSpinner="False"
                               Minimum="0"
                               Maximum="999"
                               Increment="0.5"
                               FormatString="0.#"
                               Width="64"
                               IsReadOnly="{Binding IsReadOnly}"
                               ToolTip.Tip="Estimativa de trabalho, em horas" />
                <TextBlock Grid.Column="4" Classes="planLabel" Text="h" />
                <Button Grid.Column="5"
                        Classes="small"
                        Content="Salvar"
                        IsVisible="{Binding HasPlanChanges}"
                        Command="{Binding SavePlanCommand}" />
              </Grid>

              <!-- ADR-052: quanto da estimativa já foi; o detalhe está na aba Tempo. -->
              <TextBlock x:Name="SpentLine"
                         Classes="issueMeta"
                         Text="{Binding SpentLabel}"
                         IsVisible="{Binding HasSpent}" />

              <!-- §20: os avisos desta tarefa. Padrão segue a configuração. -->
              <StackPanel Spacing="6" IsVisible="{Binding HasDeadline}" IsEnabled="{Binding IsEditable}">
                <WrapPanel>
                  <TextBlock Classes="issueMeta" Text="Avisos:" Margin="0,0,8,0" VerticalAlignment="Center" />
                  <RadioButton GroupName="DeadlineAlerts"
                               Content="Padrão"
                               IsChecked="{Binding IsDefaultAlerts}" />
                  <RadioButton GroupName="DeadlineAlerts"
                               Content="Silencioso"
                               IsChecked="{Binding IsSilentAlerts}" />
                  <RadioButton GroupName="DeadlineAlerts"
                               Content="Só na véspera"
                               IsChecked="{Binding IsDayBeforeAlerts}" />
                  <RadioButton GroupName="DeadlineAlerts"
                               Content="Personalizado"
                               IsChecked="{Binding IsCustomAlerts}" />
                </WrapPanel>
                <WrapPanel IsVisible="{Binding IsCustomAlerts}">
                  <CheckBox Content="7 dias" IsChecked="{Binding AlertSevenDays}" />
                  <CheckBox Content="3 dias" IsChecked="{Binding AlertThreeDays}" />
                  <CheckBox Content="24 h" IsChecked="{Binding AlertOneDay}" />
                  <CheckBox Content="8 h" IsChecked="{Binding AlertEightHours}" />
                  <CheckBox Content="2 h" IsChecked="{Binding AlertTwoHours}" />
                  <CheckBox Content="Atrasada" IsChecked="{Binding AlertOverdue}" />
                </WrapPanel>
              </StackPanel>

              <TextBlock Classes="issueMeta"
                         Foreground="{DynamicResource WidgetDangerBrush}"
                         Text="{Binding ErrorMessage}"
                         TextWrapping="Wrap"
                         IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <!-- Rodapé: o que foi escrito à esquerda, o que fazer com isso à direita. -->
    <Border DockPanel.Dock="Bottom" Padding="24,12,24,18" IsVisible="{Binding IsNotesTab}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">

        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">

          <TextBlock Classes="footNote"
                     Text="{Binding CountLabel}"
                     IsVisible="{Binding IsEditable}" />

          <TextBlock Classes="footNote"
                     Text="&#x2022; alterações não salvas"
                     IsVisible="{Binding HasUnsavedChanges}" />

        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">

          <Button Content="Fechar"
                  Command="{Binding CancelCommand}"
                  IsVisible="{Binding IsReadOnly}" />

          <Button Content="{Binding DismissLabel}"
                  Command="{Binding CancelCommand}"
                  IsVisible="{Binding IsEditable}" />

          <Button Classes="accent"
                  Content="Salvar"
                  Command="{Binding SaveCommand}"
                  IsVisible="{Binding IsEditable}" />

        </StackPanel>

      </Grid>
    </Border>

    <!-- Erro do domínio ou do banco: entre o rodapé e o texto, onde se lê. -->
    <Border DockPanel.Dock="Bottom"
            Margin="24,0,24,0"
            Padding="12,8"
            CornerRadius="{StaticResource WidgetPillRadius}"
            Background="{DynamicResource WidgetDangerSoftBrush}"
            IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding ErrorMessage}"
                 FontSize="11.5"
                 Foreground="{DynamicResource WidgetDangerBrush}"
                 TextWrapping="Wrap" />
    </Border>

    <!--
      Duas abas (ADR-027). O cabeçalho fica fora delas: o título é o assunto
      das duas. O rodapé de salvar é só da anotação — a aba Desenvolvimento
      grava cada coisa quando acontece, e um "Salvar" ali não salvaria nada.
    -->
    <TabControl Classes="taskTabs"
                x:Name="Tabs"
                Margin="24,0,24,0"
                SelectedIndex="{Binding SelectedTabIndex}">

      <TabItem x:Name="NotesTabItem" Header="{Binding NotesTabHeader}">
        <DockPanel Margin="0,10,0,0">

          <!--
            Barra de formatação: some inteira no modo leitura, e não fica apagada.
            Os botões de formatar somem também quando só a pré-visualização está
            à vista — não há seleção para formatar.
          -->
          <Grid DockPanel.Dock="Top"
                Margin="0,0,0,10"
                ColumnDefinitions="*,Auto"
                IsVisible="{Binding IsEditable}">

            <Border Grid.Column="0"
                    Padding="4"
                    CornerRadius="{StaticResource WidgetPillRadius}"
                    Background="{DynamicResource WidgetSurfaceBrush}"
                    HorizontalAlignment="Left"
                    IsVisible="{Binding ShowsEditor}">
              <StackPanel Orientation="Horizontal" Spacing="1">

                <Button Classes="tool bold" Content="B" Tag="Bold"
                        Click="OnFormatClick" ToolTip.Tip="Negrito (Ctrl+B)" />
                <Button Classes="tool italic" Content="I" Tag="Italic"
                        Click="OnFormatClick" ToolTip.Tip="Itálico (Ctrl+I)" />
                <Button Classes="tool underline" Content="U" Tag="Underline"
                        Click="OnFormatClick" ToolTip.Tip="Sublinhado (Ctrl+U)" />
                <Button Classes="tool strike" Content="S" Tag="Strikethrough"
                        Click="OnFormatClick" ToolTip.Tip="Tachado" />

                <Border Classes="toolDivider" />

                <Button Classes="tool" Content="H1" Tag="Heading1"
                        Click="OnFormatClick" ToolTip.Tip="Título" />
                <Button Classes="tool" Content="H2" Tag="Heading2"
                        Click="OnFormatClick" ToolTip.Tip="Subtítulo" />

                <Border Classes="toolDivider" />

                <Button Classes="tool" Content="&#x2022;" Tag="Bullet"
                        Click="OnFormatClick" ToolTip.Tip="Lista com marcadores" />
                <Button Classes="tool" Content="1." Tag="Numbered"
                        Click="OnFormatClick" ToolTip.Tip="Lista numerada" />

              </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Padding="4"
                    CornerRadius="{StaticResource WidgetPillRadius}"
                    Background="{DynamicResource WidgetSurfaceBrush}">
              <StackPanel Orientation="Horizontal" Spacing="1">
                <Button Classes="mode" Classes.active="{Binding IsWriteMode}"
                        x:Name="WriteModeButton"
                        Content="Escrever"
                        Command="{Binding SetViewModeCommand}"
                        CommandParameter="{x:Static vm:NotesViewMode.Write}"
                        ToolTip.Tip="Só o texto em Markdown (Ctrl+Shift+V alterna)" />
                <Button Classes="mode" Classes.active="{Binding IsPreviewMode}"
                        x:Name="PreviewModeButton"
                        Content="Visualizar"
                        Command="{Binding SetViewModeCommand}"
                        CommandParameter="{x:Static vm:NotesViewMode.Preview}"
                        ToolTip.Tip="Como a anotação fica formatada (Ctrl+Shift+V alterna)" />
                <Button Classes="mode" Classes.active="{Binding IsSplitMode}"
                        x:Name="SplitModeButton"
                        Content="Lado a lado"
                        Command="{Binding SetViewModeCommand}"
                        CommandParameter="{x:Static vm:NotesViewMode.Split}"
                        ToolTip.Tip="Escrever vendo o resultado formatado" />
              </StackPanel>
            </Border>

          </Grid>

          <!--
            Editor e pré-visualização numa grade de uma linha: o que estiver
            escondido não ocupa coluna, então cada modo usa a largura inteira, e
            lado a lado ela se divide ao meio.
          -->
          <UniformGrid Rows="1" Margin="0,0,0,10">

            <Border Classes="sheet" IsVisible="{Binding ShowsEditor}">
              <Panel>

                <TextBox x:Name="Editor"
                         spell:SpellCheck.IsEnabled="True"
                         IsVisible="{Binding IsEditable}"
                         Text="{Binding Text}"
                         AcceptsReturn="True"
                         AcceptsTab="False"
                         TextWrapping="Wrap"
                         FontSize="13.5"
                         LineHeight="21"
                         Padding="0"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalAlignment="Stretch"
                         VerticalContentAlignment="Top"
                         PlaceholderText="Escreva o que mais importa sobre esta tarefa… (@ insere o caminho de um diretório da etiqueta)" />

                <!--
                  O "@" abre, o texto filtra, ↑/↓ andam, Enter/Tab ou o clique inserem o
                  path real. O PlacementRect é o cursor, calculado no code-behind.
                -->
                <Popup x:Name="AliasPopup"
                       PlacementTarget="{Binding #Editor}"
                       Placement="Bottom"
                       IsLightDismissEnabled="True"
                       IsOpen="{Binding Completion.IsCompletionOpen, Mode=TwoWay}">
                  <Border Classes="aliasList">
                    <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl x:Name="AliasList"
                                    ItemsSource="{Binding Completion.Suggestions}"
                                    ItemTemplate="{StaticResource AliasSuggestionTemplate}" />
                    </ScrollViewer>
                  </Border>
                </Popup>

              </Panel>
            </Border>

            <!--
              Um leitor só, para a tarefa concluída e para a pré-visualização: são
              a mesma coisa, e dois desenhariam a mesma anotação de dois jeitos.
            -->
            <Border Classes="sheet"
                    Classes.split="{Binding IsSplit}"
                    IsVisible="{Binding ShowsPreview}">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <notes:MarkdownView x:Name="Preview"
                                    Text="{Binding Text}"
                                    Placeholder="{Binding PreviewPlaceholder}"
                                    Foreground="{DynamicResource WidgetTextHighBrush}"
                                    LinkForeground="{DynamicResource WidgetInfoBrush}"
                                    AccentBrush="{DynamicResource WidgetAccentBrush}"
                                    OnAccentBrush="{DynamicResource WidgetOnAccentBrush}" />
              </ScrollViewer>
            </Border>

          </UniformGrid>

        </DockPanel>
      </TabItem>

      <TabItem x:Name="DevelopmentTabItem" Header="Desenvolvimento">
        <!--
          A aba Desenvolvimento (ADR-027). Em cima, um repositório por aba
          (ADR-031); embaixo, o painel do escolhido. O DataContext do painel é o
          ViewModel do ambiente, e ele tem nome para os itens das listas
          chegarem aos comandos dele.
        -->
        <ScrollViewer x:Name="DevelopmentScroll"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,10,0,10">
          <StackPanel Spacing="4">

          <DockPanel x:Name="RepositoryStrip"
                     x:DataType="vm:TaskDevelopmentsViewModel"
                     DataContext="{Binding Developments}"
                     IsVisible="{Binding ShowStrip}">
            <Button x:Name="AddRepositoryButton"
                    DockPanel.Dock="Right"
                    VerticalAlignment="Top"
                    Content="+ Adicionar repositório"
                    ToolTip.Tip="Mais um ambiente desta tarefa, em outro repositório — o fluxo que atravessa repositórios."
                    Command="{Binding AddRepositoryCommand}"
                    IsVisible="{Binding CanAddRepository}" />

            <ListBox x:Name="RepositoryList"
                     Classes="repoStrip"
                     ItemsSource="{Binding Items}"
                     SelectedItem="{Binding Selected}"
                     SelectionMode="Single,AlwaysSelected">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:TaskDevelopmentViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="6"
                              ToolTip.Tip="{Binding ChipTip}">
                    <TextBlock Classes="chipMeta" Text="{Binding ChipGlyph}" />
                    <TextBlock Classes="chipTitle" Text="{Binding ChipTitle}" />
                    <TextBlock Classes="chipMeta" Text="·"
                               IsVisible="{Binding ChipBranch, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Classes="chipMeta" Text="{Binding ChipBranch}" />
                    <TextBlock Classes="chipAgent" Text="●"
                               ToolTip.Tip="Agente de IA aberto neste repositório"
                               IsVisible="{Binding HasRunningAgent}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <StackPanel x:Name="DevelopmentPanel"
                      x:DataType="vm:TaskDevelopmentViewModel"
                      DataContext="{Binding Developments.Selected}"
                      Spacing="12">

            <TextBlock Classes="hint"
                       Text="Prepare um worktree Git para implementar esta tarefa: uma branch nova, numa pasta ao lado do repositório."
                       IsVisible="{Binding !IsReady}" />

            <TextBlock Classes="hint" Text="Carregando…" IsVisible="{Binding IsLoading}" />

            <!-- Git -->
            <Border Classes="card" x:Name="GitCard" IsVisible="{Binding !IsReady}">
              <StackPanel Spacing="8">

                <TextBlock Classes="sectionTitle" Text="Git" />

                <TextBlock Classes="body"
                           Classes.ok="{Binding Git.IsInstalled, FallbackValue=False}"
                           Classes.bad="{Binding IsGitMissing}"
                           Text="{Binding GitStatusText}" />

                <StackPanel Spacing="10" IsVisible="{Binding IsGitMissing}" x:Name="GitMissingPanel">

                  <TextBlock Classes="body"
                             Text="Para utilizar a integração de desenvolvimento, instale o Git e depois clique em &quot;Verificar novamente&quot;. O MyTaskApp não instala nada sozinho." />

                  <TextBlock Classes="fieldLabel" Text="{Binding Instructions.SystemName}" />
                  <TextBlock Classes="hint" Text="{Binding Instructions.Explanation}" />

                  <ItemsControl ItemsSource="{Binding Instructions.Commands}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="dev:InstallCommand">
                        <StackPanel Spacing="3">
                          <TextBlock Classes="hint" Text="{Binding Label}" />
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Border Grid.Column="0" Classes="codeBox">
                              <SelectableTextBlock Classes="code installCommand" Text="{Binding Command}" />
                            </Border>
                            <Button Grid.Column="1"
                                    Classes="copyCommand"
                                    Content="Copiar comando"
                                    VerticalAlignment="Center"
                                    Command="{Binding #DevelopmentPanel.((vm:TaskDevelopmentViewModel)DataContext).CopyCommand}"
                                    CommandParameter="{Binding Command}" />
                          </Grid>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <StackPanel Spacing="3">
                    <TextBlock Classes="hint" Text="{Binding Instructions.Verify.Label}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <Border Grid.Column="0" Classes="codeBox">
                        <SelectableTextBlock Classes="code" Text="{Binding Instructions.Verify.Command}" />
                      </Border>
                      <Button Grid.Column="1"
                              Content="Copiar comando"
                              VerticalAlignment="Center"
                              Command="{Binding CopyCommand}"
                              CommandParameter="{Binding Instructions.Verify.Command}" />
                    </Grid>
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Como instalar o Git" Command="{Binding OpenInstallPageCommand}" />
                    <Button Classes="accent"
                            x:Name="RecheckGitButton"
                            Content="Verificar novamente"
                            Command="{Binding RecheckGitCommand}" />
                  </StackPanel>

                </StackPanel>

              </StackPanel>
            </Border>

            <!-- A tentativa anterior: falhou, foi interrompida ou removida. -->
            <Border Classes="card caution" IsVisible="{Binding HasPreviousAttempt}">
              <DockPanel>
                <!-- Sem worktree, o ambiente pode sair das abas da tarefa (ADR-031). -->
                <Button x:Name="ForgetButton"
                        DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        Content="Remover da lista"
                        Command="{Binding ForgetCommand}"
                        IsVisible="{Binding CanForget}" />
                <TextBlock Classes="body" Text="{Binding PreviousAttempt}" />
              </DockPanel>
            </Border>

            <!-- Formulário -->
            <Border Classes="card" x:Name="SetupCard" IsVisible="{Binding ShowForm}">
              <StackPanel Spacing="14">

                <TextBlock Classes="sectionTitle" Text="Desenvolvimento" />

                <StackPanel Spacing="4">
                  <TextBlock Classes="fieldLabel" Text="Diretório" />
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                    <TextBox Grid.Column="0"
                             x:Name="DirectoryBox"
                             Text="{Binding DirectoryText}"
                             IsEnabled="{Binding IsFormEnabled}"
                             PlaceholderText="@alias de uma etiqueta ou o caminho do repositório" />
                    <Button Grid.Column="1"
                            x:Name="DirectoryAliasesButton"
                            Content="@"
                            ToolTip.Tip="Diretórios das etiquetas desta tarefa"
                            IsEnabled="{Binding IsFormEnabled}"
                            Click="OnDirectoryAliasesClick" />
                    <Button Grid.Column="2"
                            Content="Procurar…"
                            IsEnabled="{Binding IsFormEnabled}"
                            Click="OnBrowseDirectoryClick" />
                  </Grid>

                  <!-- O mesmo autocomplete da anotação: o "@alias" vira o caminho. -->
                  <Popup x:Name="DirectoryPopup"
                         PlacementTarget="{Binding #DirectoryBox}"
                         Placement="Bottom"
                         IsLightDismissEnabled="True"
                         IsOpen="{Binding DirectoryCompletion.IsCompletionOpen, Mode=TwoWay}">
                    <Border Classes="aliasList">
                      <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="DirectoryAliasList"
                                      ItemsSource="{Binding DirectoryCompletion.Suggestions}"
                                      ItemTemplate="{StaticResource AliasSuggestionTemplate}" />
                      </ScrollViewer>
                    </Border>
                  </Popup>

                  <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock Classes="hint" Text="Conferindo…" IsVisible="{Binding IsInspecting}" />
                    <TextBlock Classes="hint"
                               x:Name="DirectoryStatus"
                               Classes.ok="{Binding DirectoryFound}"
                               Classes.bad="{Binding !DirectoryFound}"
                               Text="{Binding DirectoryStatusText}"
                               IsVisible="{Binding HasDirectoryStatus}" />
                    <TextBlock Classes="hint"
                               x:Name="RepositoryStatus"
                               Classes.ok="{Binding RepositoryValid}"
                               Classes.bad="{Binding !RepositoryValid}"
                               Text="{Binding RepositoryStatusText}"
                               IsVisible="{Binding HasRepositoryStatus}" />
                  </StackPanel>
                </StackPanel>

                <StackPanel Spacing="4">
                  <TextBlock Classes="fieldLabel" Text="Branch de origem" />
                  <ComboBox x:Name="SourceBranchBox"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding BranchOptions}"
                            SelectedItem="{Binding SelectedBranchOption}"
                            IsEnabled="{Binding IsFormEnabled}"
                            PlaceholderText="Escolha a branch de onde a tarefa parte">
                    <ComboBox.Styles>
                      <!-- Cabeçalho de grupo não é escolha. -->
                      <Style Selector="ComboBoxItem" x:DataType="vm:BranchOptionViewModel">
                        <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                      </Style>
                    </ComboBox.Styles>
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:BranchOptionViewModel">
                        <TextBlock Text="{Binding Label}"
                                   Classes.branchHeader="{Binding IsHeader}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Classes="hint" Text="Carregando branches…" IsVisible="{Binding IsLoadingBranches}" />
                  <TextBlock Classes="hint bad"
                             Text="{Binding BranchesError}"
                             IsVisible="{Binding BranchesError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Classes="hint"
                             Text="{Binding BranchesNotice}"
                             IsVisible="{Binding BranchesNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

                <!-- Opcional (ADR-043): a branch nova parte de uma versão, e não da ponta. -->
                <StackPanel Spacing="4" IsVisible="{Binding HasTags}">
                  <TextBlock Classes="fieldLabel" Text="Tag (opcional)" />
                  <ComboBox x:Name="SourceTagBox"
                            HorizontalAlignment="Stretch"
                            MaxDropDownHeight="320"
                            ItemsSource="{Binding TagOptions}"
                            SelectedItem="{Binding SelectedTagOption}"
                            IsEnabled="{Binding IsFormEnabled}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:GitTagOptionViewModel">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Classes="hint"
                             x:Name="SourceTagHint"
                             Text="{Binding TagHint}"
                             IsVisible="{Binding HasSelectedTag}" />
                </StackPanel>

                <StackPanel Spacing="4">
                  <TextBlock Classes="fieldLabel" Text="Nova branch" />
                  <TextBox x:Name="NewBranchBox"
                           Text="{Binding NewBranchName}"
                           IsEnabled="{Binding IsFormEnabled}"
                           PlaceholderText="feature/nome-da-tarefa" />
                  <TextBlock Classes="hint bad"
                             x:Name="BranchNameError"
                             Text="{Binding BranchNameError}"
                             IsVisible="{Binding HasBranchNameError}" />
                  <!-- Já existe: a criação usa a existente, e nunca duplica (ADR-045). -->
                  <TextBlock Classes="hint"
                             x:Name="ExistingBranchNotice"
                             Text="{Binding ExistingBranchNotice}"
                             IsVisible="{Binding ExistingBranchNotice, Converter={x:Static ObjectConverters.IsNotNull}}" />

                  <!-- ADR-047: a branch existente já tem PR aberta? O link leva até ela. -->
                  <TextBlock Classes="hint" Text="Conferindo PR…" IsVisible="{Binding IsCheckingPullRequest}" />
                  <StackPanel x:Name="PullRequestRow"
                              Orientation="Horizontal"
                              Spacing="8"
                              IsVisible="{Binding HasPullRequest}">
                    <Button x:Name="PullRequestLink"
                            Classes="issueKey prLink"
                            Content="{Binding PullRequest.Label, StringFormat='{}{0} ↗', FallbackValue=''}"
                            ToolTip.Tip="{Binding PullRequestTip}"
                            Command="{Binding OpenPullRequestCommand}" />
                    <TextBlock Classes="hint"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding PullRequest.Title, FallbackValue=''}" />
                  </StackPanel>

                  <!-- Sem resposta do GitHub: dizer, para "sem link" não parecer "sem PR". -->
                  <StackPanel x:Name="PullRequestUnavailable"
                              Orientation="Horizontal"
                              Spacing="8"
                              IsVisible="{Binding IsPullRequestUnavailable}">
                    <TextBlock Classes="hint"
                               VerticalAlignment="Center"
                               Text="Não foi possível consultar o GitHub para ver se a branch tem PR aberta." />
                    <Button x:Name="RetryPullRequestButton"
                            Content="Tentar de novo"
                            VerticalAlignment="Center"
                            Command="{Binding RecheckGhCommand}" />
                  </StackPanel>

                  <!-- Repositório do GitHub sem o gh pronto: o tutorial, fechado até alguém pedir. -->
                  <StackPanel x:Name="GhGuideHint" Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowGhGuide}">
                    <TextBlock Classes="hint"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="420"
                               Text="{Binding GhGuideHint}" />
                    <Button x:Name="ToggleGhGuideButton"
                            Content="Como instalar o gh"
                            VerticalAlignment="Center"
                            Command="{Binding ToggleGhGuideCommand}" />
                  </StackPanel>

                  <Border Classes="codeBox" x:Name="GhGuidePanel">
                    <Border.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="ShowGhGuide" />
                        <Binding Path="IsGhGuideOpen" />
                      </MultiBinding>
                    </Border.IsVisible>
                    <StackPanel Spacing="10">
                      <TextBlock Classes="fieldLabel" Text="GitHub CLI (gh)" />
                      <TextBlock Classes="hint"
                                 TextWrapping="Wrap"
                                 Text="O MyTaskApp pergunta ao GitHub pelo gh, com a sua conta, se a branch já tem PR aberta. Nenhum token é guardado no app, e o app não instala nada sozinho." />

                      <StackPanel Spacing="8" IsVisible="{Binding IsGhMissing}">
                        <TextBlock Classes="fieldLabel" Text="{Binding GhInstructions.SystemName}" />
                        <TextBlock Classes="hint" TextWrapping="Wrap" Text="{Binding GhInstructions.Explanation}" />
                        <ItemsControl x:Name="GhInstallCommands" ItemsSource="{Binding GhInstructions.Commands}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dev:InstallCommand">
                              <StackPanel Spacing="3">
                                <TextBlock Classes="hint" Text="{Binding Label}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                  <Border Grid.Column="0" Classes="codeBox">
                                    <SelectableTextBlock Classes="code installCommand" Text="{Binding Command}" />
                                  </Border>
                                  <Button Grid.Column="1"
                                          Classes="copyCommand"
                                          Content="Copiar comando"
                                          VerticalAlignment="Center"
                                          Command="{Binding #DevelopmentPanel.((vm:TaskDevelopmentViewModel)DataContext).CopyCommand}"
                                          CommandParameter="{Binding Command}" />
                                </Grid>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>

                      <StackPanel Spacing="3">
                        <TextBlock Classes="hint" Text="{Binding GhInstructions.Login.Label}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <Border Grid.Column="0" Classes="codeBox">
                            <SelectableTextBlock Classes="code" x:Name="GhLoginCommand" Text="{Binding GhInstructions.Login.Command}" />
                          </Border>
                          <Button Grid.Column="1"
                                  Content="Copiar comando"
                                  VerticalAlignment="Center"
                                  Command="{Binding CopyCommand}"
                                  CommandParameter="{Binding GhInstructions.Login.Command}" />
                        </Grid>
                      </StackPanel>

                      <StackPanel Spacing="3">
                        <TextBlock Classes="hint" Text="{Binding GhInstructions.Verify.Label}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <Border Grid.Column="0" Classes="codeBox">
                            <SelectableTextBlock Classes="code" Text="{Binding GhInstructions.Verify.Command}" />
                          </Border>
                          <Button Grid.Column="1"
                                  Content="Copiar comando"
                                  VerticalAlignment="Center"
                                  Command="{Binding CopyCommand}"
                                  CommandParameter="{Binding GhInstructions.Verify.Command}" />
                        </Grid>
                      </StackPanel>

                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Site oficial (cli.github.com)" Command="{Binding OpenGhInstallPageCommand}" />
                        <Button Classes="accent"
                                x:Name="RecheckGhButton"
                                Content="Verificar novamente"
                                Command="{Binding RecheckGhCommand}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <StackPanel Spacing="4">
                  <TextBlock Classes="fieldLabel" Text="Worktree" />
                  <SelectableTextBlock Classes="code"
                                       x:Name="WorktreePreview"
                                       Text="{Binding WorktreePreview, FallbackValue='—', TargetNullValue='—'}" />
                </StackPanel>

                <!-- Comandos pós-Worktree (ADR-028): gravados junto, rodam depois de criar. -->
                <StackPanel Spacing="6">
                  <views:PostWorktreeCommandsView x:Name="SetupCommands" DataContext="{Binding Commands}" />
                  <Button HorizontalAlignment="Left"
                          Content="Gerenciar comandos globais…"
                          Command="{Binding OpenGlobalCommandsCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Button Content="Cancelar"
                          Command="{Binding CancelRunCommand}"
                          IsVisible="{Binding IsRunning}" />
                  <Button Classes="accent"
                          x:Name="StartButton"
                          Content="Iniciar implementação"
                          Command="{Binding StartCommand}" />
                </StackPanel>

              </StackPanel>
            </Border>

            <!-- Progresso -->
            <Border Classes="card" x:Name="StepsCard" IsVisible="{Binding ShowSteps}">
              <StackPanel Spacing="8">
                <TextBlock Classes="sectionTitle" Text="Preparando ambiente…" />
                <ItemsControl ItemsSource="{Binding Steps}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DevelopmentStepViewModel">
                      <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0"
                                   Classes="stepGlyph"
                                   Classes.done="{Binding IsDone}"
                                   Classes.running="{Binding IsRunning}"
                                   Classes.warning="{Binding IsWarning}"
                                   Classes.failed="{Binding IsFailed}"
                                   Text="{Binding Glyph}" />
                        <StackPanel Grid.Column="1" Spacing="1">
                          <TextBlock Classes="stepTitle"
                                     Classes.pending="{Binding IsPending}"
                                     Text="{Binding Title}" />
                          <TextBlock Classes="hint"
                                     Text="{Binding Note}"
                                     IsVisible="{Binding HasNote}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- A pasta do worktree já existe -->
            <Border Classes="card caution" x:Name="ConflictCard" IsVisible="{Binding IsConflict}">
              <StackPanel Spacing="10">
                <TextBlock Classes="body" Text="{Binding ConflictMessage}" />
                <TextBlock Classes="hint"
                           Text="Nada foi sobrescrito nem apagado. Escolha como seguir." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{Binding AdoptLabel}"
                          Command="{Binding UseExistingCommand}"
                          IsVisible="{Binding CanAdopt}" />
                  <Button Content="Escolher outro caminho" Command="{Binding ChooseAnotherPathCommand}" />
                  <Button Content="Cancelar" Command="{Binding CancelConflictCommand}" />
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" IsVisible="{Binding IsChoosingAlternative}">
                  <TextBox Grid.Column="0" x:Name="AlternativePathBox" Text="{Binding AlternativePath}" />
                  <Button Grid.Column="1" Content="Procurar…" Click="OnBrowseAlternativeClick" />
                  <Button Grid.Column="2"
                          Classes="accent"
                          Content="Criar aqui"
                          Command="{Binding UseAlternativePathCommand}" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- Falha -->
            <Border Classes="card danger" x:Name="FailureCard" IsVisible="{Binding ShowFailure}">
              <StackPanel Spacing="8">
                <TextBlock Classes="sectionTitle bad" Text="Não foi possível criar o ambiente de desenvolvimento." />

                <TextBlock Classes="fieldLabel" Text="Etapa" />
                <TextBlock Classes="body" Text="{Binding Failure.StepTitle, FallbackValue=''}" />

                <TextBlock Classes="fieldLabel" Text="Motivo" />
                <TextBlock Classes="body" x:Name="FailureReason" Text="{Binding Failure.Reason, FallbackValue=''}" />

                <StackPanel Spacing="6" IsVisible="{Binding Failure.HasChanges, FallbackValue=False}">
                  <TextBlock Classes="fieldLabel" Text="Repositório" />
                  <SelectableTextBlock Classes="code" Text="{Binding RepositoryPath}" />
                  <TextBlock Classes="fieldLabel" Text="Alterações locais" />
                  <Border Classes="codeBox">
                    <SelectableTextBlock Classes="code" Text="{Binding Failure.ChangesText, FallbackValue=''}" />
                  </Border>
                  <Button Content="Abrir terminal no repositório" Command="{Binding OpenRepositoryTerminalCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Failure.HasCommand, FallbackValue=False}">
                  <ToggleButton x:Name="DetailsToggle"
                                Content="Ver detalhes"
                                IsChecked="{Binding IsDetailsOpen}" />
                  <Button Content="Copiar detalhes" Command="{Binding CopyFailureDetailsCommand}" />
                </StackPanel>

                <StackPanel x:Name="FailureDetails" Spacing="4" IsVisible="{Binding IsDetailsOpen}">
                  <TextBlock Classes="fieldLabel" Text="Command" />
                  <Border Classes="codeBox">
                    <SelectableTextBlock Classes="code" Text="{Binding Failure.CommandLine, FallbackValue=''}" />
                  </Border>
                  <TextBlock Classes="fieldLabel" Text="Exit Code" />
                  <Border Classes="codeBox">
                    <SelectableTextBlock Classes="code" Text="{Binding Failure.ExitCode, FallbackValue=''}" />
                  </Border>
                  <TextBlock Classes="fieldLabel" Text="Standard Output" />
                  <Border Classes="codeBox">
                    <SelectableTextBlock Classes="code" Text="{Binding Failure.StandardOutput, FallbackValue=''}" />
                  </Border>
                  <TextBlock Classes="fieldLabel" Text="Standard Error" />
                  <Border Classes="codeBox">
                    <SelectableTextBlock Classes="code" x:Name="StandardErrorText" Text="{Binding Failure.StandardError, FallbackValue=''}" />
                  </Border>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Pronto -->
            <Border Classes="card" x:Name="ReadyCard" IsVisible="{Binding IsReady}">
              <StackPanel Spacing="10">
                <TextBlock Classes="sectionTitle" Text="Desenvolvimento" />

                <TextBlock Classes="fieldLabel" Text="Status" />
                <TextBlock Classes="body ok" Text="✓ Ambiente pronto" />

                <TextBlock Classes="fieldLabel" Text="Repositório" />
                <SelectableTextBlock Classes="code" Text="{Binding Development.RepositoryPath, FallbackValue=''}" />

                <TextBlock Classes="fieldLabel" Text="Branch de origem" />
                <SelectableTextBlock Classes="code" Text="{Binding Development.SourceBranch, FallbackValue=''}" />

                <TextBlock Classes="fieldLabel" Text="Tag de origem" IsVisible="{Binding Development.HasSourceTag, FallbackValue=False}" />
                <SelectableTextBlock Classes="code"
                                     x:Name="ReadySourceTag"
                                     Text="{Binding Development.SourceTag, FallbackValue=''}"
                                     IsVisible="{Binding Development.HasSourceTag, FallbackValue=False}" />

                <TextBlock Classes="fieldLabel" Text="Branch da tarefa" />
                <SelectableTextBlock Classes="code" Text="{Binding Development.Branch, FallbackValue=''}" />

                <TextBlock Classes="fieldLabel" Text="Worktree" />
                <SelectableTextBlock Classes="code" x:Name="ReadyWorktree" Text="{Binding Development.WorktreePath, FallbackValue=''}" />

                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                  <Button Classes="accent" Content="Abrir diretório" Command="{Binding OpenFolderCommand}" />
                  <Button Content="Abrir terminal" Command="{Binding OpenTerminalCommand}" />
                  <Button Content="Copiar caminho" Command="{Binding CopyPathCommand}" />
                  <Button Content="Remover Worktree"
                          x:Name="RemoveWorktreeButton"
                          Command="{Binding RemoveWorktreeCommand}"
                          IsEnabled="{Binding !IsRemoving}" />
                </WrapPanel>

                <Border Classes="card caution" x:Name="RemoveBlockedCard" IsVisible="{Binding IsRemoveBlocked}">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="body"
                               Text="Este Worktree possui alterações não commitadas. Remover o Worktree pode fazer com que essas alterações sejam perdidas. Nada foi removido." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Cancelar" Command="{Binding CancelRemoveCommand}" />
                      <Button Content="Ver alterações" Command="{Binding ShowRemoveChangesCommand}" />
                    </StackPanel>
                    <Border Classes="codeBox" IsVisible="{Binding IsShowingRemoveChanges}">
                      <SelectableTextBlock Classes="code" Text="{Binding RemoveChangesText}" />
                    </Border>
                  </StackPanel>
                </Border>

                <!-- ADR-029: o Git esqueceu o worktree, mas algum processo segura a pasta. -->
                <Border Classes="card caution" x:Name="RemoveLockedCard" IsVisible="{Binding IsRemoveLocked}">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="body" Text="{Binding RemoveLockedMessage}" />
                    <TextBlock Classes="fieldLabel" Text="Usando a pasta" />
                    <Border Classes="codeBox">
                      <SelectableTextBlock Classes="code" x:Name="RemoveLockersText" Text="{Binding RemoveLockersText}" />
                    </Border>
                    <TextBlock Classes="body"
                               Text="Forçar encerra esses processos e apaga a pasta. O que não estiver salvo neles será perdido." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Cancelar" Command="{Binding CancelRemoveCommand}" />
                      <Button Content="Tentar de novo"
                              Command="{Binding RemoveWorktreeCommand}"
                              IsEnabled="{Binding !IsRemoving}" />
                      <Button Classes="danger"
                              Content="Encerrar processos e remover"
                              x:Name="ForceRemoveWorktreeButton"
                              Command="{Binding ForceRemoveWorktreeCommand}"
                              IsVisible="{Binding CanForceRemove}"
                              IsEnabled="{Binding !IsRemoving}" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- Comandos pós-Worktree (ADR-028): a última execução e rodar de novo. -->
                <Border Height="1" Margin="0,4,0,0" Background="{DynamicResource WidgetStrokeSoftBrush}" />

                <views:PostWorktreeCommandsView x:Name="ReadyCommands" DataContext="{Binding Commands}" />

                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                  <Button x:Name="RunCommandsButton"
                          Content="Executar comandos"
                          IsEnabled="{Binding !Commands.IsRunning}"
                          Command="{Binding RunCommandsCommand}" />
                  <Button Content="Salvar comandos"
                          IsVisible="{Binding Commands.IsDirty}"
                          IsEnabled="{Binding !Commands.IsRunning}"
                          Command="{Binding SaveCommandsCommand}" />
                  <Button Content="Gerenciar comandos globais…" Command="{Binding OpenGlobalCommandsCommand}" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <!--
              Comandos rápidos (ADR-051): os comandos ligados ao diretório da
              etiqueta deste repositório, um botão cada. O worktree, a pasta e as
              variáveis vêm do ambiente; o usuário só clica.
            -->
            <Border Classes="card" x:Name="QuickCommandsCard" IsVisible="{Binding IsReady}">
              <StackPanel x:Name="QuickCommandsPanel"
                          x:DataType="vm:QuickCommandsViewModel"
                          DataContext="{Binding QuickCommands}"
                          Spacing="10">

                <TextBlock Classes="sectionTitle" Text="⚡ Comandos" />

                <TextBlock x:Name="QuickCommandsEmpty"
                           Classes="hint"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasNoItems}"
                           Text="Nenhum comando para este repositório. Em Etiquetas…, abra o diretório dele e adicione comandos globais em &quot;Comandos&quot;: eles viram botões aqui." />

                <ItemsControl x:Name="QuickCommandList" ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:QuickCommandItemViewModel">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,0,0,6">
                        <Button Grid.Column="0"
                                MinWidth="150"
                                HorizontalContentAlignment="Left"
                                VerticalAlignment="Top"
                                Content="{Binding RunLabel}"
                                ToolTip.Tip="{Binding Tip}"
                                IsEnabled="{Binding CanRun}"
                                Command="{Binding #QuickCommandsPanel.((vm:QuickCommandsViewModel)DataContext).RunCommand}"
                                CommandParameter="{Binding}" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                          <TextBlock FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace"
                                     FontSize="12"
                                     TextTrimming="CharacterEllipsis"
                                     Text="{Binding Template}"
                                     ToolTip.Tip="{Binding Template}" />
                          <TextBlock Classes="hint"
                                     Classes.ok="{Binding IsOk}"
                                     Classes.bad="{Binding IsFailed}"
                                     TextTrimming="CharacterEllipsis"
                                     IsVisible="{Binding HasStatus}"
                                     Text="{Binding StatusText}"
                                     ToolTip.Tip="{Binding StatusText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                          <Button Content="Mostrar terminal"
                                  IsVisible="{Binding HasTerminal}"
                                  Command="{Binding #QuickCommandsPanel.((vm:QuickCommandsViewModel)DataContext).ShowTerminalCommand}"
                                  CommandParameter="{Binding}" />
                          <Button Content="Ver saída"
                                  IsVisible="{Binding HasOutput}"
                                  Command="{Binding #QuickCommandsPanel.((vm:QuickCommandsViewModel)DataContext).ShowOutputCommand}"
                                  CommandParameter="{Binding}" />
                          <Button Content="Cancelar"
                                  IsVisible="{Binding CanCancel}"
                                  Command="{Binding #QuickCommandsPanel.((vm:QuickCommandsViewModel)DataContext).CancelCommand}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Height="1" Background="{DynamicResource WidgetStrokeSoftBrush}" IsVisible="{Binding HasGlobals}" />

                <!-- Qualquer comando global, mesmo sem estar no diretório da etiqueta. -->
                <StackPanel Spacing="8" IsVisible="{Binding HasGlobals}">
                  <Button x:Name="AdHocButton"
                          HorizontalAlignment="Left"
                          Content="+ Executar comando…"
                          Command="{Binding ToggleAdHocCommand}" />
                  <StackPanel x:Name="AdHocPanel" Spacing="6" IsVisible="{Binding IsAdHocOpen}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <ComboBox Grid.Column="0"
                                x:Name="AdHocCommands"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{Binding Globals}"
                                SelectedItem="{Binding SelectedAdHoc}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="commands:DevelopmentCommandRow">
                            <TextBlock Text="{Binding DisplayName}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <Button Grid.Column="1"
                              Classes="accent"
                              Content="Executar"
                              Command="{Binding RunAdHocCommand}" />
                    </Grid>
                    <TextBlock Classes="hint"
                               FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasAdHocSelection}"
                               Text="{Binding AdHocPreview}" />
                  </StackPanel>
                </StackPanel>

                <!-- O resultado da execução escondida: o mesmo "terminal" dos pós-Worktree. -->
                <StackPanel x:Name="QuickCommandOutput" Spacing="6" IsVisible="{Binding HasOutput}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Classes="hint"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding OutputTitle}" />
                    <Button Grid.Column="1"
                            Content="Cancelar"
                            IsVisible="{Binding IsRunning}"
                            Command="{Binding CancelCommand}" />
                  </Grid>
                  <views:CommandOutputView x:Name="QuickCommandTerminal" DataContext="{Binding Output}" />
                </StackPanel>

                <TextBlock x:Name="QuickCommandsMessage"
                           Classes="body warn"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasMessage}"
                           Text="{Binding Message}" />
              </StackPanel>
            </Border>

            <!--
              Agente de IA no worktree (ADR-030). Só com o ambiente pronto: o
              agente abre dentro do worktree, e sem ele não há onde abrir.
            -->
            <Border Classes="card" x:Name="AgentCard" IsVisible="{Binding IsReady}">
              <StackPanel x:Name="AgentPanel"
                          x:DataType="vm:AgentSessionViewModel"
                          DataContext="{Binding Agent}"
                          Spacing="10">

                <TextBlock Classes="sectionTitle" Text="{Binding AgentName}" />

                <TextBlock x:Name="AgentStatus"
                           Classes="body"
                           Classes.ok="{Binding IsRunningQuietly}"
                           Classes.bad="{Binding IsNotInstalled}"
                           Classes.warn="{Binding ShowsWarning}"
                           Classes.hint="{Binding IsChecking}"
                           Text="{Binding StatusText}" />

                <!-- O que os hooks disseram por último (ADR-037): a pergunta, o erro. -->
                <TextBlock x:Name="AgentActivity"
                           Classes="hint"
                           TextWrapping="Wrap"
                           MaxLines="3"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding ActivityText}"
                           IsVisible="{Binding ActivityText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <!-- Em execução / finalizado: o que liga a tarefa ao terminal. -->
                <StackPanel Spacing="10" IsVisible="{Binding HasSession}">
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="4">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldLabel" Text="Processo" IsVisible="{Binding IsRunning}" />
                    <SelectableTextBlock Grid.Row="0" Grid.Column="1"
                                         x:Name="AgentProcess"
                                         Classes="code"
                                         IsVisible="{Binding IsRunning}"
                                         Text="{Binding ProcessText, FallbackValue=''}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="fieldLabel" Text="Início" IsVisible="{Binding IsRunning}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="body" IsVisible="{Binding IsRunning}" Text="{Binding StartedText, FallbackValue=''}" />
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldLabel" Text="Executado" IsVisible="{Binding IsFinished}" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               x:Name="AgentRange"
                               Classes="body"
                               IsVisible="{Binding IsFinished}"
                               Text="{Binding RangeText, FallbackValue=''}" />
                  </Grid>

                  <TextBlock Classes="fieldLabel" Text="Pasta" />
                  <SelectableTextBlock Classes="code" Text="{Binding WorkingDirectory, FallbackValue=''}" />

                  <TextBlock x:Name="AgentMonitoring"
                             Classes="hint"
                             TextWrapping="Wrap"
                             Text="{Binding MonitoringText}"
                             IsVisible="{Binding MonitoringText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

                <TextBlock Classes="hint"
                           Text="{Binding FailureReason, FallbackValue=''}"
                           IsVisible="{Binding IsFailed}" />

                <!-- Não instalado: as instruções do sistema atual, nada de instalar sozinho. -->
                <StackPanel Spacing="10" IsVisible="{Binding IsNotInstalled}" x:Name="AgentInstallPanel">
                  <TextBlock Classes="body"
                             Text="Instale o Claude Code para utilizar este recurso, e depois clique em &quot;Verificar novamente&quot;. O MyTaskApp não instala nada sozinho." />

                  <TextBlock Classes="fieldLabel" Text="{Binding InstallGuide.Title, FallbackValue=''}" IsVisible="{Binding HasInstallGuide}" />

                  <ItemsControl ItemsSource="{Binding InstallGuide.Steps, FallbackValue={x:Null}}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="agents:AgentCliInstallStep">
                        <StackPanel Spacing="3">
                          <TextBlock Classes="hint" Text="{Binding Text}" />
                          <Grid ColumnDefinitions="*,Auto"
                                ColumnSpacing="8"
                                IsVisible="{Binding Command, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Border Grid.Column="0" Classes="codeBox">
                              <SelectableTextBlock Classes="code agentInstallCommand" Text="{Binding Command}" />
                            </Border>
                            <Button Grid.Column="1"
                                    Content="Copiar comando"
                                    VerticalAlignment="Center"
                                    Command="{Binding #AgentPanel.((vm:AgentSessionViewModel)DataContext).CopyCommand}"
                                    CommandParameter="{Binding Command}" />
                          </Grid>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Documentação de instalação" Command="{Binding OpenInstallDocsCommand}" />
                    <Button Classes="accent"
                            x:Name="RecheckAgentButton"
                            Content="Verificar novamente"
                            Command="{Binding RecheckCommand}" />
                  </StackPanel>
                </StackPanel>

                <TextBlock Classes="hint"
                           IsVisible="{Binding IsIdle}"
                           Text="Abre o agente num terminal do sistema, dentro do worktree desta tarefa. O MyTaskApp lembra qual terminal é desta tarefa." />

                <TextBlock Classes="hint"
                           IsVisible="{Binding VersionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Text="{Binding VersionText}" />

                <!--
                  O texto livre vai como a primeira mensagem do agente. Desmarcado
                  (o padrão), ele só monta o plano e pede aprovação antes de mexer
                  em arquivos; marcado, já executa.
                -->
                <StackPanel Spacing="6" IsVisible="{Binding ShowStart}" x:Name="AgentPromptPanel">
                  <TextBlock Classes="fieldLabel" Text="{Binding AgentName, StringFormat='Texto para o {0} (opcional)'}" />
                  <TextBox x:Name="AgentPromptBox"
                           Text="{Binding Prompt}"
                           MaxLength="{Binding MaxPromptLength}"
                           AcceptsReturn="True"
                           AcceptsTab="False"
                           TextWrapping="Wrap"
                           MinHeight="80"
                           MaxHeight="220"
                           VerticalContentAlignment="Top"
                           PlaceholderText="O que o agente deve fazer ao abrir… Use @ para citar um ambiente ou arquivo desta tarefa." />

                  <!--
                    O "@" cita os ambientes desta tarefa e os arquivos deles
                    (ADR-039): Enter insere o caminho, Tab entra na pasta.
                  -->
                  <Popup x:Name="AgentPromptPopup"
                         PlacementTarget="{Binding #AgentPromptBox}"
                         Placement="Bottom"
                         IsLightDismissEnabled="True"
                         IsOpen="{Binding References.IsCompletionOpen, Mode=TwoWay, FallbackValue=False}">
                    <Border Classes="aliasList" MaxWidth="640">
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Spacing="2" Margin="10,6,10,4">
                          <TextBlock Classes="footNote"
                                     x:Name="AgentPromptReferenceStatus"
                                     Text="{Binding References.StatusText}"
                                     IsVisible="{Binding References.HasStatus, FallbackValue=False}" />
                          <TextBlock Classes="footNote" Text="Enter insere o caminho · Tab entra na pasta · Esc fecha" />
                        </StackPanel>
                        <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled">
                          <ItemsControl x:Name="AgentPromptReferenceList"
                                        ItemsSource="{Binding References.Suggestions}"
                                        ItemTemplate="{StaticResource ReferenceSuggestionTemplate}" />
                        </ScrollViewer>
                      </DockPanel>
                    </Border>
                  </Popup>
                  <CheckBox x:Name="AgentRunDirectly"
                            Content="Executar direto"
                            IsEnabled="{Binding HasPrompt}"
                            IsChecked="{Binding RunDirectly}" />
                  <TextBlock Classes="hint"
                             IsVisible="{Binding HasPrompt}"
                             Text="Desmarcado, o agente só monta um plano e espera sua aprovação antes de alterar arquivos." />
                </StackPanel>

                <!--
                  Modelo e esforço (ADR-040): viram parâmetros do comando, depois
                  dos do campo abaixo. "Padrão" deixa o agente decidir. Como os
                  parâmetros, o usado ao iniciar vira o padrão.
                -->
                <Grid ColumnDefinitions="*,12,*"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="4"
                      x:Name="AgentChoicesPanel">
                  <Grid.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                      <Binding Path="ShowStart" />
                      <Binding Path="HasChoices" />
                    </MultiBinding>
                  </Grid.IsVisible>
                  <TextBlock Classes="fieldLabel" Text="Modelo" />
                  <TextBlock Classes="fieldLabel" Grid.Column="2" Text="Esforço" />
                  <ComboBox Grid.Row="1"
                            x:Name="AgentModelBox"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding ModelOptions}"
                            SelectedItem="{Binding SelectedModel}"
                            IsEnabled="{Binding !IsBusy}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="agents:AgentCliOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <ComboBox Grid.Row="1"
                            Grid.Column="2"
                            x:Name="AgentEffortBox"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding EffortOptions}"
                            SelectedItem="{Binding SelectedEffort}"
                            IsEnabled="{Binding !IsBusy}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="agents:AgentCliOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>

                <!-- Parâmetros do agente: o que for usado ao iniciar vira o padrão. -->
                <StackPanel Spacing="4" IsVisible="{Binding ShowStart}">
                  <TextBlock Classes="fieldLabel" Text="Parâmetros" />
                  <TextBox x:Name="AgentArgumentsBox"
                           FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace"
                           FontSize="12"
                           MaxLength="2000"
                           Text="{Binding Arguments}"
                           IsEnabled="{Binding !IsBusy}"
                           PlaceholderText="ex.: --dangerously-skip-permissions" />
                  <TextBlock Classes="hint"
                             x:Name="AgentCommandPreview"
                             Text="{Binding CommandPreview}" />
                  <TextBlock Classes="hint"
                             Text="O valor usado ao iniciar vira o padrão das próximas aberturas." />
                </StackPanel>

                <!--
                  Acompanhamento pelos hooks do agente (ADR-037). Só este app
                  recebe os hooks, e só nos agentes que ele abre: nenhum arquivo
                  de configuração do usuário é alterado.
                -->
                <StackPanel Spacing="4" IsVisible="{Binding ShowStart}">
                  <CheckBox x:Name="AgentMonitorBox"
                            Content="Avisar quando o agente precisar de mim ou terminar"
                            IsEnabled="{Binding !IsBusy}"
                            IsChecked="{Binding Monitor}" />
                  <TextBlock Classes="hint"
                             TextWrapping="Wrap"
                             Text="Usa os hooks do agente, só nas sessões abertas por aqui. Sua configuração do Claude Code não é alterada." />
                </StackPanel>

                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                  <Button Classes="accent"
                          x:Name="FocusAgentButton"
                          Content="Abrir terminal do agente"
                          IsVisible="{Binding IsRunning}"
                          Command="{Binding FocusCommand}" />
                  <Button Classes.accent="{Binding !IsRunning}"
                          x:Name="StartAgentButton"
                          Content="{Binding StartLabel}"
                          IsVisible="{Binding ShowStart}"
                          Command="{Binding StartCommand}" />
                </WrapPanel>

                <TextBlock Classes="hint"
                           x:Name="AgentMessage"
                           Text="{Binding Message}"
                           IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Border>

            <TextBlock Classes="hint"
                       x:Name="DevelopmentMessage"
                       Text="{Binding Message}"
                       IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!--
        A aba Tempo (ADR-052): o cronômetro, o registrado contra a estimativa e
        o histórico por dia. Cada coisa grava quando acontece, como a aba
        Desenvolvimento. O relógio é o mesmo da linha (Timer, do app).
      -->
      <TabItem x:Name="TimeTabItem"
               Header="Tempo"
               IsVisible="{Binding Time, Converter={x:Static ObjectConverters.IsNotNull}}">
        <ScrollViewer x:Name="TimeScroll"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,10,0,10">
          <StackPanel x:Name="TimeSection"
                      x:DataType="vm:TaskTimeLogViewModel"
                      DataContext="{Binding Time}"
                      Spacing="10">

            <Border Classes="card">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Grid.Column="0"
                             Classes="sectionTitle"
                             VerticalAlignment="Center"
                             Text="Tempo trabalhado" />
                  <TextBlock Grid.Column="1"
                             x:Name="TimeClock"
                             Classes="timeClock"
                             Margin="12,0,10,0"
                             VerticalAlignment="Center"
                             Text="{Binding Timer.ElapsedText}"
                             IsVisible="{Binding IsRunningHere}" />
                  <Button Grid.Column="2"
                          x:Name="TimeToggleButton"
                          Classes="timeToggle"
                          Classes.accent="{Binding !IsRunningHere}"
                          IsEnabled="{Binding CanToggleTimer}"
                          Command="{Binding ToggleTimerCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Classes="timeGlyph" Text="{Binding TimerGlyph}" />
                      <TextBlock Text="{Binding TimerLabel}" />
                    </StackPanel>
                  </Button>
                </Grid>

                <TextBlock x:Name="TimeSummary" Classes="body" Text="{Binding SummaryText}" />

                <TextBlock x:Name="TimeEstimate"
                           Classes="hint"
                           Classes.over="{Binding IsOverEstimate}"
                           Text="{Binding EstimateText}"
                           IsVisible="{Binding HasEstimate}" />
              </StackPanel>
            </Border>

            <TextBlock Classes="hint"
                       x:Name="TimeEmpty"
                       Text="Nenhum tempo registrado ainda. Use &quot;Iniciar&quot; para cronometrar, ou &quot;+ Adicionar tempo&quot; se esqueceu de iniciar."
                       IsVisible="{Binding IsEmpty}" />

            <ItemsControl x:Name="TimeDays" ItemsSource="{Binding Days}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TimeEntryDayViewModel">
                  <StackPanel Margin="0,0,0,8" Spacing="2">
                    <Grid ColumnDefinitions="*,Auto" Margin="2,0,2,2">
                      <TextBlock Grid.Column="0" Classes="fieldLabel" Text="{Binding Label}" />
                      <TextBlock Grid.Column="1" Classes="hint" Text="{Binding TotalText}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Entries}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TimeEntryRowViewModel">
                          <Border Classes="timeEntry" Classes.active="{Binding IsActive}">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                              <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Classes="timeRange" Text="{Binding RangeLabel}" />
                                <TextBlock Classes="issueMeta"
                                           Text="{Binding Note}"
                                           IsVisible="{Binding HasNote}" />
                              </StackPanel>
                              <TextBlock Grid.Column="1" Classes="timeDuration" Text="{Binding DurationLabel}" />
                              <TextBlock Grid.Column="2" Classes="timeSource" Text="{Binding SourceLabel}" />
                              <Button Grid.Column="3"
                                      Classes="timeAction"
                                      Content="{Binding EditGlyph}"
                                      ToolTip.Tip="Editar este período"
                                      IsVisible="{Binding CanEdit}"
                                      Command="{Binding #TimeSection.((vm:TaskTimeLogViewModel)DataContext).EditEntryCommand}"
                                      CommandParameter="{Binding}" />
                              <Button Grid.Column="4"
                                      Classes="timeAction"
                                      Content="{Binding DeleteGlyph}"
                                      ToolTip.Tip="Excluir este período"
                                      Command="{Binding #TimeSection.((vm:TaskTimeLogViewModel)DataContext).DeleteEntryCommand}"
                                      CommandParameter="{Binding}" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button x:Name="AddTimeButton"
                    HorizontalAlignment="Left"
                    Content="+ Adicionar tempo"
                    ToolTip.Tip="Lançar um período que o cronômetro não pegou"
                    Command="{Binding AddEntryCommand}" />

            <TextBlock Classes="issueMeta"
                       Foreground="{DynamicResource WidgetDangerBrush}"
                       Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>

  </DockPanel>

</Window>
