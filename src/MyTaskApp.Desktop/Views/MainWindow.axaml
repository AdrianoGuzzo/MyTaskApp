<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyTaskApp.Desktop.ViewModels"
        xmlns:views="using:MyTaskApp.Desktop.Views"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="MyTaskApp.Desktop.Views.MainWindow"
        x:DataType="vm:TodayViewModel"
        x:Name="Shell"
        Title="MyTaskApp"
        Width="360"
        Height="560"
        MinWidth="288"
        MinHeight="66"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="{Binding #Shell.Chrome.IsWindowTopmost}">

  <!--
    Sem decoração do sistema: a barra de título nativa sozinha já custava 32px
    e entregava a cara de "aplicação", não de widget. Em troca, o painel assume
    arrastar e redimensionar — e no Avalonia 12 isso é declarativo, via
    ElementRole, então quem move a janela continua sendo o sistema.

    Duas formas, uma janela (ADR-048): a normal, com o cabeçalho de sempre, e
    o HUD — um cartão do tamanho exato do conteúdo, sem margem transparente,
    para nada em volta dele bloquear o clique de quem está atrás. O Topmost
    acima é o efetivo: o "sempre no topo" da janela normal ou o "manter o HUD
    sempre visível", conforme o modo.
  -->

  <!-- Ctrl+Shift+N com o painel em foco; fora dele, o atalho global (ADR-054). -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding NewStickyNoteCommand}" />
  </Window.KeyBindings>

  <Window.Resources>
    <!-- Os rádios de tamanho e posição do menu do HUD. -->
    <ControlTheme x:Key="HudChoiceItem"
                  TargetType="MenuItem"
                  BasedOn="{StaticResource {x:Type MenuItem}}"
                  x:DataType="vm:HudChoiceViewModel">
      <Setter Property="Header" Value="{Binding Label}" />
      <Setter Property="ToggleType" Value="Radio" />
      <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
      <Setter Property="Command" Value="{Binding SelectCommand}" />
    </ControlTheme>
  </Window.Resources>

  <Panel x:Name="Root">

    <Panel.Transitions>
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
      </Transitions>
    </Panel.Transitions>

    <!--
      O fundo do HUD numa camada própria: a opacidade escolhida pelo usuário
      vale para o fundo, e o texto em cima continua 100% opaco. Opacidade no
      cartão inteiro era o que fazia o painel antigo sumir.
    -->
    <Border Classes="hudBackdrop"
            Classes.collapsed="{Binding #Shell.Chrome.IsHudCollapsed}"
            IsVisible="{Binding #Shell.Chrome.IsHud}"
            Opacity="{Binding #Shell.Chrome.HudOpacity}" />

    <Border Classes="widgetShell"
            Classes.hud="{Binding #Shell.Chrome.IsHud}"
            IsVisible="{Binding !#Shell.Chrome.IsHudCollapsed}">

      <DockPanel>

        <Border DockPanel.Dock="Top"
                Classes="titleBar"
                IsVisible="{Binding #Shell.Chrome.IsHeaderVisible}"
                chrome:WindowDecorationProperties.ElementRole="TitleBar"
                PointerPressed="OnTitleBarPointerPressed">

          <StackPanel Spacing="8">

            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto">

              <!-- A marca: o único bloco de cor de destaque sempre visível. -->
              <Border Grid.Column="0" Classes="brandMark">
                <TextBlock Text="&#x2713;" />
              </Border>

              <TextBlock Grid.Column="1"
                         Classes="brand"
                         Text="Checklist"
                         IsVisible="{Binding #Shell.Chrome.IsPanelVisible}" />

              <!-- Recolhido, o nome dá lugar ao número: é a única informação que sobra. -->
              <TextBlock Grid.Column="1"
                         Classes="brand"
                         Text="{Binding PendingLabel}"
                         TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding #Shell.Chrome.IsCollapsed}" />

              <!-- No modo compacto o progresso sobe para o cabeçalho. -->
              <TextBlock Grid.Column="2"
                         Classes="metric"
                         Margin="8,0,0,0"
                         Text="{Binding CountLabel}"
                         IsVisible="{Binding #Shell.Chrome.IsCompact}" />

              <!--
                O histórico dos últimos 7 dias (ADR-053): um flyout, e não uma janela —
                o checklist continua à vista atrás, e Esc e o clique fora fecham.
              -->
              <Button Grid.Column="3"
                      Classes="chrome"
                      Content="&#xE81C;"
                      chrome:WindowDecorationProperties.ElementRole="User"
                      ToolTip.Tip="Ver histórico dos últimos 7 dias">
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight"
                          Opened="OnHistoryFlyoutOpened"
                          Closed="OnHistoryFlyoutClosed">
                    <views:ActivityHistoryPanel DataContext="{Binding #Shell.((vm:TodayViewModel)DataContext).History}" />
                  </Flyout>
                </Button.Flyout>
              </Button>

              <!--
                O pino agora é "fixar como HUD": manter o app visível sobre as
                outras janelas, num cartão que não atrapalha (ADR-048). O
                "sempre no topo" da janela normal continua no menu.
              -->
              <Button Grid.Column="4"
                      x:Name="HudButton"
                      Classes="chrome"
                      Content="&#xE718;"
                      chrome:WindowDecorationProperties.ElementRole="User"
                      ToolTip.Tip="Fixar como HUD — fica visível sobre as outras janelas"
                      Command="{Binding #Shell.Chrome.EnterHudCommand}" />

              <Button Grid.Column="5"
                      Classes="chrome"
                      Content="{Binding #Shell.Chrome.CollapseGlyph}"
                      chrome:WindowDecorationProperties.ElementRole="User"
                      ToolTip.Tip="{Binding #Shell.Chrome.CollapseTip}"
                      Command="{Binding #Shell.Chrome.ToggleCollapsedCommand}" />

              <Button Grid.Column="6"
                      Classes="chrome"
                      Content="&#xE712;"
                      chrome:WindowDecorationProperties.ElementRole="User"
                      ToolTip.Tip="Mais opções">
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedRight">
                    <!-- Post-its (ADR-054): o que ainda não merece virar tarefa. -->
                    <MenuItem Header="Post-its">
                      <MenuItem Header="Novo post-it"
                                InputGesture="Ctrl+Shift+N"
                                Command="{Binding NewStickyNoteCommand}" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Painel completo"
                              ToggleType="Radio"
                              IsChecked="{Binding #Shell.Chrome.IsExpanded, Mode=OneWay}"
                              Command="{Binding #Shell.Chrome.UseModeCommand}"
                              CommandParameter="expanded" />
                    <MenuItem Header="Modo compacto"
                              ToggleType="Radio"
                              IsChecked="{Binding #Shell.Chrome.IsCompact, Mode=OneWay}"
                              Command="{Binding #Shell.Chrome.UseModeCommand}"
                              CommandParameter="compact" />
                    <MenuItem Header="Recolher"
                              ToggleType="Radio"
                              IsChecked="{Binding #Shell.Chrome.IsCollapsed, Mode=OneWay}"
                              Command="{Binding #Shell.Chrome.UseModeCommand}"
                              CommandParameter="collapsed" />
                    <Separator />
                    <MenuItem Header="Fixar como HUD"
                              Command="{Binding #Shell.Chrome.EnterHudCommand}" />
                    <MenuItem Header="Sempre no topo"
                              ToggleType="CheckBox"
                              IsChecked="{Binding #Shell.Chrome.IsTopmost, Mode=OneWay}"
                              Command="{Binding #Shell.Chrome.ToggleTopmostCommand}" />
                    <MenuItem Header="Janela e comportamento…"
                              Command="{Binding #Shell.Chrome.OpenWindowSettingsCommand}" />
                    <MenuItem Header="Abrir recolhido da próxima vez"
                              ToggleType="CheckBox"
                              IsChecked="{Binding #Shell.Chrome.StartHidden, Mode=TwoWay}" />
                    <MenuItem Header="Iniciar com o Windows"
                              ToggleType="CheckBox"
                              IsVisible="{Binding #Shell.Chrome.CanStartWithWindows}"
                              IsChecked="{Binding #Shell.Chrome.StartsWithWindows, Mode=OneWay}"
                              Command="{Binding #Shell.Chrome.ToggleStartWithWindowsCommand}" />
                    <Separator />

                    <!--
                      Tema (ADR-041). Cada item traz uma amostra nas cores do
                      próprio tema: escolher vendo, e não lembrando nome. O
                      menu fica aberto no clique para dar para passar por
                      todos e ver cada um aplicado no painel ali atrás.
                    -->
                    <MenuItem Header="Tema"
                              ItemsSource="{Binding #Shell.Chrome.Themes}">
                      <MenuItem.ItemContainerTheme>
                        <ControlTheme TargetType="MenuItem"
                                      BasedOn="{StaticResource {x:Type MenuItem}}"
                                      x:DataType="vm:ThemeOptionViewModel">
                          <Setter Property="ToggleType" Value="Radio" />
                          <Setter Property="GroupName" Value="theme" />
                          <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
                          <Setter Property="Command" Value="{Binding SelectCommand}" />
                          <Setter Property="StaysOpenOnClick" Value="True" />
                          <Setter Property="ToolTip.Tip" Value="{Binding Description}" />
                          <Setter Property="ToolTip.Placement" Value="Right" />
                        </ControlTheme>
                      </MenuItem.ItemContainerTheme>
                      <MenuItem.ItemTemplate>
                        <DataTemplate x:DataType="vm:ThemeOptionViewModel">
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Classes="themeSwatch">
                              <Panel>
                                <Grid ColumnDefinitions="*,*">
                                  <Border Grid.Column="0" Background="{Binding SwatchStart}" />
                                  <Border Grid.Column="1" Background="{Binding SwatchEnd}" />
                                </Grid>
                                <Ellipse Width="7"
                                         Height="7"
                                         Fill="{Binding SwatchAccent}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                              </Panel>
                            </Border>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                          </StackPanel>
                        </DataTemplate>
                      </MenuItem.ItemTemplate>
                    </MenuItem>

                    <Separator />
                    <!-- Sem ícone na bandeja, ocultar não teria volta. -->
                    <MenuItem Header="Ocultar na bandeja"
                              IsVisible="{Binding #Shell.Chrome.TrayAvailable}"
                              Command="{Binding #Shell.Chrome.HideCommand}" />
                    <MenuItem Header="Sair do MyTaskApp"
                              Command="{Binding #Shell.Chrome.RequestExitCommand}" />
                    <Separator />
                    <MenuItem Header="Configuração de lembretes…"
                              Command="{Binding OpenSettingsCommand}" />
                    <MenuItem Header="Etiquetas…"
                              Command="{Binding OpenTagsCommand}" />
                    <MenuItem Header="Comandos globais…"
                              Command="{Binding OpenCommandsCommand}" />
                    <MenuItem Header="Sons do Claude Code…"
                              Command="{Binding OpenSoundsCommand}" />
                    <MenuItem Header="Integrações…"
                              Command="{Binding OpenIntegrationsCommand}" />
                    <MenuItem Header="Gerenciamento de dados…"
                              Command="{Binding OpenDataManagementCommand}" />

                    <!--
                      Versão, commit e data da build (ADR-044): o fim do menu,
                      sem janela "Sobre" própria. O clique copia o SHA inteiro
                      para colar num relato de problema.
                    -->
                    <Separator />
                    <MenuItem Header="{Binding VersionLabel}"
                              ToolTip.Tip="Copiar versão e commit"
                              Command="{Binding CopyVersionCommand}" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>

              <!-- O X faz o que "Ao fechar a janela" mandar (ADR-048). -->
              <Button Grid.Column="7"
                      Classes="chrome"
                      Content="&#xE711;"
                      chrome:WindowDecorationProperties.ElementRole="User"
                      ToolTip.Tip="Fechar"
                      Command="{Binding #Shell.Chrome.RequestCloseCommand}" />

            </Grid>

            <!--
              A data continua sendo o rótulo que o quadro produz. Aqui ela é
              informação periférica: 10px, cinza baixo, acima do progresso.
            -->
            <Grid ColumnDefinitions="*,Auto"
                  IsVisible="{Binding #Shell.Chrome.IsExpanded}">
              <TextBlock Grid.Column="0"
                         Classes="dateLine"
                         Text="{Binding Title}"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Classes="metric"
                         Text="{Binding ProgressLabel}" />
            </Grid>

            <ProgressBar Classes="slim"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding ProgressValue}"
                         IsVisible="{Binding HasProgress}" />

          </StackPanel>
        </Border>

        <!--
          O cabeçalho do HUD. Sem papel de TitleBar de propósito: o arrasto é
          iniciado pelo próprio painel (BeginMoveDrag) para a janela saber que
          foi o usuário quem moveu — e só então guardar a posição como
          "personalizada". Um movimento do sistema (troca de DPI, monitor
          desligado) não pode virar escolha do usuário.
        -->
        <Border DockPanel.Dock="Top"
                Classes="hudBar"
                IsVisible="{Binding #Shell.Chrome.IsHudExpanded}"
                PointerPressed="OnHudBarPointerPressed">

          <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto">

            <Border Grid.Column="0" Classes="brandMark">
              <TextBlock Text="&#x2713;" />
            </Border>

            <TextBlock Grid.Column="1" Classes="brand" Text="MyTaskApp" />

            <TextBlock Grid.Column="2"
                       Classes="metric"
                       Margin="8,0,0,0"
                       Text="{Binding CountLabel}" />

            <Button Grid.Column="3"
                    Classes="chrome"
                    Classes.on="{Binding #Shell.Chrome.IsCaptureOpen}"
                    Content="{Binding #Shell.Chrome.CaptureGlyph}"
                    chrome:WindowDecorationProperties.ElementRole="User"
                    ToolTip.Tip="{Binding #Shell.Chrome.CaptureTip}"
                    Command="{Binding #Shell.Chrome.ToggleCaptureCommand}" />

            <!--
              O histórico dos últimos 7 dias (ADR-053): um flyout, e não uma janela —
              o checklist continua à vista atrás, e Esc e o clique fora fecham.
              No HUD compacto, de 260px, ele sai: o contador já não caberia.
            -->
            <Button Grid.Column="4"
                    Classes="chrome"
                    Content="&#xE81C;"
                    IsVisible="{Binding !#Shell.Chrome.IsHudCompact}"
                    chrome:WindowDecorationProperties.ElementRole="User"
                    ToolTip.Tip="Ver histórico dos últimos 7 dias">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight"
                        Opened="OnHistoryFlyoutOpened"
                        Closed="OnHistoryFlyoutClosed">
                  <views:ActivityHistoryPanel DataContext="{Binding #Shell.((vm:TodayViewModel)DataContext).History}" />
                </Flyout>
              </Button.Flyout>
            </Button>

            <!-- Aceso: o HUD está ligado. O clique é a porta de volta. -->
            <Button Grid.Column="5"
                    x:Name="HudExitButton"
                    Classes="chrome on"
                    Content="&#xE840;"
                    chrome:WindowDecorationProperties.ElementRole="User"
                    ToolTip.Tip="HUD ativo — clique para voltar à janela normal"
                    Command="{Binding #Shell.Chrome.ExitHudCommand}" />

            <Button Grid.Column="6"
                    Classes="chrome"
                    Content="&#xE712;"
                    chrome:WindowDecorationProperties.ElementRole="User"
                    ToolTip.Tip="Opções do HUD">
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="Tamanho"
                            ItemsSource="{Binding #Shell.Chrome.HudSizeOptions}"
                            ItemContainerTheme="{StaticResource HudChoiceItem}" />
                  <MenuItem Header="Posição"
                            ItemsSource="{Binding #Shell.Chrome.HudPositionOptions}"
                            ItemContainerTheme="{StaticResource HudChoiceItem}" />
                  <MenuItem Header="Manter o HUD sempre visível"
                            ToggleType="CheckBox"
                            IsChecked="{Binding #Shell.Chrome.HudAlwaysOnTop, Mode=TwoWay}" />
                  <MenuItem Header="Recolher o HUD"
                            Command="{Binding #Shell.Chrome.CollapseHudCommand}" />
                  <Separator />
                  <MenuItem Header="Janela e comportamento…"
                            Command="{Binding #Shell.Chrome.OpenWindowSettingsCommand}" />
                  <MenuItem Header="Configuração de lembretes…"
                            Command="{Binding OpenSettingsCommand}" />
                  <Separator />
                  <MenuItem Header="Sair do modo HUD"
                            Command="{Binding #Shell.Chrome.ExitHudCommand}" />
                  <MenuItem Header="Ocultar na bandeja"
                            IsVisible="{Binding #Shell.Chrome.TrayAvailable}"
                            Command="{Binding #Shell.Chrome.HideCommand}" />
                  <MenuItem Header="Sair do MyTaskApp"
                            Command="{Binding #Shell.Chrome.RequestExitCommand}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>

            <!--
              O X do HUD também obedece a "Ao fechar a janela". Quando a
              escolha é "entrar no HUD" e ele já está no HUD, repetir o gesto
              não faria nada: a janela abre estas opções em vez de ignorar o
              clique.
            -->
            <Button Grid.Column="7"
                    x:Name="HudCloseButton"
                    Classes="chrome"
                    Content="&#xE711;"
                    chrome:WindowDecorationProperties.ElementRole="User"
                    ToolTip.Tip="Fechar"
                    Command="{Binding #Shell.Chrome.RequestCloseCommand}">
              <FlyoutBase.AttachedFlyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="Voltar à janela normal"
                            Command="{Binding #Shell.Chrome.ExitHudCommand}" />
                  <MenuItem Header="Ocultar na bandeja"
                            IsVisible="{Binding #Shell.Chrome.TrayAvailable}"
                            Command="{Binding #Shell.Chrome.HideCommand}" />
                  <MenuItem Header="Sair do MyTaskApp"
                            Command="{Binding #Shell.Chrome.RequestExitCommand}" />
                </MenuFlyout>
              </FlyoutBase.AttachedFlyout>
            </Button>

          </Grid>
        </Border>

        <!--
          A explicação da primeira vez. Dentro do HUD, e não numa janela por
          cima: quem acabou de fixar o app quer ver onde ele foi parar.
        -->
        <Border DockPanel.Dock="Top"
                Classes="hudIntro"
                IsVisible="{Binding #Shell.Chrome.IsHudIntroVisible}">
          <StackPanel Spacing="4">
            <TextBlock Classes="hudIntroTitle" Text="Modo HUD" />
            <TextBlock Classes="hudIntroText"
                       Text="Fica visível sobre as outras janelas. Fora do cartão, o clique vai para o app de trás." />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0"
                         Classes="hudIntroText"
                         VerticalAlignment="Center"
                         Text="Ajustes em ⋯ → Janela e comportamento." />
              <Button Grid.Column="1"
                      Classes="accent"
                      Margin="8,0,0,0"
                      Padding="12,3"
                      FontSize="11"
                      Content="Entendi"
                      Command="{Binding #Shell.Chrome.DismissHudIntroCommand}" />
            </Grid>
          </StackPanel>
        </Border>

        <Button DockPanel.Dock="Bottom"
                Classes="hudFooter"
                Content="+ Nova tarefa"
                IsVisible="{Binding #Shell.Chrome.IsHudFooterVisible}"
                Command="{Binding #Shell.Chrome.ToggleCaptureCommand}" />

        <views:TodayView IsVisible="{Binding #Shell.Chrome.IsPanelVisible}"
                         Classes.compact="{Binding #Shell.Chrome.IsCompact}"
                         Classes.hud="{Binding #Shell.Chrome.IsHud}"
                         Classes.hudCompact="{Binding #Shell.Chrome.IsHudCompact}"
                         Classes.captureOpen="{Binding #Shell.Chrome.IsCaptureOpen}" />

      </DockPanel>
    </Border>

    <!--
      HUD recolhido: uma pílula com a marca e o que falta. Passar o mouse (com
      uma pausa, para atravessar não abrir nada) ou clicar devolve o cartão.
    -->
    <Button Classes="hudPill"
            IsVisible="{Binding #Shell.Chrome.IsHudCollapsed}"
            chrome:WindowDecorationProperties.ElementRole="User"
            ToolTip.Tip="{Binding PendingLabel}"
            Command="{Binding #Shell.Chrome.ExpandHudCommand}"
            PointerEntered="OnPillPointerEntered"
            PointerExited="OnPillPointerExited">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Border Classes="brandMark">
          <TextBlock Text="&#x2713;" />
        </Border>
        <TextBlock Classes="brand" Text="MyTaskApp" />
        <Border Classes="countBadge" IsVisible="{Binding HasPending}">
          <TextBlock Text="{Binding PendingCount}" />
        </Border>
      </StackPanel>
    </Button>

    <!--
      Alças de redimensionamento sobre o anel da sombra, onde não há conteúdo
      para roubar clique. Os papéis fazem o sistema redimensionar; o
      PointerPressed é a rede de segurança se a plataforma ignorar o papel.
      O HUD não tem: o tamanho dele é escolha de preset.
    -->
    <views:ResizeGrips Margin="2"
                       IsVisible="{Binding #Shell.Chrome.AreGripsVisible}" />

  </Panel>

</Window>
