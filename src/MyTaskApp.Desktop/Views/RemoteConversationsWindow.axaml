<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyTaskApp.Desktop.ViewModels"
        xmlns:remote="using:MyTaskApp.Application.Remote"
        x:Class="MyTaskApp.Desktop.Views.RemoteConversationsWindow"
        x:DataType="vm:RemoteConversationsViewModel"
        Title="Conversas do Claude"
        Width="760"
        Height="680"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">

  <!--
    As conversas do Claude de todas as máquinas da conta (ADR-091), como a aba
    Remoto do celular: a aberta aqui, no celular ou em outro computador. O
    próximo prompt e o parar vão para a máquina de cada conversa. Em cima, os
    terminais do Claude das outras máquinas (ADR-101), para seguir e assumir.
  -->

  <Window.Styles>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource WidgetSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WidgetStrokeSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource WidgetCardRadius}" />
      <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style Selector="TextBlock.meta">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextLowBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
    </Style>

    <Style Selector="TextBlock.caution">
      <Setter Property="Foreground" Value="{DynamicResource WidgetCautionBrush}" />
    </Style>

    <Style Selector="TextBox.output">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="AcceptsReturn" Value="True" />
    </Style>

  </Window.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16,14" Spacing="12">

      <StackPanel Spacing="4">
        <TextBlock Text="Conversas do Claude" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Classes="meta"
                   Text="As conversas sem terminal de todas as máquinas da conta. Escolha uma para ver a linha do tempo e mandar o próximo prompt: ele roda na máquina da conversa." />
        <TextBlock x:Name="ConversationsMessage" Classes="meta caution" Text="{Binding Message}"
                   IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>

      <!-- Os terminais do agente das outras máquinas: a sessão aberta pelo card lá aparece aqui (ADR-101). -->
      <Border x:Name="AllTerminalsCard" Classes="card" DataContext="{Binding Terminals}" IsVisible="{Binding IsOffered}">
        <StackPanel Spacing="8">
          <TextBlock Classes="sectionTitle" Text="Terminais do Claude" />
          <TextBlock Classes="meta"
                     Text="O Claude Code que roda no terminal do agente das outras máquinas. Seguir mostra a tela ao vivo; lá dentro, Assumir o controle passa a vez de digitar para cá." />
          <TextBlock x:Name="AllTerminalsMessage" Classes="meta caution" Text="{Binding Message}"
                     IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Classes="meta" Text="{Binding EmptyText}" IsVisible="{Binding HasNoItems}" />
          <ItemsControl x:Name="AllTerminalList" ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="remote:RemoteTerminalItem">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="meta" Text="{Binding MachineName}" />
                    <TextBlock Classes="meta" Text="{Binding State}" />
                    <TextBlock Classes="meta caution" Text="{Binding BypassWarning}"
                               IsVisible="{Binding BypassWarning, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </StackPanel>
                  <!-- ADR-103: a máquina sem o terminal remoto aceito aparece só com o estado. -->
                  <Button Grid.Column="1" Content="Seguir" VerticalAlignment="Center"
                          IsVisible="{Binding CanFollow}"
                          Command="{Binding $parent[ItemsControl].((vm:RemoteTerminalsViewModel)DataContext).FollowCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border x:Name="ConversationsCard" Classes="card" DataContext="{Binding Sessions}">
        <StackPanel Spacing="8">
          <TextBlock Classes="sectionTitle" Text="Conversas sem terminal" />
          <TextBlock x:Name="ConversationsSessionsMessage" Classes="meta caution" Text="{Binding Message}"
                     IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Classes="meta" Text="Nenhuma conversa do Claude nos últimos dias."
                     IsVisible="{Binding !HasItems}" />
          <ListBox x:Name="ConversationList" MaxHeight="220" IsVisible="{Binding HasItems}"
                   ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:RemoteSessionLine">
                <StackPanel Spacing="1">
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="meta" Text="{Binding Details}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Spacing="6" IsVisible="{Binding HasSelection}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock x:Name="ConversationState" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding SelectedState}" />
              <Button Grid.Column="1" x:Name="StopConversationButton" Content="Parar a conversa"
                      ToolTip.Tip="Encerra a resposta em andamento lá. A conversa não recebe mais prompts."
                      IsVisible="{Binding CanStop}"
                      Command="{Binding StopCommand}" />
            </Grid>
            <TextBox x:Name="ConversationTimelineBox" Classes="output" Height="300" Text="{Binding Timeline}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding CanPrompt}">
              <TextBox x:Name="ConversationPromptBox"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MinHeight="48"
                       PlaceholderText="O próximo prompt nesta conversa"
                       Text="{Binding Prompt}" />
              <Button Grid.Column="1" x:Name="ConversationSendButton" Classes="accent" VerticalAlignment="Bottom"
                      Content="Mandar"
                      IsEnabled="{Binding !IsBusy}"
                      Command="{Binding SendPromptCommand}" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</Window>
