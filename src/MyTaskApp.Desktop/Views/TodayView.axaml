<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyTaskApp.Desktop.ViewModels"
        xmlns:spell="using:MyTaskApp.Desktop.SpellChecking"
             xmlns:views="using:MyTaskApp.Desktop.Views"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             x:Class="MyTaskApp.Desktop.Views.TodayView"
             x:DataType="vm:TodayViewModel"
             x:Name="Root">

  <UserControl.Resources>

    <!--
      O seletor de etiquetas, uma vez só (ADR-025). Dois lugares o abrem: o
      botão da linha, que grava a cada marca, e o da caixa de captura, que só
      guarda a escolha para a próxima captura (TaskTagsViewModel.IsDraft).
      Marcar não fecha: escolher três etiquetas custa três cliques, não três
      aberturas.
    -->
    <DataTemplate x:Key="TagPicker" x:DataType="vm:TaskTagsViewModel">
      <StackPanel Width="260" Margin="2" Spacing="8">

        <TextBlock Text="{Binding Heading}"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" />

        <!-- As escolhidas, com o nome: o "×" tira sem procurar na lista. -->
        <ItemsControl ItemsSource="{Binding Selected}"
                      IsVisible="{Binding HasTags}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TagChipViewModel">
              <Border Classes="tagChip" Background="{Binding Fill}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{Binding Name}"
                             Foreground="{Binding Foreground}"
                             MaxWidth="160"
                             TextTrimming="CharacterEllipsis" />
                  <Button Classes="tagRemove"
                          Content="&#xE711;"
                          Foreground="{Binding Foreground}"
                          ToolTip.Tip="Remover esta etiqueta"
                          Command="{Binding #Root.((vm:TodayViewModel)DataContext).RemoveTagCommand}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBox FontSize="12"
                 PlaceholderText="Pesquisar etiqueta…"
                 Text="{Binding SearchText}"
                 IsVisible="{Binding !HasNoTagsAtAll}" />

        <TextBlock Classes="tagHint"
                   Text="Carregando…"
                   IsVisible="{Binding IsLoading}" />

        <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Options}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TagOptionViewModel">
                <CheckBox Classes="tagOption"
                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                          Command="{Binding #Root.((vm:TodayViewModel)DataContext).ToggleTagCommand}"
                          CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse Classes="tagDot" Fill="{Binding Tag.Fill}" />
                    <TextBlock Text="{Binding Tag.Name}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </CheckBox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock Classes="tagHint"
                   Text="Nada encontrado."
                   IsVisible="{Binding HasNoMatches}" />

        <TextBlock Classes="tagHint"
                   Text="Nenhuma etiqueta ainda. Crie a primeira para começar a organizar."
                   IsVisible="{Binding HasNoTagsAtAll}" />

        <TextBlock Text="{Binding ErrorMessage}"
                   FontSize="11.5"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource WidgetDangerBrush}"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <Button HorizontalAlignment="Left"
                Classes="tagManage"
                Content="Gerenciar etiquetas…"
                Command="{Binding #Root.((vm:TodayViewModel)DataContext).OpenTagsCommand}" />

      </StackPanel>
    </DataTemplate>

    <!--
      A linha, uma vez só. Dois desenhos a usam: a lista e o item levantado
      durante o arrasto (o ContentControl lá embaixo). Mesma razão pela qual o
      "⋯" abre o ContextFlyout da própria linha em vez de ter um menu só dele —
      duas cópias em XAML divergiriam no primeiro campo novo.
    -->
    <DataTemplate x:Key="TaskRow" x:DataType="vm:TaskRowViewModel">
      <Border Classes="row"
              Classes.fixedOrder="{Binding IsCompleted}"
              chrome:WindowDecorationProperties.ElementRole="User">

        <!--
          As ações secundárias moram aqui, e em um lugar só: o
          botão "⋯" abre este mesmo menu (ver TodayView.axaml.cs),
          para que clique direito e botão nunca ofereçam coisas
          diferentes.
        -->
        <Border.ContextFlyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
            <MenuItem Header="Arquivar"
                      Command="{Binding #Root.((vm:TodayViewModel)DataContext).ArchiveCommand}"
                      CommandParameter="{Binding}" />
            <Separator />
            <MenuItem Header="Mover para a lixeira…"
                      Command="{Binding #Root.((vm:TodayViewModel)DataContext).MoveToTrashCommand}"
                      CommandParameter="{Binding}" />
          </MenuFlyout>
        </Border.ContextFlyout>

        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto">

          <!--
            A alça. Border e não Button de propósito: botão por linha herdaria
            foco e estado :pressed que atrapalham o gesto, e há testes headless
            que contam botões por janela. ElementRole="User" declarado aqui, e
            não herdado da linha, é o que impede o arrasto de virar empurrão na
            janela no modo discreto (ADR-017, armadilha 4).
          -->
          <Border Grid.Column="0"
                  Classes="dragHandle"
                  chrome:WindowDecorationProperties.ElementRole="User"
                  ToolTip.Tip="Arraste para mudar a ordem"
                  PointerPressed="OnHandlePointerPressed">
            <!--
              Os seis pontos, desenhados. Não é fonte: o `⠿` Braille não está
              na Inter nem na fonte de ícones do Windows, e o gripper de lá
              (E76F) sai como dois tracinhos que se leem como "=". Isto não
              contraria o ADR-017 — o que aquela decisão proíbe é emoji, que vem
              com cor própria; uma forma vetorial herda o pincel como qualquer
              glifo monocromático.
            -->
            <UniformGrid Columns="2"
                         Rows="3"
                         Width="8"
                         Height="12"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center">
              <Ellipse Classes="grip" />
              <Ellipse Classes="grip" />
              <Ellipse Classes="grip" />
              <Ellipse Classes="grip" />
              <Ellipse Classes="grip" />
              <Ellipse Classes="grip" />
            </UniformGrid>
          </Border>

          <Border Grid.Column="1"
                  Classes="priority"
                  Classes.high="{Binding IsHighPriority}"
                  Classes.urgent="{Binding IsUrgent}" />

          <CheckBox Grid.Column="2"
                    Classes="task"
                    IsChecked="{Binding IsCompleted, Mode=OneWay}"
                    Command="{Binding #Root.((vm:TodayViewModel)DataContext).ToggleCommand}"
                    CommandParameter="{Binding}" />

          <StackPanel Grid.Column="3" Spacing="1" VerticalAlignment="Center">
            <!--
              Um clique no texto copia o título (ver OnTitleTapped),
              e o balão devolve o que o "…" levou.
              Background transparente, e nunca nulo: fundo nulo não
              recebe ponteiro, e tanto o gesto quanto o balão
              dependeriam de mirar nos glifos.
              Tapped, e não PointerPressed: arrastar o painel por
              cima de uma linha não pode virar uma cópia.

              Embaixo do texto vêm todas as etiquetas, com nome e cor —
              inclusive as que o "+N" escondeu. Mesma regra do balão da
              bolinha: as amarrações passam pelo nome (#TitleText), porque o
              DataContext não desce até o balão.
            -->
            <TextBlock x:Name="TitleText"
                       Text="{Binding Title}"
                       Classes="taskTitle"
                       Classes.done="{Binding IsCompleted}"
                       Background="Transparent"
                       Cursor="Hand"
                       Tapped="OnTitleTapped">
              <ToolTip.Tip>
                <ToolTip>
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding #TitleText.((vm:TaskRowViewModel)DataContext).Title}" />
                    <ItemsControl Margin="0,0,0,-4"
                                  ItemsSource="{Binding #TitleText.((vm:TaskRowViewModel)DataContext).Tags.Selected}"
                                  IsVisible="{Binding #TitleText.((vm:TaskRowViewModel)DataContext).Tags.HasTags}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TagChipViewModel">
                          <Border Classes="tipTag" Background="{Binding Fill}">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{Binding Foreground}" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ToolTip>
              </ToolTip.Tip>
            </TextBlock>

            <StackPanel Orientation="Horizontal"
                        Spacing="4"
                        IsVisible="{Binding IsAwaitingAttention}">
              <TextBlock Text="⚠"
                         Classes="waiting"
                         Classes.urgent="{Binding IsUrgentlyAwaiting}" />
              <TextBlock Text="{Binding AttentionLabel}"
                         Classes="waiting"
                         Classes.urgent="{Binding IsUrgentlyAwaiting}"
                         TextTrimming="CharacterEllipsis"
                         Background="Transparent"
                         ToolTip.Tip="{Binding AttentionLabel}" />
            </StackPanel>

            <!--
              Agente de IA aberto para a tarefa (ADR-030): discreto, como o ⚠,
              só para achar de relance qual tarefa tem um terminal rodando.
              Um clique traz o terminal para a frente (ver OnAgentBadgeTapped).
              HorizontalAlignment="Left": o alvo do clique é o texto, e não a
              largura inteira da coluna.
            -->
            <TextBlock x:Name="AgentBadge"
                       Classes="agentBadge"
                       Text="{Binding AgentLabel}"
                       IsVisible="{Binding HasActiveAgent}"
                       HorizontalAlignment="Left"
                       Background="Transparent"
                       Cursor="Hand"
                       Tapped="OnAgentBadgeTapped"
                       ToolTip.Tip="{Binding AgentTip}" />
          </StackPanel>

          <!--
            As etiquetas (ADR-025): só bolinhas, o nome vem no balão. Com mais
            de cinco, o resto vira um "+N" — a linha não quebra nem espreme o
            título além disso.
          -->
          <StackPanel Grid.Column="4"
                      Orientation="Horizontal"
                      Spacing="3"
                      Margin="6,0,0,0"
                      VerticalAlignment="Center"
                      IsVisible="{Binding Tags.HasTags}">
            <ItemsControl ItemsSource="{Binding Tags.Dots}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="3" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TagChipViewModel">
                  <!--
                    O balão tem a cor da própria etiqueta: é ele que confirma
                    de qual bolinha o nome veio. Um ToolTip explícito, e não
                    texto solto, porque é o único jeito de pintar o fundo de
                    um balão só sem mexer em todos os outros do app.

                    As amarrações apontam para a bolinha pelo nome (#Dot), e
                    não para o DataContext: o balão é valor de propriedade, não
                    filho, e o DataContext não desce até ele — um {Binding Name}
                    abriria um balão vazio.
                  -->
                  <Ellipse x:Name="Dot" Classes="tagDot" Fill="{Binding Fill}">
                    <ToolTip.Tip>
                      <ToolTip Classes="tagTip"
                               Background="{Binding #Dot.((vm:TagChipViewModel)DataContext).Fill}"
                               BorderBrush="{Binding #Dot.((vm:TagChipViewModel)DataContext).Fill}"
                               Foreground="{Binding #Dot.((vm:TagChipViewModel)DataContext).Foreground}"
                               Content="{Binding #Dot.((vm:TagChipViewModel)DataContext).Name}" />
                    </ToolTip.Tip>
                  </Ellipse>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="tagOverflow"
                       Text="{Binding Tags.OverflowLabel}"
                       IsVisible="{Binding Tags.HasOverflow}"
                       ToolTip.Tip="{Binding Tags.OverflowTip}" />
          </StackPanel>

          <!--
            O seletor (template TagPicker). Aqui cada marca grava na hora (ver
            TodayViewModel.ToggleTagAsync), então fechar nunca perde nada.
          -->
          <Button Grid.Column="5"
                  Classes="tags"
                  Classes.on="{Binding Tags.HasTags}"
                  Content="&#xE8EC;"
                  ToolTip.Tip="Etiquetas desta tarefa">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight"
                      Opened="OnTagsFlyoutOpened"
                      Closed="OnTagsFlyoutClosed">
                <ContentControl DataContext="{Binding Tags}"
                                Content="{Binding}"
                                ContentTemplate="{StaticResource TagPicker}" />
              </Flyout>
            </Button.Flyout>
          </Button>

          <Button Grid.Column="6"
                  Classes="notes"
                  Classes.on="{Binding HasNotes}"
                  Content="{Binding NotesGlyph}"
                  ToolTip.Tip="{Binding NotesLabel}"
                  Command="{Binding #Root.((vm:TodayViewModel)DataContext).OpenNotesCommand}"
                  CommandParameter="{Binding}" />

          <Button Grid.Column="7"
                  Classes="reminder"
                  Classes.on="{Binding HasReminder}"
                  Content="&#xEA8F;"
                  ToolTip.Tip="Ajustar o lembrete desta tarefa">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Width="330" Margin="4" Spacing="12">

                  <TextBlock Text="{Binding Title}"
                             FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />

                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Padrão"
                            FontSize="11"
                            Command="{Binding Editor.UsePresetCommand}"
                            CommandParameter="default" />
                    <Button Content="Urgente"
                            FontSize="11"
                            Command="{Binding Editor.UsePresetCommand}"
                            CommandParameter="urgent" />
                    <Button Content="Não lembrar"
                            FontSize="11"
                            Command="{Binding Editor.UsePresetCommand}"
                            CommandParameter="none" />
                  </StackPanel>

                  <views:ReminderEditorView DataContext="{Binding Editor}" />

                  <Button HorizontalAlignment="Right"
                          Classes="accent"
                          Content="Salvar"
                          Command="{Binding #Root.((vm:TodayViewModel)DataContext).SaveRowReminderCommand}"
                          CommandParameter="{Binding}" />

                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <Button Grid.Column="8"
                  Classes="rowMenu"
                  Content="⋯"
                  ToolTip.Tip="Arquivar ou excluir este checklist"
                  Click="OnRowMenuClick" />

          <TextBlock Grid.Column="9"
                     Margin="8,0,2,0"
                     Text="{Binding TimeLabel}"
                     Classes="time"
                     Classes.late="{Binding IsLate}" />

        </Grid>
      </Border>
    </DataTemplate>

  </UserControl.Resources>

  <UserControl.Styles>

    <!-- Cabeçalho de seção: menor que o texto da tarefa, de propósito. A lista
         é o assunto; a seção é só onde ela começa. -->
    <Style Selector="TextBlock.sectionHeader">
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.8" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextLowBrush}" />
      <Setter Property="Margin" Value="9,12,0,5" />
    </Style>

    <Style Selector="TextBlock.taskTitle">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />

      <!--
        A outra metade do corte acima: o "…" poupa largura, o balão devolve o
        texto. Só literais aqui — um {Binding} em Setter resolveria contra o
        x:DataType do arquivo (TodayViewModel, que também tem Title) e mostraria
        a data no lugar da tarefa. A amarração fica no elemento.

        BetweenShowDelay negativo faz cada linha esperar o ShowDelay inteiro:
        com o padrão, correr o mouse pela lista abriria um balão por linha.
      -->
      <Setter Property="ToolTip.Placement" Value="Bottom" />
      <Setter Property="ToolTip.ShowDelay" Value="500" />
      <Setter Property="ToolTip.BetweenShowDelay" Value="-1" />

      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>

    <!-- Concluída: some do primeiro plano sem sumir da lista. -->
    <Style Selector="TextBlock.taskTitle.done">
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextLowBrush}" />
      <Setter Property="TextDecorations" Value="Strikethrough" />
    </Style>

    <Style Selector="TextBlock.time">
      <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextLowBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.time.late">
      <Setter Property="Foreground" Value="{DynamicResource WidgetDangerBrush}" />
    </Style>

    <Style Selector="TextBlock.waiting">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetCautionBrush}" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>

    <Style Selector="TextBlock.agentBadge">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetAccentHoverBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.agentBadge:pointerover">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>

    <Style Selector="TextBlock.waiting.urgent">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- A linha inteira acende no hover: é o alvo do clique, não o checkbox. -->
    <Style Selector="Border.row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{StaticResource WidgetPillRadius}" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.row:pointerover">
      <Setter Property="Background" Value="{DynamicResource WidgetSurfaceBrush}" />
    </Style>

    <!--
      A alça do arrasto. Discreta como o "⋯" e o sino: a lista não pode virar
      uma barra de botões (§12), mas reordenar também não pode ser um gesto que
      ninguém descobre.
    -->
    <Style Selector="Border.dragHandle">
      <Setter Property="Width" Value="14" />
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="SizeNorthSouth" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Ellipse.grip">
      <Setter Property="Width" Value="2.5" />
      <Setter Property="Height" Value="2.5" />
      <Setter Property="Margin" Value="0.75" />
      <Setter Property="Fill" Value="{DynamicResource WidgetTextLowBrush}" />
    </Style>

    <Style Selector="Border.row:pointerover Border.dragHandle">
      <Setter Property="Opacity" Value="0.85" />
    </Style>

    <!--
      CONCLUÍDAS não reordena: lá a ordem é a da conclusão (ADR-022). A alça
      some nessas linhas — alça que não faz nada é pior do que alça nenhuma.
    -->
    <Style Selector="Border.row.fixedOrder Border.dragHandle">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Prioridade: 3px na lateral. Quem precisa ver, vê; quem não precisa,
         não perde a lista para um cartão colorido. -->
    <Style Selector="Border.priority">
      <Setter Property="Width" Value="3" />
      <Setter Property="Height" Value="14" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Margin" Value="0,0,7,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Border.priority.high">
      <Setter Property="Background" Value="{DynamicResource WidgetCautionBrush}" />
    </Style>

    <Style Selector="Border.priority.urgent">
      <Setter Property="Background" Value="{DynamicResource WidgetDangerBrush}" />
    </Style>

    <!-- Checkbox pequeno: sem rótulo, sem padding de conteúdo. -->
    <Style Selector="CheckBox.task">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Discreto até o mouse passar: a linha não pode virar barra de botões. -->
    <Style Selector="Button.reminder">
      <Setter Property="FontFamily" Value="{StaticResource WidgetIconFont}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextMidBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.row:pointerover Button.reminder">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!--
      Anotações da linha (§12). Mesma discrição do sino, com uma diferença que
      paga sozinha: com texto escrito o botão fica aceso mesmo sem hover, e vira
      o único jeito de saber, sem abrir item por item, onde há mais informação.

      Clique simples, e não duplo: o Tapped do título já copia o texto, e no
      Avalonia o primeiro clique de um duplo clique dispara o Tapped antes do
      DoubleTapped — o gesto duplo copiaria e abriria de uma vez só.
    -->
    <Style Selector="Button.notes">
      <Setter Property="FontFamily" Value="{StaticResource WidgetIconFont}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextMidBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.row:pointerover Button.notes">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!--
      Etiquetas (ADR-025). O botão segue a discrição dos vizinhos e fica meio
      aceso quando há etiqueta, como o de anotações.
    -->
    <Style Selector="Button.tags">
      <Setter Property="FontFamily" Value="{StaticResource WidgetIconFont}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextMidBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.row:pointerover Button.tags">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.tags.on">
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetAccentBrush}" />
    </Style>

    <!--
      A bolinha. O balão abre rápido — o nome é a única informação que ela
      tem —, mas o BetweenShowDelay negativo impede que passar o mouse pela
      lista vá abrindo um balão atrás do outro.
    -->
    <Style Selector="Ellipse.tagDot">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ToolTip.ShowDelay" Value="200" />
      <Setter Property="ToolTip.BetweenShowDelay" Value="-1" />

      <!--
        Acima da bolinha, colado nela. O deslocamento padrão do ToolTip é de
        20px para baixo — feito para o balão que nasce no ponteiro —, e com
        Placement="Top" ele empurrava o balão de volta por cima da própria
        bolinha. Sem espaço acima (a primeira linha rente à borda da tela), o
        popup vira para baixo sozinho.
      -->
      <Setter Property="ToolTip.Placement" Value="Top" />
      <Setter Property="ToolTip.VerticalOffset" Value="-4" />
      <Setter Property="ToolTip.HorizontalOffset" Value="0" />
    </Style>

    <Style Selector="TextBlock.tagOverflow">
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextLowBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="ToolTip.ShowDelay" Value="200" />
    </Style>

    <Style Selector="Border.tagChip">
      <Setter Property="CornerRadius" Value="{StaticResource WidgetPillRadius}" />
      <Setter Property="Padding" Value="7,1,3,1" />
      <Setter Property="Margin" Value="0,0,4,4" />
    </Style>

    <Style Selector="Border.tagChip TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.tagRemove">
      <Setter Property="FontFamily" Value="{StaticResource WidgetIconFont}" />
      <Setter Property="FontSize" Value="8" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="CheckBox.tagOption">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="TextBlock.tagHint">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextLowBrush}" />
    </Style>

    <Style Selector="Button.tagManage">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="0,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetAccentBrush}" />
    </Style>

    <!--
      O botão de etiqueta da captura. Sempre visível, ao contrário do da linha:
      a caixa não tem hover que o revele, e é aqui que se escolhe antes de
      escrever.
    -->
    <Style Selector="Button.captureTags">
      <Setter Property="FontFamily" Value="{StaticResource WidgetIconFont}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="5,4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextLowBrush}" />
    </Style>

    <Style Selector="Button.captureTags.on">
      <Setter Property="Foreground" Value="{DynamicResource WidgetAccentBrush}" />
    </Style>

    <Style Selector="Button.notes.on">
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetAccentBrush}" />
    </Style>

    <!--
      Menu da linha. Mesma discrição do botão de lembrete: a lista não pode
      virar uma barra de botões (§12), mas arquivar e excluir também não podem
      existir só no clique direito, que ninguém descobre sozinho.
    -->
    <Style Selector="Button.rowMenu">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="5,0,5,4" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetTextMidBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.row:pointerover Button.rowMenu">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Com lembrete ligado o botão fica levemente visível mesmo sem hover. -->
    <Style Selector="Button.reminder.on">
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="Foreground" Value="{DynamicResource WidgetAccentBrush}" />
    </Style>

    <!--
      O item levantado. Ele é a mesma linha, desenhada de novo numa camada
      acima da lista: ganha corpo (fundo opaco e sombra) porque precisa parecer
      ter descolado do painel, e não ser um reflexo dele.

      Transitions nulo na linha de dentro: o BrushTransition de Border.row
      faria o fundo do item levantado escorregar por 120ms toda vez que ele
      aparecesse.
    -->
    <Style Selector="ContentControl#DragGhost Border.row">
      <Setter Property="Background" Value="{DynamicResource WidgetSurfaceHoverBrush}" />
      <Setter Property="BoxShadow" Value="{StaticResource WidgetLiftShadow}" />
      <Setter Property="Transitions" Value="{x:Null}" />
    </Style>

    <!-- A alça fica visível no item levantado: é por ela que ele está preso. -->
    <Style Selector="ContentControl#DragGhost Border.dragHandle">
      <Setter Property="Opacity" Value="0.8" />
    </Style>

    <Style Selector="ContentControl#DragGhost">
      <Setter Property="Opacity" Value="0.92" />
    </Style>

    <!--
      Só no pouso. Durante o acompanhamento do cursor a transição fica
      desligada, senão o item andaria 180ms atrás da mão.
    -->
    <Style Selector="ContentControl#DragGhost.landing">
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform"
                                         Duration="0:0:0.18"
                                         Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>

    <!--
      A linha que cede o lugar desliza em vez de saltar. Um passo por quadro
      significa que exatamente um vizinho se move de cada vez.
    -->
    <Style Selector="ContentPresenter.sliding">
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform"
                                         Duration="0:0:0.15"
                                         Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.captureCard">
      <Setter Property="Background" Value="{DynamicResource WidgetSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WidgetStrokeSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource WidgetCardRadius}" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.captureCard:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource WidgetAccentLineBrush}" />
    </Style>

    <!--
      Modo compacto: a captura sai de cena. Continua no ar (e no foco dos
      testes), só não ocupa mais a altura que a lista quer.

      O tipo no seletor é o concreto, e não UserControl: seletor de tipo no
      Avalonia casa exato, então "UserControl" não alcança quem dele deriva.
    -->
    <Style Selector="views|TodayView.compact Border#CaptureCard">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="views|TodayView.compact TextBlock#CaptureHint">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!--
      Modo discreto. Vem depois dos estilos base de propósito: no Avalonia não
      há especificidade de CSS, quem casa por último ganha — e estas regras
      precisam sobrescrever Border.row e Border.row:pointerover.

      Cada linha ganha a própria pílula em vez de um fundo para o painel todo:
      entre as linhas fica a área de trabalho limpa, e sobre uma janela clara o
      texto branco sumiria sem nada atrás dele.
    -->
    <Style Selector="views|TodayView.ghost Border.row">
      <Setter Property="Background" Value="#59000000" />
      <Setter Property="Margin" Value="3,2" />
    </Style>

    <Style Selector="views|TodayView.ghost Border.row:pointerover">
      <Setter Property="Background" Value="#8C000000" />
    </Style>

    <!-- "Somente os itens": cabeçalho de seção e dica de teclado saem de cena. -->
    <Style Selector="views|TodayView.ghost TextBlock.sectionHeader">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="views|TodayView.ghost TextBlock#CaptureHint">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- A captura só ocupa espaço depois que o "+" a pede. -->
    <Style Selector="views|TodayView.ghost Border#CaptureCard">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="views|TodayView.ghost.captureOpen Border#CaptureCard">
      <Setter Property="IsVisible" Value="True" />
    </Style>

  </UserControl.Styles>

  <Panel>

    <DockPanel Margin="0,0,0,8">

      <!--
        ElementRole="User" aqui e nas linhas: no modo discreto o painel inteiro é
        área de arrasto, e sem isto digitar ou marcar uma tarefa viraria um
        empurrão na janela.
      -->
      <Border x:Name="CaptureCard"
              DockPanel.Dock="Top"
              Classes="captureCard"
              chrome:WindowDecorationProperties.ElementRole="User"
              Margin="12,2,12,0">
        <Grid ColumnDefinitions="*,Auto,Auto">

          <TextBox x:Name="CaptureBox"
                   spell:SpellCheck.IsEnabled="True"
                   Grid.Column="0"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   FontSize="12.5"
                   MinHeight="24"
                   MaxHeight="120"
                   Padding="0"
                   BorderThickness="0"
                   VerticalAlignment="Center"
                   Background="Transparent"
                   PlaceholderText="Uma tarefa por linha…"
                   Text="{Binding CaptureText}" />

          <!--
            Etiquetas para o que está sendo escrito (ADR-025): valem para todas
            as linhas da captura e são gravadas junto com elas. As escolhidas
            aparecem como bolinhas ao lado do botão, as mesmas da lista, para
            ninguém capturar achando que não marcou nada.
          -->
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="3"
                      Margin="6,0,0,0"
                      VerticalAlignment="Bottom">
            <ItemsControl ItemsSource="{Binding CaptureTags.Dots}"
                          VerticalAlignment="Center"
                          IsVisible="{Binding CaptureTags.HasTags}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="3" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TagChipViewModel">
                  <Ellipse x:Name="Dot" Classes="tagDot" Fill="{Binding Fill}">
                    <ToolTip.Tip>
                      <ToolTip Classes="tagTip"
                               Background="{Binding #Dot.((vm:TagChipViewModel)DataContext).Fill}"
                               BorderBrush="{Binding #Dot.((vm:TagChipViewModel)DataContext).Fill}"
                               Foreground="{Binding #Dot.((vm:TagChipViewModel)DataContext).Foreground}"
                               Content="{Binding #Dot.((vm:TagChipViewModel)DataContext).Name}" />
                    </ToolTip.Tip>
                  </Ellipse>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="tagOverflow"
                       Text="{Binding CaptureTags.OverflowLabel}"
                       IsVisible="{Binding CaptureTags.HasOverflow}"
                       ToolTip.Tip="{Binding CaptureTags.OverflowTip}" />

            <Button x:Name="CaptureTagsButton"
                    Classes="captureTags"
                    Classes.on="{Binding CaptureTags.HasTags}"
                    Content="&#xE8EC;"
                    ToolTip.Tip="Etiquetas para as tarefas que você está escrevendo">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight"
                        Opened="OnTagsFlyoutOpened"
                        Closed="OnTagsFlyoutClosed">
                  <ContentControl DataContext="{Binding CaptureTags}"
                                  Content="{Binding}"
                                  ContentTemplate="{StaticResource TagPicker}" />
                </Flyout>
              </Button.Flyout>
            </Button>
          </StackPanel>

          <Button Grid.Column="2"
                  Margin="8,0,0,0"
                  Padding="9,3"
                  FontSize="11"
                  Classes="accent"
                  VerticalAlignment="Bottom"
                  Content="Adicionar"
                  Command="{Binding CaptureCommand}" />

        </Grid>
      </Border>

      <TextBlock x:Name="CaptureHint"
                 DockPanel.Dock="Top"
                 Margin="14,5,0,0"
                 FontSize="10"
                 Foreground="{DynamicResource WidgetTextLowBrush}"
                 Text="Enter adiciona · Shift+Enter quebra linha" />

      <Border DockPanel.Dock="Top"
              Margin="12,8,12,0"
              Padding="10,7"
              CornerRadius="{StaticResource WidgetPillRadius}"
              Background="{DynamicResource WidgetDangerSoftBrush}"
              IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="{Binding ErrorMessage}"
                   FontSize="11"
                   Foreground="{DynamicResource WidgetDangerBrush}"
                   TextWrapping="Wrap" />
      </Border>

      <Border DockPanel.Dock="Top"
              Margin="12,8,12,0"
              Padding="10,7"
              CornerRadius="{StaticResource WidgetPillRadius}"
              Background="{DynamicResource WidgetAccentSoftBrush}"
              IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="{Binding StatusMessage}"
                   FontSize="11"
                   Foreground="{DynamicResource WidgetTextHighBrush}"
                   TextWrapping="Wrap" />
      </Border>

      <TextBlock DockPanel.Dock="Top"
                 Margin="0,28,0,0"
                 FontSize="11.5"
                 HorizontalAlignment="Center"
                 Foreground="{DynamicResource WidgetTextLowBrush}"
                 Text="{Binding EmptyMessage}"
                 IsVisible="{Binding IsEmpty}" />

      <ScrollViewer x:Name="Scroller" Margin="6,4,6,0" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Sections}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TodaySectionViewModel">
              <StackPanel>

                <TextBlock Classes="sectionHeader" Text="{Binding Header}" />

                <ItemsControl ItemsSource="{Binding Items}"
                              ItemTemplate="{StaticResource TaskRow}" />

              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    </DockPanel>

    <!--
      A camada do item levantado. Dentro do TodayView, e não no OverlayLayer da
      janela, por três razões: as coordenadas do item, as das linhas medidas e
      as de e.GetPosition(this) viram um espaço só; o item continua dentro do
      canto arredondado do painel em vez de pairar sobre a moldura; e no modo
      discreto o OverlayLayer ficaria por cima das alças de redimensionamento.
    -->
    <Canvas x:Name="DragLayer" IsHitTestVisible="False">
      <!--
        IsHitTestVisible também aqui, e não só na camada: o item levantado está
        sob o cursor o tempo todo: se ele recebesse ponteiro, engoliria o
        movimento que o está arrastando.
      -->
      <ContentControl x:Name="DragGhost"
                      IsVisible="False"
                      IsHitTestVisible="False"
                      ContentTemplate="{StaticResource TaskRow}" />
    </Canvas>

  </Panel>

</UserControl>
