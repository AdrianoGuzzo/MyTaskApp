<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Tema Nórdico: Tons frios e minimalistas do norte europeu -->

  <!-- Superfícies -->
  <Color x:Key="WidgetCanvasColor">#2E3440</Color>
  <Color x:Key="WidgetSurfaceColor">#3B4252</Color>
  <Color x:Key="WidgetSurfaceHoverColor">#434C5C</Color>
  <Color x:Key="WidgetStrokeColor">#4C566A</Color>
  <Color x:Key="WidgetStrokeSoftColor">#3B4252</Color>

  <!-- Texto -->
  <Color x:Key="WidgetTextHighColor">#ECEFF4</Color>
  <Color x:Key="WidgetTextMidColor">#D8DEE9</Color>
  <Color x:Key="WidgetTextLowColor">#A3BE8C</Color>

  <!-- Destaque: Azul nórdico -->
  <Color x:Key="WidgetAccentColor">#81A1C1</Color>
  <Color x:Key="WidgetAccentHoverColor">#88C0D0</Color>
  <Color x:Key="WidgetAccentPressedColor">#5E81AC</Color>
  <Color x:Key="WidgetAccentSoftColor">#2E3440</Color>
  <Color x:Key="WidgetAccentLineColor">#5E81AC</Color>

  <!-- Sinalização -->
  <Color x:Key="WidgetDangerColor">#BF616A</Color>
  <Color x:Key="WidgetDangerSoftColor">#3B2A2A</Color>
  <Color x:Key="WidgetCautionColor">#EBCB8B</Color>
  <Color x:Key="WidgetCautionSoftColor">#3B342A</Color>
  <Color x:Key="WidgetInfoColor">#81A1C1</Color>
  <Color x:Key="WidgetSuccessColor">#A3BE8C</Color>

</ResourceDictionary>
