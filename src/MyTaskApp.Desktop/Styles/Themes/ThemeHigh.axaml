<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Tema Alto Contraste: Para acessibilidade e visibilidade máxima -->

  <!-- Superfícies -->
  <Color x:Key="WidgetCanvasColor">#000000</Color>
  <Color x:Key="WidgetSurfaceColor">#1A1A1A</Color>
  <Color x:Key="WidgetSurfaceHoverColor">#333333</Color>
  <Color x:Key="WidgetStrokeColor">#FFFFFF</Color>
  <Color x:Key="WidgetStrokeSoftColor">#555555</Color>

  <!-- Texto -->
  <Color x:Key="WidgetTextHighColor">#FFFFFF</Color>
  <Color x:Key="WidgetTextMidColor">#FFFF00</Color>
  <Color x:Key="WidgetTextLowColor">#CCCCCC</Color>

  <!-- Destaque -->
  <Color x:Key="WidgetAccentColor">#FFFF00</Color>
  <Color x:Key="WidgetAccentHoverColor">#FFFFFF</Color>
  <Color x:Key="WidgetAccentPressedColor">#DDDD00</Color>
  <Color x:Key="WidgetAccentSoftColor">#333300</Color>
  <Color x:Key="WidgetAccentLineColor">#FFFF00</Color>

  <!-- Sinalização -->
  <Color x:Key="WidgetDangerColor">#FF0000</Color>
  <Color x:Key="WidgetDangerSoftColor">#330000</Color>
  <Color x:Key="WidgetCautionColor">#FFFF00</Color>
  <Color x:Key="WidgetCautionSoftColor">#333300</Color>
  <Color x:Key="WidgetInfoColor">#00FFFF</Color>
  <Color x:Key="WidgetSuccessColor">#00FF00</Color>

</ResourceDictionary>
