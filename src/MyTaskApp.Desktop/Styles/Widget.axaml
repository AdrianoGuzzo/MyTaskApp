<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome">

  <!--
    Estilos da moldura do widget. O que é específico da lista de tarefas fica
    em TodayView; aqui mora só o que a janela e as telas auxiliares dividem.
  -->

  <Style Selector="ScrollViewer">
    <!-- Barra de rolagem some quando ninguém está usando: menos ruído no painel. -->
    <Setter Property="AllowAutoHide" Value="True" />
  </Style>

  <!--
    Um título vai até 200 caracteres (TaskItem.MaxTitleLength). Numa linha só,
    o balão estouraria a largura máxima do tema e o texto voltaria a ser
    cortado — trocaria um corte por outro. TextWrapping é anexada e herdada,
    então desce até o TextBlock que o ContentPresenter cria para a string.

    Aqui, e não em TodayView: o balão vive num PopupRoot, fora da árvore visual
    do UserControl, onde um seletor local não o alcança.
  -->
  <Style Selector="ToolTip">
    <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
  </Style>

  <!--
    O balão da bolinha de etiqueta (ADR-025): pílula na cor da etiqueta, com o
    texto preto ou branco que vem do ViewModel. Fundo, borda e texto chegam por
    binding no próprio ToolTip (TodayView); aqui só a forma, e pela mesma razão
    do estilo acima — o balão vive fora da árvore do UserControl.
  -->
  <Style Selector="ToolTip.tagTip">
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource WidgetPillRadius}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!--
    As etiquetas embaixo do título completo, no balão da linha (TodayView):
    pílulas na cor de cada uma, com o nome. A cor e o texto vêm por binding.
  -->
  <Style Selector="Border.tipTag">
    <Setter Property="CornerRadius" Value="{StaticResource WidgetPillRadius}" />
    <Setter Property="Padding" Value="7,1" />
    <Setter Property="Margin" Value="0,0,4,4" />
  </Style>

  <Style Selector="Border.tipTag > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <!--
    Texto selecionado. O Fluent pinta a seleção com o destaque e deixa a letra
    na cor do texto: branca sobre o limão do Ponta, o gelo do Nórdico ou o
    amarelo do Alto contraste — 2:1. A letra sobre o destaque já tem token, e
    nos temas de letra branca nada muda.
  -->
  <Style Selector="TextBox">
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource WidgetOnAccentBrush}" />
  </Style>

  <Style Selector="SelectableTextBlock">
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource WidgetOnAccentBrush}" />
  </Style>

  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="{StaticResource WidgetPillRadius}" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <!--
    Ação destrutiva. Só a confirmação forte do §7 a usa, e é de propósito que
    ela não se pareça com a ação primária: o botão que apaga para sempre não
    pode ter a mesma cara do botão que só arquiva.
  -->
  <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WidgetDangerSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WidgetDangerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource WidgetDangerBrush}" />
  </Style>

  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WidgetDangerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource WidgetCanvasBrush}" />
  </Style>

  <!-- Casca: o painel inteiro. A borda é o que separa do fundo da área de trabalho. -->
  <Style Selector="Border.widgetShell">
    <!-- O anel de 10px é onde a sombra e as alças de redimensionar moram. -->
    <Setter Property="Margin" Value="10" />
    <Setter Property="Background" Value="{DynamicResource WidgetCanvasBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WidgetStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource WidgetShellRadius}" />

    <!-- No estilo, e não no elemento: valor inline ganha de setter, e o modo
         HUD precisa poder apagar a sombra. -->
    <Setter Property="BoxShadow" Value="{DynamicResource WidgetShellShadow}" />
  </Style>

  <!--
    HUD (ADR-048): o cartão encosta na borda da janela — sem o anel de 10px,
    sem sombra. Cada pixel transparente em volta seria clique roubado do app
    de trás, porque no Windows quem recebe o mouse é o retângulo da janela, e
    não o pixel desenhado. O fundo vem da camada hudBackdrop, com a opacidade
    escolhida; a borda fica, para o cartão se separar de qualquer fundo.
  -->
  <Style Selector="Border.widgetShell.hud">
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BoxShadow" Value="none" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <Style Selector="Border.hudBackdrop">
    <Setter Property="Background" Value="{DynamicResource WidgetCanvasBrush}" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <Style Selector="Border.hudBackdrop.collapsed">
    <Setter Property="CornerRadius" Value="20" />
  </Style>

  <!-- Barra de arrasto. Transparente de propósito: ela é área, não elemento. -->
  <Style Selector="Border.titleBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="12,10,8,8" />
  </Style>

  <Style Selector="TextBlock.brand">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.dateLine">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="LetterSpacing" Value="0.7" />
    <Setter Property="Foreground" Value="{DynamicResource WidgetTextLowBrush}" />
  </Style>

  <Style Selector="TextBlock.metric">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource WidgetTextMidBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Botões de canto (fixar, recolher, menu): 24px, discretos até o hover. -->
  <Style Selector="Button.chrome">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource WidgetIconFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource WidgetPillRadius}" />
    <Setter Property="Foreground" Value="{DynamicResource WidgetTextLowBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="Foreground" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.chrome /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource WidgetPillRadius}" />
  </Style>

  <Style Selector="Button.chrome:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WidgetSurfaceHoverBrush}" />
  </Style>

  <Style Selector="Button.chrome:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
  </Style>

  <Style Selector="Button.chrome:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WidgetSurfaceBrush}" />
  </Style>

  <!-- Estado ligado (por exemplo "sempre no topo"): só a cor muda, sem moldura. -->
  <Style Selector="Button.chrome.on">
    <Setter Property="Foreground" Value="{DynamicResource WidgetAccentBrush}" />
  </Style>

  <!-- A marca: o único bloco de cor de destaque sempre visível. -->
  <Style Selector="Border.brandMark">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource WidgetAccentBrush}" />
  </Style>

  <Style Selector="Border.brandMark > TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource WidgetOnAccentBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- O cabeçalho do HUD: uma linha só. É área de arrasto, então fundo Transparent, e não nulo. -->
  <Style Selector="Border.hudBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="10,7,6,5" />
  </Style>

  <!--
    No HUD os botões de canto ganham 2px: 24px é pouco para um alvo que fica
    o dia inteiro num canto de tela e é clicado sem olhar direito.
  -->
  <Style Selector="Border.hudBar Button.chrome">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
  </Style>

  <Style Selector="Border.hudIntro">
    <Setter Property="Margin" Value="8,0,8,6" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="CornerRadius" Value="{StaticResource WidgetCardRadius}" />
    <Setter Property="Background" Value="{DynamicResource WidgetAccentSoftBrush}" />
  </Style>

  <Style Selector="TextBlock.hudIntroTitle">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
  </Style>

  <Style Selector="TextBlock.hudIntroText">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource WidgetTextMidBrush}" />
  </Style>

  <!-- "+ Nova tarefa": texto, e não botão cheio — o HUD não pode virar uma barra de botões. -->
  <Style Selector="Button.hudFooter">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Margin" Value="8,0,8,8" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource WidgetTextMidBrush}" />
  </Style>

  <Style Selector="Button.hudFooter /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.hudFooter:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WidgetSurfaceHoverBrush}" />
  </Style>

  <Style Selector="Button.hudFooter:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
  </Style>

  <!--
    A pílula do HUD recolhido. Ocupa a janela inteira: a janela tem o tamanho
    dela, e nada em volta. A borda é a mesma do cartão aberto.
  -->
  <Style Selector="Button.hudPill">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
  </Style>

  <Style Selector="Button.hudPill /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource WidgetStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="20" />
  </Style>

  <Style Selector="Button.hudPill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WidgetSurfaceHoverBrush}" />
  </Style>

  <Style Selector="Button.hudPill Border.brandMark">
    <Setter Property="Margin" Value="0" />
  </Style>

  <Style Selector="Border.countBadge">
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource WidgetAccentSoftBrush}" />
  </Style>

  <Style Selector="Border.countBadge > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource WidgetTextHighBrush}" />
  </Style>

  <!--
    A amostra do menu "Tema": fundo à esquerda, cartão à direita, destaque no
    meio. A borda é a do tema atual, e não a da amostra — senão um tema claro
    listado dentro de um menu claro sumiria no fundo.
  -->
  <Style Selector="Border.themeSwatch">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource WidgetStrokeBrush}" />
  </Style>

  <!-- Barra de progresso fina: informação periférica, não um elemento de tela. -->
  <Style Selector="ProgressBar.slim">
    <Setter Property="Height" Value="3" />
    <Setter Property="MinHeight" Value="3" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Foreground" Value="{DynamicResource WidgetAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource WidgetStrokeSoftBrush}" />
  </Style>

  <Style Selector="ProgressBar.slim /template/ Border#PART_Indicator">
    <Setter Property="CornerRadius" Value="2" />
  </Style>

  <Style Selector="ProgressBar.slim /template/ Border#ProgressBarRoot">
    <Setter Property="CornerRadius" Value="2" />
  </Style>

</Styles>
