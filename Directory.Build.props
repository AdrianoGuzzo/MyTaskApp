<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- IANA time zone ids must resolve on Windows too (ICU). -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Fonte unica da versao e da identidade do produto (ADR-018, ADR-044).
    O instalador NAO repete estes valores: installer/windows/build.ps1 os le com
    `dotnet msbuild -getProperty:Version` e passa para o ISCC via /DAppVersion.

    NINGUEM edita VersionPrefix a mao. Quem sobe e o Release Please, no PR de
    release, a partir dos Conventional Commits; a anotacao no fim da linha e o
    que ele procura. O manifest (.release-please-manifest.json) guarda o mesmo
    numero, e ReleaseProcessTests quebra a build se os dois divergirem.
    Processo completo: docs/release-process.md.

    AssemblyVersion e FileVersion ficam como o SDK deriva (M.m.p.0): o exe nao
    tem consumidor externo nem strong name. InformationalVersion ganha o SHA do
    commit sozinho (M.m.p+sha), e e ele que o app mostra e loga.
  -->
  <PropertyGroup Label="Product">
    <VersionPrefix>1.1.0</VersionPrefix><!-- x-release-please-version -->
    <Product>MyTaskApp</Product>
    <Company>MyTaskApp</Company>
    <Authors>MyTaskApp</Authors>
    <Copyright>Â© 2026 MyTaskApp</Copyright>
    <Description>Widget de tarefas que nao deixa voce esquecer.</Description>
  </PropertyGroup>

</Project>
