<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- IANA time zone ids must resolve on Windows too (ICU). -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Fonte unica da versao e da identidade do produto (ADR-018).
    O instalador NAO repete estes valores: installer/windows/build.ps1 os le com
    `dotnet msbuild -getProperty:Version` e passa para o ISCC via /DAppVersion.
    Subir de versao e editar VersionPrefix aqui, e mais nada.
  -->
  <PropertyGroup Label="Product">
    <VersionPrefix>1.0.0</VersionPrefix>
    <Product>MyTaskApp</Product>
    <Company>MyTaskApp</Company>
    <Authors>MyTaskApp</Authors>
    <Copyright>Â© 2026 MyTaskApp</Copyright>
    <Description>Widget de tarefas que nao deixa voce esquecer.</Description>
  </PropertyGroup>

</Project>
