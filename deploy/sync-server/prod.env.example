# Copie para prod.env (fora do Git) e ajuste. Segredo nenhum aqui: eles ficam
# em secrets/ (docs/sync-server.md secao 5).

# O nome (ou IP) que o desktop e o celular usam: https://<SYNC_HOST>/
SYNC_HOST=sync.exemplo.com

# internal = CA propria do Caddy (LAN); um e-mail = Let's Encrypt (dominio
# publico, portas 80 e 443 alcancaveis da internet); ou
# "/etc/caddy/tls/cert.pem /etc/caddy/tls/key.pem" com um certificado seu em tls/.
SYNC_TLS=internal

# O ID do cliente OAuth do Google (docs/sync-server.md secao 1). A chave
# secreta vai em secrets/google_client_secret.
GOOGLE_CLIENT_ID=

# Opcionais.
# SYNC_HTTP_PORT=80
# SYNC_HTTPS_PORT=443
# A sub-rede do proxy e o IP fixo dele, se 172.30.80.0/24 colidir com outra rede do host.
# SYNC_EDGE_SUBNET=172.30.80.0/24
# SYNC_PROXY_IP=172.30.80.10
