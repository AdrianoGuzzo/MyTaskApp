<Project Sdk="Microsoft.NET.Sdk">
  <!--
    O servidor de sincronizacao contra PostgreSQL de verdade (ADR-061):
    Testcontainers, ou MYTASKAPP_TEST_SERVER_POSTGRES. Sem nenhum dos dois (o CI
    do Windows), os testes pulam sozinhos.
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MyTaskApp.Server.Infrastructure\MyTaskApp.Server.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\MyTaskApp.Server.Api\MyTaskApp.Server.Api.csproj" />
    <ProjectReference Include="..\..\src\MyTaskApp.Infrastructure\MyTaskApp.Infrastructure.csproj" />
    <!-- O celular de ponta a ponta (ADR-067): a composição e as telas do app, sem MAUI. -->
    <ProjectReference Include="..\..\src\MyTaskApp.Mobile.Core\MyTaskApp.Mobile.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- O hub da orquestração (T-13), com o cliente de verdade contra o TestServer. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

</Project>
